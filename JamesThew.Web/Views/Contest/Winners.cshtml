<p class="font-body-sm text-body-sm text-on-surface-variant truncate">
                    Amateur Gourmet Division • Karachi, PK
                  </p>
</div>
</div>
<!-- Chef James's Critique -->
<div class="relative pl-space-md">
<span class="absolute left-0 top-0 bottom-0 w-1 rounded-full bg-primary-container"></span>
