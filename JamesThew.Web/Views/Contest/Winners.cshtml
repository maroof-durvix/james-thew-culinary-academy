@{
    ViewData["Title"] = "Past Winners";
}

<div class="flex flex-col w-full">
<!-- Subtle Ambient Glow Orbs -->
<div class="relative w-full overflow-hidden">
<div class="absolute -top-32 left-1/4 w-[500px] h-[500px] bg-primary/10 rounded-full blur-[140px] pointer-events-none"></div>
<div class="absolute top-96 right-10 w-[420px] h-[420px] bg-secondary/5 rounded-full blur-[160px] pointer-events-none"></div>
<div class="w-full px-margin-mobile lg:px-margin py-space-xl">
<!-- Breadcrumbs -->
<nav aria-label="Breadcrumb" class="mb-space-lg">
<ol class="flex items-center gap-space-xs text-label-sm font-label-sm text-outline uppercase tracking-widest">
<li>
<a class="text-on-surface-variant hover:text-primary transition-colors" data-path="home" href="#">Home</a>
</li>
<li><span class="text-outline/50">/</span></li>
<li>
<a class="text-on-surface-variant hover:text-primary transition-colors" data-path="active-contests" href="#">Contests</a>
</li>
<li><span class="text-outline/50">/</span></li>
<li class="text-primary font-semibold">Past Winners</li>
</ol>
</nav>
<!-- Page Header -->
<header class="max-w-4xl mb-space-xl">
<div class="inline-flex items-center gap-space-xs mb-space-sm">
<span class="w-8 h-px bg-primary-container"></span>
<span class="font-label-md text-label-md tracking-widest uppercase text-primary font-semibold">HALL OF CULINARY HONORS</span>
</div>
<h1 class="font-display-lg text-display-lg text-inverse-surface tracking-tight mb-space-sm">
          Contest Winners Archive
        </h1>
<p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed max-w-3xl">
          Celebrating domestic chefs and passionate gourmands who have mastered seasonal challenges and earned Chef James's acclaim.
        </p>
</header>
<!-- 1. Featured Latest Winner Card (Reigning Champion Hero Card) -->
<section class="mb-space-xl">
<div class="relative rounded-2xl bg-surface-container-high/90 backdrop-blur-2xl shadow-[0_20px_50px_rgba(0,17,15,0.85)] p-space-md lg:p-space-xl overflow-hidden">
