<div class="flex flex-wrap items-center gap-space-sm">
<span class="inline-flex items-center gap-space-xs px-space-md py-1.5 rounded-full bg-primary-container/20 text-primary font-label-md text-label-md tracking-wider uppercase shadow-[0_2px_12px_rgba(217,138,86,0.3)]">
<span class="material-symbols-outlined text-[16px] text-primary" style="font-variation-settings: 'FILL' 1;">emoji_events</span>
                  REIGNING CHAMPION • FEBRUARY 2026
                </span>
<span class="inline-flex items-center px-space-sm py-1 rounded-full bg-surface-container-highest text-secondary font-label-sm text-label-sm uppercase tracking-wider">
                  Non-Vegetarian
                </span>
</div>
<!-- Contest Title -->
