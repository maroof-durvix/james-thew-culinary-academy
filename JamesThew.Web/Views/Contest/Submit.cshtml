@{
    ViewData["Title"] = "Submit Contest Entry";
}

<div class="flex flex-col w-full">
<div class="w-full px-margin-mobile lg:px-margin py-space-xl">
<!-- Breadcrumb Hierarchy -->
<nav aria-label="Breadcrumbs" class="flex items-center gap-space-xs text-label-sm font-label-sm uppercase tracking-wider text-outline mb-space-lg">
<a class="text-on-surface-variant hover:text-primary transition-colors" data-path="home" href="#">Home</a>
<span class="text-outline/60">/</span>
<a class="text-on-surface-variant hover:text-primary transition-colors" data-path="contests" href="#">Contests</a>
<span class="text-outline/60">/</span>
<a class="text-on-surface-variant hover:text-primary transition-colors" data-path="active-contests" href="#">Active Contests</a>
<span class="text-outline/60">/</span>
<span class="text-primary-container font-semibold">Submit Contest Entry</span>
</nav>
<!-- Main Two-Column Layout (65% / 35%) -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
<!-- LEFT COLUMN: Form Container (65% -> 8 of 12 cols desktop) -->
<section class="lg:col-span-8 flex flex-col gap-space-lg">
<div class="bg-surface-container/75 backdrop-blur-md rounded-[18px] p-space-md lg:p-space-xl shadow-xl shadow-surface-container-lowest/50 relative overflow-hidden">
<!-- Subtle Copper Ambient Vignette Overlay -->
<div class="absolute -top-32 -right-32 w-72 h-72 rounded-full bg-primary-container/10 blur-3xl pointer-events-none"></div>
<!-- Header Section -->
<div class="relative z-10 mb-space-xl">
<span class="inline-flex items-center gap-space-xs px-3 py-1 rounded-full bg-secondary-container/30 text-secondary text-label-sm font-label-sm uppercase tracking-widest mb-space-sm">
<span class="material-symbols-outlined text-[14px]">restaurant_menu</span> Culinary Challenge Entry
            </span>
<h1 class="font-headline-xl text-headline-xl text-on-surface mb-space-xs">Contest Entry Submission</h1>
<p class="font-body-md text-body-md text-on-surface-variant">Open to all culinary creators — registered members and guest gourmands alike.</p>
</div>
<!-- Entry Submission Form -->
<form class="relative z-10 flex flex-col gap-space-lg" id="contestEntryForm" onsubmit="event.preventDefault(); document.getElementById('toastNotice').classList.remove('hidden');">
<!-- Field 1: Active Contest Dropdown -->
<div class="flex flex-col gap-space-xs">
<label class="font-label-md text-label-md text-on-surface" for="contest_select">Select Active Contest</label>
<div class="relative">
<select class="w-full bg-surface-container-low text-on-surface rounded-xl px-space-md py-3 appearance-none font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary-container/50 transition-all cursor-pointer" id="contest_select" name="contest_select">
<option selected="" value="italian-summer-2026">Best Italian Recipe or Summer Juice Tip (Ends Mar 31, 2026)</option>
</select>
<span class="material-symbols-outlined absolute right-space-md top-1/2 -translate-y-1/2 text-outline pointer-events-none">expand_more</span>
</div>
</div>
<!-- Field 2: Entry Type Selector (Radio Pill Bar) -->
<div class="flex flex-col gap-space-xs">
<label class="font-label-md text-label-md text-on-surface">Entry Type</label>
<div class="grid grid-cols-2 gap-space-xs p-1 bg-surface-container-low rounded-xl" role="radiogroup">
<button class="flex items-center justify-center gap-space-xs py-2.5 rounded-lg font-title-md text-title-md transition-all bg-primary-container text-surface-container-lowest shadow-sm" id="typeRecipeBtn" onclick="toggleEntryType('recipe')" type="button">
<span class="material-symbols-outlined text-[18px]">skillet</span>
<span>Recipe</span>
</button>
<button class="flex items-center justify-center gap-space-xs py-2.5 rounded-lg font-title-md text-title-md transition-all text-on-surface-variant hover:text-on-surface" id="typeTipBtn" onclick="toggleEntryType('tip')" type="button">
<span class="material-symbols-outlined text-[18px]">lightbulb</span>
<span>Tip</span>
</button>
</div>
</div>
<!-- Submitter Information (Two-Column Inputs) -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
<div class="flex flex-col gap-space-xs">
<label class="font-label-md text-label-md text-on-surface" for="submitter_name">Your Name</label>
<input class="w-full bg-surface-container-low text-on-surface placeholder:text-outline/70 rounded-xl px-space-md py-3 font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary-container/50 transition-all" id="submitter_name" name="submitter_name" placeholder="e.g. Tariq Mansoor" required="" type="text"/>
</div>
<div class="flex flex-col gap-space-xs">
<label class="font-label-md text-label-md text-on-surface" for="submitter_email">Your Email</label>
<input class="w-full bg-surface-container-low text-on-surface placeholder:text-outline/70 rounded-xl px-space-md py-3 font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary-container/50 transition-all" id="submitter_email" name="submitter_email" placeholder="e.g. tariq@domain.com" required="" type="email"/>
<span class="font-label-sm text-label-sm text-outline">Used to notify you if you are selected as a winner</span>
</div>
</div>
<!-- Field 3: Entry Title -->
<div class="flex flex-col gap-space-xs">
<label class="font-label-md text-label-md text-on-surface" for="entry_title">Entry Title</label>
<input class="w-full bg-surface-container-low text-on-surface placeholder:text-outline/70 rounded-xl px-space-md py-3 font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary-container/50 transition-all" id="entry_title" name="entry_title" placeholder="e.g. Wild Morel &amp; Saffron Risotto with Charred Leek Emulsion" required="" type="text"/>
</div>
<!-- Field 4: Category Dropdown -->
<div class="flex flex-col gap-space-xs">
<label class="font-label-md text-label-md text-on-surface" for="entry_category">Category</label>
<div class="relative">
<select class="w-full bg-surface-container-low text-on-surface rounded-xl px-space-md py-3 appearance-none font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary-container/50 transition-all cursor-pointer" id="entry_category" name="entry_category">
<option value="italian">Italian</option>
<option value="juices">Juices</option>
<option value="vegetarian">Vegetarian</option>
<option value="non-vegetarian">Non-Vegetarian</option>
</select>
<span class="material-symbols-outlined absolute right-space-md top-1/2 -translate-y-1/2 text-outline pointer-events-none">expand_more</span>
</div>
</div>
<!-- Dynamic Section: Recipe Specific Fields (Active Default) -->
<div class="flex flex-col gap-space-lg transition-all duration-300" id="recipeFieldsGroup">
<div class="flex flex-col gap-space-xs">
<label class="font-label-md text-label-md text-on-surface" for="recipe_ingredients">Ingredients</label>
<textarea class="w-full bg-surface-container-low text-on-surface placeholder:text-outline/70 rounded-xl p-space-md font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary-container/50 transition-all resize-y" id="recipe_ingredients" name="recipe_ingredients" placeholder="List each ingredient on a new line with exact quantities, e.g.
- 300g Carnaroli rice
- 50g Cultured unsalted butter
- 0.5g Kashmir saffron threads" rows="4"></textarea>
</div>
<div class="flex flex-col gap-space-xs">
<label class="font-label-md text-label-md text-on-surface" for="cooking_procedure">Cooking Procedure</label>
<textarea class="w-full bg-surface-container-low text-on-surface placeholder:text-outline/70 rounded-xl p-space-md font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary-container/50 transition-all resize-y" id="cooking_procedure" name="cooking_procedure" placeholder="Step-by-step cooking instructions with temperature and time indicators..." rows="5"></textarea>
</div>
</div>
<!-- Dynamic Section: Tip Description (Hidden by default, shown when Tip is selected) -->
<div class="hidden flex-col gap-space-xs transition-all duration-300" id="tipFieldsGroup">
<label class="font-label-md text-label-md text-on-surface" for="tip_description">Tip Description &amp; Practical Technique Context</label>
<textarea class="w-full bg-surface-container-low text-on-surface placeholder:text-outline/70 rounded-xl p-space-md font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary-container/50 transition-all resize-y" id="tip_description" name="tip_description" placeholder="Describe your technical nuance, secret prep method, or flavor enhancement technique with clarity and kitchen context..." rows="6"></textarea>
</div>
<!-- Field 5: Image Upload Drag & Drop Zone -->
<div class="flex flex-col gap-space-xs">
<label class="font-label-md text-label-md text-on-surface">Dish Photograph</label>
<div class="group relative rounded-xl bg-surface-container-low/60 hover:bg-surface-container-low transition-all duration-300 p-space-xl flex flex-col items-center justify-center text-center cursor-pointer" id="dropZone">
<input accept="image/png, image/jpeg, image/webp" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-20" id="imageInput" onchange="handleFileSelect(this)" type="file"/>
<div class="w-16 h-16 rounded-full bg-surface-container-high flex items-center justify-center text-primary mb-space-sm group-hover:scale-105 transition-transform duration-300 shadow-md">
<span class="material-symbols-outlined text-[32px]">photo_camera</span>
</div>
<p class="font-title-md text-title-md text-on-surface group-hover:text-primary transition-colors" id="uploadText">Drop your dish photograph here or click to browse</p>
<p class="font-body-sm text-body-sm text-outline mt-1">JPG, PNG, or WEBP up to 10MB. Clear natural kitchen lighting recommended.</p>
<div class="hidden mt-space-sm px-space-md py-1 rounded-full bg-secondary-container/40 text-secondary font-label-sm text-label-sm items-center gap-space-xs" id="filePreviewBadge">
<span class="material-symbols-outlined text-[16px]">check_circle</span>
<span id="fileName">file_selected.jpg</span>
</div>
</div>
</div>
<!-- Custom Emerald/Copper Terms Checkbox -->
<label class="flex items-start gap-space-sm cursor-pointer select-none group mt-space-xs">
<div class="relative flex items-center mt-1">
<input class="peer sr-only" id="termsConsent" required="" type="checkbox"/>
<div class="w-5 h-5 rounded bg-surface-container-low peer-checked:bg-primary-container flex items-center justify-center transition-colors">
<span class="material-symbols-outlined text-[16px] text-surface-container-lowest opacity-0 peer-checked:opacity-100 font-bold transition-opacity">check</span>
</div>
</div>
<span class="font-body-sm text-body-sm text-on-surface-variant group-hover:text-on-surface transition-colors leading-relaxed">
                This is my original work and I consent to its publication under JamesThew.com contest guidelines.
              </span>
</label>
<!-- Full-Width Copper Pill Button -->
<button class="w-full py-space-sm px-space-xl rounded-full bg-primary-container text-surface-container-lowest font-title-lg text-title-lg shadow-[0_4px_16px_rgba(217,138,86,0.25)] hover:bg-primary hover:shadow-[0_6px_24px_rgba(217,138,86,0.40)] transition-all cursor-pointer flex items-center justify-center gap-space-sm mt-space-sm" type="submit">
<span class="material-symbols-outlined text-[20px]">send</span>
<span>Submit Entry</span>
</button>
</form>
<!-- Micro-interaction: Submission Success Toast -->
<div class="hidden mt-space-md p-space-md rounded-xl bg-surface-container-high text-secondary flex items-center justify-between shadow-lg" id="toastNotice">
<div class="flex items-center gap-space-sm">
<span class="material-symbols-outlined text-[20px]">verified</span>
<span class="font-title-md text-title-md">Entry successfully queued for verification!</span>
</div>
<button class="text-on-surface hover:text-primary transition-colors" onclick="this.parentElement.classList.add('hidden')" type="button">
<span class="material-symbols-outlined text-[18px]">close</span>
</button>
</div>
</div>
</section>
<!-- RIGHT COLUMN: Contest Summary & Rule Guidance (35% -> 4 of 12 cols desktop) -->
<aside class="lg:col-span-4 flex flex-col gap-space-lg sticky top-24">
<!-- Active Contest Summary Card -->
<div class="bg-surface-container/75 backdrop-blur-md rounded-[18px] p-space-lg shadow-xl shadow-surface-container-lowest/50 flex flex-col gap-space-md relative overflow-hidden">
<div class="flex items-center justify-between gap-space-sm">
<span class="px-space-sm py-0.5 rounded-full bg-primary-container/20 text-primary-container font-label-sm text-label-sm uppercase tracking-wider flex items-center gap-1">
<span class="material-symbols-outlined text-[14px]">military_tech</span> Active Showcase
            </span>
<!-- Deadline Countdown Pill -->
<div class="flex items-center gap-1 text-primary-container bg-surface-container-low px-space-sm py-1 rounded-full text-label-sm font-label-sm">
<span class="material-symbols-outlined text-[14px]">timer</span>
<span>Ends in 12 days</span>
</div>
</div>
<div>
<h2 class="font-headline-md text-headline-md text-on-surface">Best Italian Recipe or Summer Juice Tip</h2>
<p class="font-body-sm text-body-sm text-outline mt-1">Concludes March 31, 2026</p>
</div>
<!-- Grand Prize Section with Visual Frame -->
<div class="bg-surface-container-low/70 rounded-xl p-space-md flex flex-col gap-space-sm">
<div class="flex items-center justify-between">
<span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-semibold">Grand Prize</span>
<span class="font-label-sm text-label-sm text-primary font-medium">$650 Est. Value</span>
</div>
<!-- Prize Thumbnail Image -->
<div class="relative w-full h-36 rounded-lg overflow-hidden bg-surface-container-lowest">
<img class="w-full h-full object-cover object-center" data-alt="Artisanal 7-piece copper culinary cookware and damascus chef knife set arranged elegantly on dark rustic emerald slate with warm kitchen atmospheric spotlights" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCdnTA2ZF5Yh3zvQ4BgTksa1AkbZj15WAK-b1K4qjW6P8_x9m73lk1OBcS1LU-ATYJLriqGm2jcNO8kdTHMswx_q6LeKWUBWkV5h1VMWvmtB18pGhyoEF8h2wxyBMcUxqVXwTAUrO8gT8v41hBwVf0fPvdsmS95PJ9Rxn2G7TCIOnLdVTHvrijxqfqdiW-rFtga1xFsAzNPQ_XI2WVz9EoIAzQBbE65yGsucNAKUS02XDkYKbcWi3eS"/>
<div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/90 via-transparent to-transparent flex items-end p-space-sm">
<span class="font-title-md text-title-md text-on-surface flex items-center gap-1.5">
<span class="material-symbols-outlined text-primary text-[18px]">verified</span>
                  Artisanal 7-Piece Master Kit
                </span>
</div>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
              Chef James's Artisanal 7-Piece Master Kit ($650 Value) + 1-on-1 Masterclass Consultation.
            </p>
</div>
</div>
<!-- Quick Rules Checklist Card -->
<div class="bg-surface-container/75 backdrop-blur-md rounded-[18px] p-space-lg shadow-xl shadow-surface-container-lowest/50 flex flex-col gap-space-md">
<div class="flex items-center gap-space-sm">
<span class="material-symbols-outlined text-primary text-[22px]">fact_check</span>
<h3 class="font-headline-sm text-headline-sm text-on-surface">Quick Rules Checklist</h3>
</div>
<ul class="flex flex-col gap-space-sm">
<li class="flex items-start gap-space-sm">
<span class="material-symbols-outlined text-secondary text-[18px] mt-0.5 shrink-0">check_circle</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">Original domestic or professional recipe</span>
</li>
<li class="flex items-start gap-space-sm">
<span class="material-symbols-outlined text-secondary text-[18px] mt-0.5 shrink-0">check_circle</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">Clear measurements and steps</span>
</li>
<li class="flex items-start gap-space-sm">
<span class="material-symbols-outlined text-secondary text-[18px] mt-0.5 shrink-0">check_circle</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">Minimum 1 authentic photograph</span>
</li>
<li class="flex items-start gap-space-sm">
<span class="material-symbols-outlined text-secondary text-[18px] mt-0.5 shrink-0">check_circle</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">Guest submissions fully eligible</span>
</li>
</ul>
<div class="pt-space-xs mt-space-xs">
<a class="inline-flex items-center gap-1.5 font-title-md text-title-md text-primary hover:text-primary-container transition-colors group" data-path="faq" href="#">
<span>Questions about criteria? Visit our FAQ</span>
<span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
</a>
</div>
</div>
</aside>
</div>
</div>
</div>
<script>
  function toggleEntryType(type) {
    const recipeBtn = document.getElementById('typeRecipeBtn');
    const tipBtn = document.getElementById('typeTipBtn');
    const recipeFields = document.getElementById('recipeFieldsGroup');
    const tipFields = document.getElementById('tipFieldsGroup');

    if (type === 'recipe') {
      recipeBtn.className = 'flex items-center justify-center gap-space-xs py-2.5 rounded-lg font-title-md text-title-md transition-all bg-primary-container text-surface-container-lowest shadow-sm';
      tipBtn.className = 'flex items-center justify-center gap-space-xs py-2.5 rounded-lg font-title-md text-title-md transition-all text-on-surface-variant hover:text-on-surface';
      recipeFields.classList.remove('hidden');
      recipeFields.classList.add('flex');
      tipFields.classList.add('hidden');
      tipFields.classList.remove('flex');
    } else {
      tipBtn.className = 'flex items-center justify-center gap-space-xs py-2.5 rounded-lg font-title-md text-title-md transition-all bg-primary-container text-surface-container-lowest shadow-sm';
      recipeBtn.className = 'flex items-center justify-center gap-space-xs py-2.5 rounded-lg font-title-md text-title-md transition-all text-on-surface-variant hover:text-on-surface';
      tipFields.classList.remove('hidden');
      tipFields.classList.add('flex');
      recipeFields.classList.add('hidden');
      recipeFields.classList.remove('flex');
    }
  }

  function handleFileSelect(input) {
    if (input.files && input.files[0]) {
      const file = input.files[0];
      const previewBadge = document.getElementById('filePreviewBadge');
      const fileName = document.getElementById('fileName');
      const uploadText = document.getElementById('uploadText');

      fileName.textContent = file.name;
      previewBadge.classList.remove('hidden');
      previewBadge.classList.add('inline-flex');
      uploadText.textContent = "Photograph selected successfully";
    }
  }
</script>