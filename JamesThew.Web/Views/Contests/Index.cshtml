@model IEnumerable<JamesThew.Web.Models.Entities.Contest>
@{
    ViewData["Title"] = "Active Culinary Contests - Chef James Thew";
    var featured = Model?.FirstOrDefault();
    var otherContests = Model?.Skip(1).ToList() ?? new List<JamesThew.Web.Models.Entities.Contest>();
    var pastContests = ViewBag.PastContests as IEnumerable<JamesThew.Web.Models.Entities.Contest> ?? new List<JamesThew.Web.Models.Entities.Contest>();
}

<!-- Subtle Ambient Glow -->
<div class="relative w-full overflow-hidden px-margin-mobile lg:px-margin py-space-lg lg:py-space-xl">
  <div class="pointer-events-none absolute -top-40 right-10 w-96 h-96 rounded-full bg-primary-container/10 blur-[120px]"></div>
  <div class="pointer-events-none absolute top-1/2 left-0 w-80 h-80 rounded-full bg-secondary-container/15 blur-[100px]"></div>

  @if (TempData["SuccessMessage"] != null)
  {
    <div class="mb-6 p-4 rounded-xl bg-secondary-container/60 text-secondary border border-secondary/30 flex items-center gap-3">
      <span class="material-symbols-outlined text-[24px]">check_circle</span>
      <span class="font-body-md">@TempData["SuccessMessage"]</span>
    </div>
  }
  @if (TempData["ErrorMessage"] != null)
  {
    <div class="mb-6 p-4 rounded-xl bg-error-container/60 text-error border border-error/30 flex items-center gap-3">
      <span class="material-symbols-outlined text-[24px]">error</span>
      <span class="font-body-md">@TempData["ErrorMessage"]</span>
    </div>
  }

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="flex items-center gap-space-xs font-body-sm text-body-sm text-outline mb-space-md">
    <a class="hover:text-primary transition-colors" asp-controller="Home" asp-action="Index">Home</a>
    <span class="material-symbols-outlined text-[14px] text-outline-variant">chevron_right</span>
    <span class="text-on-surface font-medium">Culinary Contests</span>
  </nav>

  <!-- Page Header -->
  <header class="flex flex-col sm:flex-row sm:items-end justify-between gap-space-md mb-space-xl">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-space-xs mb-1">
        <span class="w-2 h-2 rounded-full bg-primary-container"></span>
        <span class="font-label-md text-label-md tracking-widest uppercase text-primary">Seasonal Culinary Competitions</span>
      </div>
      <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">Active Culinary Contests</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
        Showcase your kitchen craft, earn prestigious guild recognition, and win exclusive artisanal culinary kits.
      </p>
    </div>
    <a asp-action="PastWinners" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-surface-container-high hover:bg-surface-container-highest text-on-surface font-title-md transition-all shadow-sm">
      <span class="material-symbols-outlined text-[20px] text-primary" style="font-variation-settings: 'FILL' 1;">emoji_events</span>
      <span>Hall of Past Winners</span>
    </a>
  </header>

  @if (featured != null)
  {
    <!-- Large Hero Banner: Featured Active Contest -->
    <section class="relative w-full rounded-[18px] bg-surface-container-high/70 backdrop-blur-xl p-space-md md:p-space-lg lg:p-space-xl shadow-[0_16px_48px_rgba(0,17,15,0.7)] mb-space-xl overflow-hidden border border-primary-container/20">
      <div class="pointer-events-none absolute inset-0 rounded-[18px] bg-gradient-to-b from-primary-container/10 via-transparent to-transparent"></div>
      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-gutter lg:items-center">
        <!-- Banner Left Content -->
        <div class="lg:col-span-7 flex flex-col gap-space-md">
          <div class="flex flex-wrap items-center gap-space-sm">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-container/40 text-secondary font-label-md text-label-md tracking-wider uppercase">
              <span class="material-symbols-outlined text-[14px]">local_fire_department</span>
              Featured Monthly Challenge
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container-highest/60 text-primary-fixed-dim font-label-md text-label-md">
              <span class="material-symbols-outlined text-[14px]">calendar_month</span>
              @featured.StartDate.ToString("MMM dd") – @featured.EndDate.ToString("MMM dd, yyyy")
            </span>
          </div>

          <h2 class="font-headline-xl text-headline-xl text-on-surface leading-tight">
            @featured.Title
          </h2>
          <p class="font-body-lg text-body-lg text-secondary font-medium">
            @featured.Description
          </p>

          <!-- Grand Prize Mention -->
          <div class="p-space-sm rounded-xl bg-surface-container-low/90 backdrop-blur-md">
            <span class="font-label-sm text-label-sm uppercase tracking-wider text-outline block mb-0.5">Grand Prize Package</span>
            <span class="font-title-md text-title-md text-primary font-semibold flex items-center gap-2">
              <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">stars</span>
              @(string.IsNullOrEmpty(featured.Prize) ? "Chef James's Artisanal Culinary Kit + Masterclass Consultation" : featured.Prize)
            </span>
          </div>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-space-md pt-space-sm">
            <a asp-action="Participate" asp-route-contestId="@featured.Id" class="inline-flex items-center justify-center px-space-xl py-3 rounded-full bg-primary-container text-surface-container-lowest font-title-md text-title-md shadow-[0_4px_20px_rgba(217,138,86,0.35)] hover:bg-primary transition-all">
              <span>Participate Now</span>
              <span class="material-symbols-outlined ml-1.5 text-[18px]">arrow_forward</span>
            </a>
            <span class="font-label-md text-label-md text-outline">
              @featured.Entries.Count Contest Entries Registered
            </span>
          </div>
        </div>

        <!-- Right Visual Showcase -->
        <div class="lg:col-span-5 flex flex-col gap-space-sm">
          <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl bg-surface-container">
            <img class="w-full h-full object-cover transform hover:scale-105 transition-transform duration-700" alt="Prize showcase" src="~/images/luxurious-culinary-toolkit-arrangement-featuring-7094ec.jpg" />
            <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-transparent to-transparent"></div>
            <div class="absolute top-3 right-3 px-3 py-1 rounded-full bg-surface-container-lowest/85 backdrop-blur-md text-primary font-label-md text-label-md flex items-center gap-1 shadow-sm">
              <span class="material-symbols-outlined text-[16px]">stars</span>
              Official Award Kit
            </div>
          </div>
        </div>
      </div>
    </section>
  }
  else
  {
    <div class="py-16 text-center bg-surface-container/40 rounded-2xl border border-outline-variant/30 mb-space-xl p-space-lg">
      <span class="material-symbols-outlined text-6xl text-outline mb-2">event_busy</span>
      <h3 class="font-headline-sm text-headline-sm text-on-surface">No Contests Open at This Moment</h3>
      <p class="font-body-sm text-on-surface-variant mt-1">Check back soon for the next seasonal contest or explore our Hall of Past Winners.</p>
      <a asp-action="PastWinners" class="inline-block mt-4 px-space-lg py-2.5 rounded-full bg-primary-container text-surface-container-lowest font-title-md text-sm">View Past Champions</a>
    </div>
  }

  <!-- Other Active Contests -->
  @if (otherContests.Any())
  {
    <section class="mb-space-xl">
      <h2 class="font-headline-lg text-headline-lg text-on-surface mb-space-lg">Concurrent Challenges</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
        @foreach (var contest in otherContests)
        {
          <div class="bg-surface-container/80 backdrop-blur-xl rounded-[18px] p-space-lg flex flex-col justify-between shadow-lg border border-outline-variant/30 hover:-translate-y-1 transition-all">
            <div>
              <div class="flex items-center justify-between mb-space-sm">
                <span class="px-2.5 py-0.5 rounded-full bg-secondary-container/40 text-secondary font-label-sm text-label-sm uppercase font-semibold">Active</span>
                <span class="text-outline font-label-sm text-label-sm">Closes @contest.EndDate.ToString("MMM dd")</span>
              </div>
              <h3 class="font-headline-sm text-headline-sm text-on-surface mb-2">@contest.Title</h3>
              <p class="font-body-sm text-body-sm text-on-surface-variant mb-4 line-clamp-3">@contest.Description</p>
              <div class="p-2.5 rounded-xl bg-surface-container-high text-primary font-body-sm text-body-sm mb-4 flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px]">card_giftcard</span>
                <span>Prize: @contest.Prize</span>
              </div>
            </div>
            <a asp-action="Participate" asp-route-contestId="@contest.Id" class="w-full py-2.5 rounded-full bg-primary-container text-surface-container-lowest font-title-md text-title-md font-semibold text-center hover:bg-primary transition-all flex items-center justify-center gap-1.5">
              <span>Submit Entry</span>
              <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
          </div>
        }
      </div>
    </section>
  }

  <!-- Past Contest Archive Quick Strip -->
  @if (pastContests.Any())
  {
    <section class="p-space-lg rounded-2xl bg-surface-container/50 border border-outline-variant/30">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm mb-space-md">
        <div>
          <h3 class="font-headline-sm text-headline-sm text-on-surface">Recently Concluded Contests</h3>
          <p class="font-body-sm text-body-sm text-on-surface-variant">Review previous challenges and their awarded recipes and tips.</p>
        </div>
        <a asp-action="PastWinners" class="text-primary font-title-md hover:underline flex items-center gap-1">
          <span>See Hall of Fame</span>
          <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-space-md">
        @foreach (var pc in pastContests)
        {
          <div class="p-space-md rounded-xl bg-surface-container-high/60 flex items-center justify-between">
            <div>
              <h4 class="font-title-md text-on-surface">@pc.Title</h4>
              <span class="font-label-sm text-outline">Ended @pc.EndDate.ToString("MMM yyyy") • @pc.Entries.Count Entries</span>
            </div>
            <span class="material-symbols-outlined text-outline">emoji_events</span>
          </div>
        }
      </div>
    </section>
  }
</div>
