<textarea class="w-full bg-[#001714] text-on-surface text-body-md rounded-xl p-space-md border border-outline-variant/30 focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none" placeholder="Detail the guidelines, key ingredients, preparation standards, and evaluation criteria for participating chefs..." rows="4"></textarea>
</div>
<div>
<label class="block text-label-md text-on-surface-variant mb-space-xs">Prize Details</label>
<input class="w-full bg-[#001714] text-on-surface text-body-md rounded-xl px-space-md py-2.5 border border-outline-variant/30 focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none" placeholder="e.g., $1,000 Cash Prize + Chef James Thew Signature Knife" type="text"/>
</div>
