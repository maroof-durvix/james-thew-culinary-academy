@model IEnumerable<JamesThew.Web.Models.Entities.Contest>
@{
    ViewData["Title"] = "Manage Culinary Contests";
    Layout = "_AdminLayout";
}

@if (TempData["Success"] != null)
{
    <div class="mb-6 p-4 rounded-xl bg-[rgba(93,187,138,0.15)] border border-[rgba(93,187,138,0.3)] text-[#5DBB8A] flex items-center gap-3">
        <span class="material-symbols-outlined text-[20px]">check_circle</span>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-6 p-4 rounded-xl bg-error/15 border border-error/30 text-error flex items-center gap-3">
        <span class="material-symbols-outlined text-[20px]">error</span>
        <span>@TempData["Error"]</span>
    </div>
}

<div class="flex flex-col w-full text-on-surface pb-16">
    <!-- Top Action & Overview Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-space-md mb-space-xl">
        <div>
            <span class="text-label-sm uppercase tracking-wider text-primary">Culinary Competitions</span>
            <h1 class="font-headline text-headline-xl text-on-surface mt-1">Manage Contests</h1>
            <p class="text-body-md text-on-surface-variant max-w-2xl mt-1">
                Curate seasonal challenges, monitor community participation, and evaluate culinary creations.
            </p>
        </div>
        <div>
            <button class="inline-flex items-center gap-space-sm bg-primary hover:bg-[#E8A173] text-[#0A211E] px-6 py-2.5 rounded-full font-title-md shadow-lg transition-all cursor-pointer" onclick="toggleSlideOver(true)">
                <span class="material-symbols-outlined">add</span>
                Create Contest
            </button>
        </div>
    </div>

    <!-- KPI Statistics Row -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md mb-space-xl">
        <div class="bg-surface-container-low/70 backdrop-blur-xl p-space-lg rounded-xl border border-outline-variant/10 shadow-xl">
            <span class="text-label-sm text-outline uppercase tracking-wider">Total Contests</span>
            <div class="flex items-baseline justify-between mt-space-sm">
                <span class="font-headline text-4xl text-on-surface">@Model.Count()</span>
                <span class="text-primary text-body-sm font-medium">All challenges</span>
            </div>
        </div>
        <div class="bg-surface-container-low/70 backdrop-blur-xl p-space-lg rounded-xl border border-outline-variant/10 shadow-xl">
            <span class="text-label-sm text-outline uppercase tracking-wider">Active Challenges</span>
            <div class="flex items-baseline justify-between mt-space-sm">
                <span class="font-headline text-4xl text-on-surface">@Model.Count(c => c.Status == "Active")</span>
                <span class="text-secondary text-body-sm font-medium">Live &amp; accepting</span>
            </div>
        </div>
        <div class="bg-surface-container-low/70 backdrop-blur-xl p-space-lg rounded-xl border border-outline-variant/10 shadow-xl">
            <span class="text-label-sm text-outline uppercase tracking-wider">Total Submissions</span>
            <div class="flex items-baseline justify-between mt-space-sm">
                <span class="font-headline text-4xl text-on-surface">@Model.Sum(c => c.Entries.Count)</span>
                <span class="text-secondary text-body-sm font-medium">Community dishes</span>
            </div>
        </div>
    </div>

    <!-- Contests Table Section -->
    <div class="bg-surface-container-low/70 backdrop-blur-xl rounded-xl border border-outline-variant/10 shadow-xl overflow-hidden mb-space-xl">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-outline-variant/10 bg-[#184238]/30">
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Contest Title</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Timeline</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Status</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Entries</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990] text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/10 text-body-md text-on-surface">
                    @foreach (var contest in Model)
                    {
                        <tr class="hover:bg-[rgba(24,66,56,0.5)] transition-colors">
                            <td class="py-4 px-6">
                                <div class="font-headline text-title-lg text-[#F6EFE3]">@contest.Title</div>
                                <div class="text-body-sm text-on-surface-variant line-clamp-1">@contest.Description</div>
                            </td>
                            <td class="py-4 px-6 text-body-sm text-[#B7C7BF]">
                                <div>@contest.StartDate.ToString("MMM dd") - @contest.EndDate.ToString("MMM dd, yyyy")</div>
                            </td>
                            <td class="py-4 px-6">
                                <span class="px-3 py-1 rounded-full text-label-sm font-semibold @(contest.Status == "Active" ? "bg-[rgba(93,187,138,0.15)] text-[#5DBB8A] border border-[rgba(93,187,138,0.3)]" : "bg-surface-container-high text-on-surface-variant")">
                                    @contest.Status
                                </span>
                            </td>
                            <td class="py-4 px-6 font-semibold text-primary">
                                @contest.Entries.Count submissions
                            </td>
                            <td class="py-4 px-6 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a asp-action="ContestEntries" class="p-1.5 rounded-lg bg-[#184238] text-on-surface-variant hover:text-primary transition-colors" title="Review Entries">
                                        <span class="material-symbols-outlined text-sm">visibility</span>
                                    </a>
                                    <form asp-action="DeleteContest" asp-route-id="@contest.Id" method="post" class="inline" onsubmit="return confirm('Delete this contest and its records?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="p-1.5 rounded-lg bg-[#184238] text-error hover:bg-error/20 transition-colors cursor-pointer" title="Delete Contest">
                                            <span class="material-symbols-outlined text-sm">delete</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Create Contest SlideOver Drawer -->
    <div class="fixed inset-0 z-50 hidden" id="slideOver">
        <div class="fixed inset-0 bg-black/60 backdrop-blur-sm transition-opacity opacity-0" id="slideBackdrop" onclick="toggleSlideOver(false)"></div>
        <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
            <div class="w-screen max-w-xl bg-[#0A211E] border-l border-outline-variant/30 shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300" id="slidePanel">
                <!-- Header -->
                <div class="px-space-lg py-space-md border-b border-outline-variant/20 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">emoji_events</span>
                        <h2 class="font-headline text-headline-sm text-on-surface">Create New Contest</h2>
                    </div>
                    <button class="p-2 text-on-surface-variant hover:text-on-surface rounded-full hover:bg-surface-container transition-colors cursor-pointer" onclick="toggleSlideOver(false)">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

                <!-- Form -->
                <form asp-action="CreateContest" method="post" class="flex-1 flex flex-col justify-between overflow-y-auto">
                    @Html.AntiForgeryToken()
                    <div class="p-space-lg space-y-space-lg">
                        <div>
                            <label class="block text-label-md text-on-surface-variant mb-space-xs">Contest Title <span class="text-primary">*</span></label>
                            <input name="title" class="w-full bg-[#001714] text-on-surface text-body-md rounded-xl px-space-md py-3 border border-outline-variant/30 focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none" placeholder="e.g., Summer Artisanal Pasta Masterclass" required />
                        </div>
                        <div>
                            <label class="block text-label-md text-on-surface-variant mb-space-xs">Description &amp; Guidelines <span class="text-primary">*</span></label>
                            <textarea name="description" rows="5" class="w-full bg-[#001714] text-on-surface text-body-md rounded-xl p-space-md border border-outline-variant/30 focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none" placeholder="Detail the challenge requirements, judging criteria, and technique expectations..." required></textarea>
                        </div>
                        <div class="grid grid-cols-2 gap-space-md">
                            <div>
                                <label class="block text-label-md text-on-surface-variant mb-space-xs">Start Date <span class="text-primary">*</span></label>
                                <input name="startDate" type="date" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" class="w-full bg-[#001714] text-on-surface text-body-md rounded-xl px-space-md py-3 border border-outline-variant/30 focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none" required />
                            </div>
                            <div>
                                <label class="block text-label-md text-on-surface-variant mb-space-xs">End Date <span class="text-primary">*</span></label>
                                <input name="endDate" type="date" value="@DateTime.UtcNow.AddMonths(1).ToString("yyyy-MM-dd")" class="w-full bg-[#001714] text-on-surface text-body-md rounded-xl px-space-md py-3 border border-outline-variant/30 focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none" required />
                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="px-space-lg py-space-md border-t border-outline-variant/20 bg-[#052420] flex items-center justify-end gap-space-sm">
                        <button type="button" class="px-space-lg py-2.5 rounded-full text-on-surface-variant hover:text-on-surface text-body-md font-medium transition-colors cursor-pointer" onclick="toggleSlideOver(false)">Cancel</button>
                        <button type="submit" class="bg-primary hover:bg-[#E8A173] text-[#0A211E] px-space-lg py-2.5 rounded-full font-title-md shadow-lg transition-all cursor-pointer">Publish Contest</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleSlideOver(open) {
        const slideOver = document.getElementById('slideOver');
        const backdrop = document.getElementById('slideBackdrop');
        const panel = document.getElementById('slidePanel');

        if (open) {
            slideOver.classList.remove('hidden');
            setTimeout(() => {
                backdrop.classList.add('opacity-100');
                panel.classList.remove('translate-x-full');
            }, 10);
        } else {
            backdrop.classList.remove('opacity-100');
            panel.classList.add('translate-x-full');
            setTimeout(() => {
                slideOver.classList.add('hidden');
            }, 300);
        }
    }
</script>
