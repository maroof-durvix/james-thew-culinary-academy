<span class="text-body-sm text-on-surface font-medium">Recipe</span>
</label>
<label class="flex items-center justify-center gap-2 p-3 rounded-xl bg-[#001714] border border-outline-variant/30 cursor-pointer hover:border-primary transition-all">
<input class="text-primary focus:ring-0" name="contest_category" type="radio"/>
<span class="text-body-sm text-on-surface font-medium">Tip</span>
</label>
<label class="flex items-center justify-center gap-2 p-3 rounded-xl bg-[#001714] border border-outline-variant/30 cursor-pointer hover:border-primary transition-all">
<input checked="" class="text-primary focus:ring-0" name="contest_category" type="radio"/>
<span class="text-body-sm text-on-surface font-medium">Both</span>
</label>
</div>
</div>
