@model JamesThew.Web.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Overview";
    Layout = "_AdminLayout";
}

<div class="flex flex-col w-full pb-16">
    <!-- Greeting Section -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
        <div>
            <h1 class="text-headline-xl font-headline text-[#F6EFE3]">Welcome back, Chef James</h1>
            <p class="text-body-md text-[#B7C7BF] mt-1">Culinary platform analytics and administrative oversight.</p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="RecipeForm" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#D98A56] hover:bg-[#E8A173] text-[#0A211E] text-title-md transition-all shadow-[0_4px_16px_rgba(217,138,86,0.25)]">
                <span class="material-symbols-outlined text-lg">add</span>
                Add Recipe
            </a>
            <a asp-action="TipForm" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-[rgba(246,239,227,0.4)] hover:border-[#F6EFE3] hover:bg-[rgba(246,239,227,0.08)] text-[#F6EFE3] text-title-md transition-all">
                <span class="material-symbols-outlined text-lg">lightbulb</span>
                Add Tip
            </a>
            <a asp-action="Contests" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-[rgba(246,239,227,0.4)] hover:border-[#F6EFE3] hover:bg-[rgba(246,239,227,0.08)] text-[#F6EFE3] text-title-md transition-all">
                <span class="material-symbols-outlined text-lg">emoji_events</span>
                Manage Contests
            </a>
        </div>
    </div>

    <!-- 6 KPI Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
        <!-- Total Recipes -->
        <a asp-action="Recipes" class="p-6 rounded-[18px] bg-[#12362F]/75 backdrop-blur-md border border-[rgba(246,239,227,0.12)] shadow-xl relative overflow-hidden flex flex-col justify-between hover:border-primary/50 transition-all block">
            <div class="flex items-center justify-between mb-4">
                <span class="text-label-sm uppercase tracking-wider text-[#7F9990]">Total Recipes</span>
                <div class="p-2 rounded-xl bg-[rgba(217,138,86,0.15)] text-[#D98A56]">
                    <span class="material-symbols-outlined">restaurant_menu</span>
                </div>
            </div>
            <div class="flex items-baseline justify-between">
                <span class="text-[36px] font-headline text-[#F6EFE3] leading-tight">@Model.TotalRecipes</span>
                <span class="text-body-sm font-medium text-[#5DBB8A] flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">visibility</span> View All
                </span>
            </div>
        </a>

        <!-- Total Tips -->
        <a asp-action="Tips" class="p-6 rounded-[18px] bg-[#12362F]/75 backdrop-blur-md border border-[rgba(246,239,227,0.12)] shadow-xl relative overflow-hidden flex flex-col justify-between hover:border-primary/50 transition-all block">
            <div class="flex items-center justify-between mb-4">
                <span class="text-label-sm uppercase tracking-wider text-[#7F9990]">Total Tips</span>
                <div class="p-2 rounded-xl bg-[rgba(159,216,184,0.15)] text-[#9FD8B8]">
                    <span class="material-symbols-outlined">lightbulb</span>
                </div>
            </div>
            <div class="flex items-baseline justify-between">
                <span class="text-[36px] font-headline text-[#F6EFE3] leading-tight">@Model.TotalTips</span>
                <span class="text-body-sm font-medium text-[#5DBB8A] flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">visibility</span> View All
                </span>
            </div>
        </a>

        <!-- Total Users & Members -->
        <a asp-action="Users" class="p-6 rounded-[18px] bg-[#12362F]/75 backdrop-blur-md border border-[rgba(246,239,227,0.12)] shadow-xl relative overflow-hidden flex flex-col justify-between hover:border-primary/50 transition-all block">
            <div class="flex items-center justify-between mb-4">
                <span class="text-label-sm uppercase tracking-wider text-[#7F9990]">Platform Users</span>
                <div class="p-2 rounded-xl bg-[rgba(217,138,86,0.15)] text-[#D98A56]">
                    <span class="material-symbols-outlined">group</span>
                </div>
            </div>
            <div class="flex items-baseline justify-between">
                <span class="text-[36px] font-headline text-[#F6EFE3] leading-tight">@Model.TotalUsers</span>
                <span class="text-body-sm font-medium text-[#D98A56]">@Model.TotalMembers VIP Members</span>
            </div>
        </a>

        <!-- Active Contests -->
        <a asp-action="Contests" class="p-6 rounded-[18px] bg-[#12362F]/75 backdrop-blur-md border border-[rgba(246,239,227,0.12)] shadow-xl relative overflow-hidden flex flex-col justify-between hover:border-primary/50 transition-all block">
            <div class="flex items-center justify-between mb-4">
                <span class="text-label-sm uppercase tracking-wider text-[#7F9990]">Active Contests</span>
                <div class="p-2 rounded-xl bg-[rgba(159,216,184,0.15)] text-[#9FD8B8]">
                    <span class="material-symbols-outlined">emoji_events</span>
                </div>
            </div>
            <div class="flex items-baseline justify-between">
                <span class="text-[36px] font-headline text-[#F6EFE3] leading-tight">@Model.TotalContests</span>
                <span class="text-body-sm font-medium text-[#7F9990]">Culinary Challenges</span>
            </div>
        </a>

        <!-- Contest Entries -->
        <a asp-action="ContestEntries" class="p-6 rounded-[18px] bg-[#12362F]/75 backdrop-blur-md border border-[rgba(246,239,227,0.12)] shadow-xl relative overflow-hidden flex flex-col justify-between hover:border-primary/50 transition-all block">
            <div class="flex items-center justify-between mb-4">
                <span class="text-label-sm uppercase tracking-wider text-[#7F9990]">Contest Entries</span>
                <div class="p-2 rounded-xl bg-[rgba(229,115,106,0.15)] text-[#E5736A]">
                    <span class="material-symbols-outlined">workspace_premium</span>
                </div>
            </div>
            <div class="flex items-baseline justify-between">
                <span class="text-[36px] font-headline text-[#F6EFE3] leading-tight">@Model.TotalContestEntries</span>
                <span class="text-body-sm font-medium text-[#5DBB8A]">Total Submissions</span>
            </div>
        </a>

        <!-- Support & Feedbacks -->
        <a asp-action="Feedbacks" class="p-6 rounded-[18px] bg-[#12362F]/75 backdrop-blur-md border border-[rgba(246,239,227,0.12)] shadow-xl relative overflow-hidden flex flex-col justify-between hover:border-primary/50 transition-all block">
            <div class="flex items-center justify-between mb-4">
                <span class="text-label-sm uppercase tracking-wider text-[#7F9990]">Feedbacks &amp; Inquiries</span>
                <div class="p-2 rounded-xl bg-[rgba(217,138,86,0.15)] text-[#D98A56]">
                    <span class="material-symbols-outlined">forum</span>
                </div>
            </div>
            <div class="flex items-baseline justify-between">
                <span class="text-[36px] font-headline text-[#F6EFE3] leading-tight">@Model.TotalFeedbacks</span>
                <span class="text-body-sm font-medium text-[#5DBB8A]">Inbox items</span>
            </div>
        </a>
    </div>

    <!-- Table Card: Recent Contest Entries -->
    <div class="p-6 rounded-[18px] bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] shadow-xl">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h3 class="text-headline-sm text-[#F6EFE3]">Recent Contest Submissions</h3>
                <p class="text-body-sm text-[#7F9990]">Latest submissions awaiting evaluation or winner selection</p>
            </div>
            <a asp-action="ContestEntries" class="text-title-md text-[#D98A56] hover:text-[#E8A173] transition-colors flex items-center gap-1">
                View all <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-[rgba(246,239,227,0.08)]">
                        <th class="py-3 px-4 text-label-sm text-[#7F9990] font-medium uppercase tracking-wider">Title</th>
                        <th class="py-3 px-4 text-label-sm text-[#7F9990] font-medium uppercase tracking-wider">Contest Name</th>
                        <th class="py-3 px-4 text-label-sm text-[#7F9990] font-medium uppercase tracking-wider">Type</th>
                        <th class="py-3 px-4 text-label-sm text-[#7F9990] font-medium uppercase tracking-wider">Submitted</th>
                        <th class="py-3 px-4 text-label-sm text-[#7F9990] font-medium uppercase tracking-wider text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[rgba(246,239,227,0.08)] text-body-md text-[#B7C7BF]">
                    @if (!Model.RecentEntries.Any())
                    {
                        <tr>
                            <td colspan="5" class="py-6 text-center text-[#7F9990]">No contest entries submitted yet.</td>
                        </tr>
                    }
                    @foreach (var entry in Model.RecentEntries)
                    {
                        <tr class="hover:bg-[rgba(24,66,56,0.5)] transition-colors">
                            <td class="py-4 px-4 font-medium text-[#F6EFE3]">@entry.Title</td>
                            <td class="py-4 px-4">@(entry.Contest?.Title ?? "Open Contest")</td>
                            <td class="py-4 px-4">
                                <span class="px-2.5 py-1 rounded-full text-label-md bg-[rgba(217,138,86,0.18)] text-[#D98A56] border border-[rgba(217,138,86,0.45)] inline-flex items-center gap-1">
                                    <span class="material-symbols-outlined text-xs">@(entry.EntryType == "Recipe" ? "restaurant" : "lightbulb")</span>
                                    @entry.EntryType
                                </span>
                            </td>
                            <td class="py-4 px-4 text-[#7F9990]">@entry.SubmittedAt.ToString("MMM dd, yyyy")</td>
                            <td class="py-4 px-4 text-right">
                                <a asp-action="ContestEntries" class="inline-flex items-center gap-1 px-4 py-1.5 rounded-full bg-[#D98A56] hover:bg-[#E8A173] text-[#0A211E] text-label-md font-semibold transition-all">
                                    Review
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
