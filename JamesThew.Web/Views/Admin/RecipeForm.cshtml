@{
    ViewData["Title"] = "Add Recipe";
}

<div class="flex flex-col w-full">
<!-- Top Section / Page Header -->
<div class="flex flex-col md:flex-row md:items-end justify-between mb-space-xl gap-space-md">
<div>
<div class="flex items-center gap-space-sm text-primary mb-space-xs">
<span class="material-symbols-outlined text-sm">restaurant_menu</span>
<span class="text-label-sm uppercase font-label-sm">Culinary Masterpiece Studio</span>
</div>
<h1 class="font-headline-xl text-on-surface">Publish New Recipe</h1>
</div>
<div class="flex items-center gap-space-sm">
<button class="px-space-md py-2.5 rounded-full text-body-sm font-medium text-tertiary hover:text-primary transition-all" type="button">
        Preview Layout
      </button>
<button class="px-space-md py-2.5 rounded-full text-body-sm font-medium text-on-surface-variant hover:bg-surface-container-high transition-all" type="button">
        Discard
      </button>
</div>
</div>
<!-- Main Form Container -->
<form class="grid grid-cols-1 xl:grid-cols-12 gap-space-margin">
<!-- Left Column: Primary Recipe Details (8 Cols) -->
<div class="xl:col-span-8 space-y-space-lg">
<!-- Basic Info Card -->
<div class="p-space-lg rounded-xl bg-surface-container/75 backdrop-blur-md shadow-xl transition-all">
<h2 class="font-headline-md text-on-surface mb-space-md">Core Information</h2>
<div class="space-y-space-md">
<!-- Title -->
<div>
<label class="block text-label-md text-on-surface-variant mb-space-xs">Recipe Title</label>
<input class="w-full bg-[#0A211E] text-on-surface text-body-md rounded-xl px-4 py-3 border border-outline-variant/30 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" placeholder="e.g., Truffle-Infused Wild Mushroom Risotto" type="text"/>
</div>
<!-- Category & Times Grid -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-space-md">
<div>
<label class="block text-label-md text-on-surface-variant mb-space-xs">Category</label>
<select class="w-full bg-[#0A211E] text-on-surface text-body-md rounded-xl px-4 py-3 border border-outline-variant/30 focus:border-primary focus:outline-none transition-all">
<option>Fine Dining</option>
<option>Vegetarian</option>
<option>Pastry & Dessert</option>
<option>Juices & Elixirs</option>
<option>Italian Classics</option>
</select>
</div>
<div>
<label class="block text-label-md text-on-surface-variant mb-space-xs">Prep Time (mins)</label>
<input class="w-full bg-[#0A211E] text-on-surface text-body-md rounded-xl px-4 py-3 border border-outline-variant/30 focus:border-primary focus:outline-none transition-all" placeholder="25" type="number"/>
</div>
<div>
<label class="block text-label-md text-on-surface-variant mb-space-xs">Cooking Time (mins)</label>
<input class="w-full bg-[#0A211E] text-on-surface text-body-md rounded-xl px-4 py-3 border border-outline-variant/30 focus:border-primary focus:outline-none transition-all" placeholder="40" type="number"/>
</div>
</div>
</div>
</div>
<!-- Ingredients & Procedure Card -->
<div class="p-space-lg rounded-xl bg-surface-container/75 backdrop-blur-md shadow-xl transition-all">
<h2 class="font-headline-md text-on-surface mb-space-md">Kitchencraft & Ingredients</h2>
<div class="space-y-space-lg">
<!-- Ingredients -->
<div>
<div class="flex items-center justify-between mb-space-xs">
<label class="block text-label-md text-on-surface-variant">Ingredients List (one per line)</label>
<span class="text-label-sm text-tertiary">Include precise measurements</span>
</div>
<textarea class="w-full bg-[#0A211E] text-on-surface text-body-md rounded-xl p-4 border border-outline-variant/30 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" placeholder="400g Carnaroli rice
1.2l rich vegetable stock
200g wild porcini mushrooms" rows="5"></textarea>
</div>
<!-- Procedure -->
<div>
<div class="flex items-center justify-between mb-space-xs">
<label class="block text-label-md text-on-surface-variant">Procedure & Technique</label>
<span class="text-label-sm text-tertiary">Step-by-step instructions</span>
</div>
<textarea class="w-full bg-[#0A211E] text-on-surface text-body-md rounded-xl p-4 border border-outline-variant/30 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" placeholder="1. Gently warm the stock in a separate pan...
2. Sauté shallots in extra virgin olive oil until translucent..." rows="7"></textarea>
</div>
</div>
</div>
</div>
<!-- Right Column: Admin Controls, Access & Media (4 Cols) -->
<div class="xl:col-span-4 space-y-space-lg">
<!-- Access Type Radio Cards (Admin Exclusive) -->
<div class="p-space-lg rounded-xl bg-surface-container/75 backdrop-blur-md shadow-xl transition-all border border-primary/20">
<div class="flex items-center gap-space-sm mb-space-md">
<span class="material-symbols-outlined text-primary">admin_panel_settings</span>
<h2 class="font-headline-md text-on-surface">Access Tier</h2>
</div>
<p class="text-body-sm text-on-surface-variant mb-space-md">Determine membership accessibility level for this publication.</p>
<div class="grid grid-cols-2 gap-space-md">
<!-- Free Option -->
<label class="relative flex flex-col p-space-md rounded-xl bg-[#0A211E] border border-outline-variant/30 cursor-pointer hover:border-secondary transition-all group">
<input checked="" class="peer sr-only" name="access_type" type="radio" value="free"/>
<div class="absolute top-3 right-3 w-4 h-4 rounded-full border border-outline-variant peer-checked:border-secondary peer-checked:bg-secondary flex items-center justify-center transition-all">
<div class="w-2 h-2 rounded-full bg-surface opacity-0 peer-checked:opacity-100 transition-all"></div>
</div>
<span class="inline-flex items-center px-2 py-0.5 rounded-full text-label-sm bg-[#5DBB8A]/15 text-[#5DBB8A] border border-[#5DBB8A]/30 w-max mb-space-sm font-semibold">Free</span>
<span class="text-title-md text-on-surface">Standard</span>
<span class="text-body-sm text-on-surface-variant mt-1">Available to all registered community members.</span>
</label>
<!-- Premium Option -->
<label class="relative flex flex-col p-space-md rounded-xl bg-[#0A211E] border border-outline-variant/30 cursor-pointer hover:border-primary transition-all group">
<input class="peer sr-only" name="access_type" type="radio" value="premium"/>
<div class="absolute top-3 right-3 w-4 h-4 rounded-full border border-outline-variant peer-checked:border-primary peer-checked:bg-primary flex items-center justify-center transition-all">
<div class="w-2 h-2 rounded-full bg-surface opacity-0 peer-checked:opacity-100 transition-all"></div>
</div>
<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-label-sm bg-primary/18 text-primary border border-primary/45 w-max mb-space-sm font-semibold">
<span class="material-symbols-outlined text-[12px]">workspace_premium</span> Premium
            </span>
<span class="text-title-md text-on-surface">Masterclass</span>
<span class="text-body-sm text-on-surface-variant mt-1">Exclusive high-tier culinary content.</span>
</label>
</div>
</div>
<!-- Image Upload Card -->
<div class="p-space-lg rounded-xl bg-surface-container/75 backdrop-blur-md shadow-xl transition-all">
<h2 class="font-headline-md text-on-surface mb-space-md">Featured Photography</h2>
<div class="relative border-2 border-dashed border-outline-variant/40 rounded-xl p-space-lg text-center hover:border-primary transition-all bg-[#0A211E]/50 group cursor-pointer">
<input class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" type="file"/>
<div class="flex flex-col items-center justify-center space-y-space-sm">
<div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-2xl">add_a_photo</span>
</div>
<div>
<p class="text-title-md text-on-surface">Click to upload image</p>
<p class="text-body-sm text-on-surface-variant">SVG, PNG, JPG or WEBP (16:10 ratio recommended)</p>
</div>
</div>
</div>
</div>
<!-- Submission Actions -->
<div class="p-space-lg rounded-xl bg-surface-container/75 backdrop-blur-md shadow-xl flex flex-col gap-space-md">
<!-- Publish Button -->
<button class="w-full py-3.5 px-6 rounded-full bg-primary text-on-primary font-title-md shadow-[0_4px_20px_rgba(217,138,86,0.3)] hover:bg-[#E8A173] hover:shadow-[0_6px_24px_rgba(217,138,86,0.45)] transition-all flex items-center justify-center gap-space-sm" type="submit">
<span class="material-symbols-outlined">publish</span>
          Publish Recipe
        </button>
<!-- Save Draft Button -->
<button class="w-full py-3 px-6 rounded-full text-tertiary hover:text-on-surface hover:bg-surface-container-high font-title-md transition-all flex items-center justify-center gap-space-sm" type="button">
<span class="material-symbols-outlined">save</span>
          Save Draft
        </button>
</div>
</div>
</form>
</div>
