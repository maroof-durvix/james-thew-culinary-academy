@model JamesThew.Web.Models.ViewModels.AdminRecipeFormViewModel
@{
    ViewData["Title"] = Model.Id > 0 ? "Edit Recipe" : "Publish New Recipe";
    Layout = "_AdminLayout";
}

<!-- Top Section / Page Header -->
<div class="flex flex-col md:flex-row md:items-end justify-between mb-space-xl gap-space-md">
    <div>
        <div class="flex items-center gap-space-sm text-primary mb-space-xs">
            <span class="material-symbols-outlined text-sm">restaurant_menu</span>
            <span class="text-label-sm uppercase font-label-sm">Culinary Masterpiece Studio</span>
        </div>
        <h1 class="font-headline-xl text-on-surface">@(Model.Id > 0 ? "Edit Recipe Details" : "Publish New Recipe")</h1>
    </div>
    <div class="flex items-center gap-space-sm">
        <a asp-action="Recipes" class="px-space-md py-2.5 rounded-full text-body-sm font-medium text-on-surface-variant hover:bg-surface-container-high transition-all">
            Back to Catalog
        </a>
    </div>
</div>

<!-- Main Form Container -->
<form asp-action="RecipeForm" method="post" enctype="multipart/form-data" class="grid grid-cols-1 xl:grid-cols-12 gap-8">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CurrentImagePath" />

    <!-- Left Column: Primary Recipe Details (8 Cols) -->
    <div class="xl:col-span-8 space-y-space-lg">
        <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-error/15 border border-error/30 text-error text-body-sm"></div>

        <!-- Basic Info Card -->
        <div class="p-space-lg rounded-xl bg-surface-container/75 backdrop-blur-md shadow-xl transition-all">
            <h2 class="font-headline-md text-on-surface mb-space-md">Core Information</h2>
            <div class="space-y-space-md">
                <!-- Title -->
                <div>
                    <label asp-for="Title" class="block text-label-md text-on-surface-variant mb-space-xs">Recipe Title <span class="text-primary">*</span></label>
                    <input asp-for="Title" class="w-full bg-[#0A211E] text-on-surface text-body-md rounded-xl px-4 py-3 border border-outline-variant/30 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" placeholder="e.g., Truffle-Infused Wild Mushroom Risotto" required />
                    <span asp-validation-for="Title" class="text-error text-label-sm"></span>
                </div>

                <!-- Category & Times Grid -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md">
                    <div>
                        <label asp-for="CategoryId" class="block text-label-md text-on-surface-variant mb-space-xs">Category <span class="text-primary">*</span></label>
                        <select asp-for="CategoryId" class="w-full bg-[#0A211E] text-on-surface text-body-md rounded-xl px-4 py-3 border border-outline-variant/30 focus:border-primary focus:outline-none transition-all cursor-pointer" required>
                            <option value="">Select Category...</option>
                            @if (Model.Categories != null)
                            {
                                foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-error text-label-sm"></span>
                    </div>
                    <div>
                        <label asp-for="PrepMinutes" class="block text-label-md text-on-surface-variant mb-space-xs">Prep Time (mins)</label>
                        <input asp-for="PrepMinutes" type="number" min="1" max="1440" class="w-full bg-[#0A211E] text-on-surface text-body-md rounded-xl px-4 py-3 border border-outline-variant/30 focus:border-primary focus:outline-none transition-all" required />
                        <span asp-validation-for="PrepMinutes" class="text-error text-label-sm"></span>
                    </div>
                    <div>
                        <label asp-for="CookMinutes" class="block text-label-md text-on-surface-variant mb-space-xs">Cooking Time (mins)</label>
                        <input asp-for="CookMinutes" type="number" min="0" max="1440" class="w-full bg-[#0A211E] text-on-surface text-body-md rounded-xl px-4 py-3 border border-outline-variant/30 focus:border-primary focus:outline-none transition-all" required />
                        <span asp-validation-for="CookMinutes" class="text-error text-label-sm"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ingredients & Procedure Card -->
        <div class="p-space-lg rounded-xl bg-surface-container/75 backdrop-blur-md shadow-xl transition-all">
            <h2 class="font-headline-md text-on-surface mb-space-md">Kitchencraft &amp; Ingredients</h2>
            <div class="space-y-space-lg">
                <!-- Ingredients -->
                <div>
                    <div class="flex items-center justify-between mb-space-xs">
                        <label asp-for="Ingredients" class="block text-label-md text-on-surface-variant">Ingredients List (one per line) <span class="text-primary">*</span></label>
                        <span class="text-label-sm text-tertiary">Include precise measurements</span>
                    </div>
                    <textarea asp-for="Ingredients" rows="6" class="w-full bg-[#0A211E] text-on-surface text-body-md rounded-xl p-4 border border-outline-variant/30 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" placeholder="400g Carnaroli rice&#10;1.2l rich vegetable stock&#10;200g wild porcini mushrooms" required></textarea>
                    <span asp-validation-for="Ingredients" class="text-error text-label-sm"></span>
                </div>

                <!-- Procedure -->
                <div>
                    <div class="flex items-center justify-between mb-space-xs">
                        <label asp-for="Procedure" class="block text-label-md text-on-surface-variant">Procedure &amp; Technique <span class="text-primary">*</span></label>
                        <span class="text-label-sm text-tertiary">Step-by-step instructions</span>
                    </div>
                    <textarea asp-for="Procedure" rows="7" class="w-full bg-[#0A211E] text-on-surface text-body-md rounded-xl p-4 border border-outline-variant/30 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" placeholder="1. Gently warm the stock in a separate pan...&#10;2. Sauté shallots until translucent...&#10;3. Toast rice for 2 minutes before deglazing." required></textarea>
                    <span asp-validation-for="Procedure" class="text-error text-label-sm"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Settings & Publishing (4 Cols) -->
    <div class="xl:col-span-4 space-y-6">
        <!-- Access Settings -->
        <div class="p-space-lg rounded-xl bg-surface-container/75 backdrop-blur-md shadow-xl">
            <h3 class="font-title-md text-on-surface mb-4">Access Tier</h3>
            <div class="space-y-3">
                <label class="flex items-center gap-3 p-3 rounded-xl bg-[#0A211E] border border-outline-variant/30 cursor-pointer">
                    <input type="radio" asp-for="Access" value="Free" class="accent-primary" />
                    <div>
                        <span class="font-title-md text-on-surface block">Free Public</span>
                        <span class="text-label-sm text-on-surface-variant">Accessible by everyone</span>
                    </div>
                </label>
                <label class="flex items-center gap-3 p-3 rounded-xl bg-[#0A211E] border border-outline-variant/30 cursor-pointer">
                    <input type="radio" asp-for="Access" value="Premium" class="accent-primary" />
                    <div>
                        <span class="font-title-md text-primary block">Premium Archive</span>
                        <span class="text-label-sm text-on-surface-variant">Members only</span>
                    </div>
                </label>
            </div>
        </div>

        <!-- Image Upload Card -->
        <div class="p-space-lg rounded-xl bg-surface-container/75 backdrop-blur-md shadow-xl">
            <h3 class="font-title-md text-on-surface mb-3">Recipe Photography</h3>
            @if (!string.IsNullOrEmpty(Model.CurrentImagePath))
            {
                <div class="mb-4">
                    <img src="@Model.CurrentImagePath" alt="Current Image" class="w-full h-36 object-cover rounded-xl" />
                    <span class="text-xs text-[#7F9990] mt-1 block">Current Image</span>
                </div>
            }
            <div class="border-2 border-dashed border-outline-variant/40 hover:border-primary rounded-xl p-4 text-center cursor-pointer transition-all bg-[#0A211E]/40" onclick="document.getElementById('admin-recipe-img').click()">
                <input type="file" id="admin-recipe-img" asp-for="ImageFile" accept="image/*" class="hidden" onchange="previewAdminRecipeImg(this)" />
                <span class="material-symbols-outlined text-[32px] text-primary mb-1">add_photo_alternate</span>
                <p class="text-body-sm text-on-surface font-title">Select New Image</p>
                <p class="text-label-sm text-[#7F9990]">JPEG, PNG, WEBP</p>
                <div id="admin-preview-wrap" class="mt-3 hidden">
                    <img id="admin-preview-img" class="max-h-32 mx-auto rounded-lg object-cover" />
                </div>
            </div>
        </div>

        <!-- Publish Action Button -->
        <button type="submit" class="w-full py-4 rounded-full bg-primary hover:bg-[#E8A173] text-[#0A211E] font-bold text-title-md shadow-[0_4px_16px_rgba(217,138,86,0.25)] hover:shadow-[0_6px_24px_rgba(217,138,86,0.40)] transition-all cursor-pointer flex items-center justify-center gap-2">
            <span class="material-symbols-outlined">save</span>
            @(Model.Id > 0 ? "Save Changes" : "Publish to Archive")
        </button>
    </div>
</form>

<script>
    function previewAdminRecipeImg(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('admin-preview-img').src = e.target.result;
                document.getElementById('admin-preview-wrap').classList.remove('hidden');
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
