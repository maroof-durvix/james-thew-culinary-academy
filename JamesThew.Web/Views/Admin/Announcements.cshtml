@model IEnumerable<JamesThew.Web.Models.Entities.Announcement>
@{
    ViewData["Title"] = "Platform Announcements";
    Layout = "_AdminLayout";
}

@if (TempData["Success"] != null)
{
    <div class="mb-6 p-4 rounded-xl bg-[rgba(93,187,138,0.15)] border border-[rgba(93,187,138,0.3)] text-[#5DBB8A] flex items-center gap-3">
        <span class="material-symbols-outlined text-[20px]">check_circle</span>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-6 p-4 rounded-xl bg-error/15 border border-error/30 text-error flex items-center gap-3">
        <span class="material-symbols-outlined text-[20px]">error</span>
        <span>@TempData["Error"]</span>
    </div>
}

<div class="flex flex-col w-full text-on-surface pb-16">
    <!-- Top Header & Actions -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-space-md mb-space-margin">
        <div>
            <span class="text-label-sm font-label-sm uppercase tracking-wider text-primary">Kitchen Dispatch</span>
            <h1 class="text-headline-xl font-headline-xl text-on-surface mt-space-xs">Announcements &amp; Bulletins</h1>
            <p class="text-body-md text-on-surface-variant mt-space-xs max-w-2xl">Broadcast master-class updates, contest alerts, and winner laurels to the entire James Thew culinary community.</p>
        </div>
        <div class="flex items-center gap-space-sm self-start md:self-auto">
            <button class="inline-flex items-center gap-space-sm px-6 py-2.5 rounded-full bg-primary hover:bg-[#E8A173] text-[#0A211E] font-title-md shadow-lg transition-all cursor-pointer" onclick="toggleSlideOver(true)">
                <span class="material-symbols-outlined text-sm">add</span>
                <span>New Announcement</span>
            </button>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-space-gutter mb-space-margin">
        <div class="bg-surface-container-high/70 backdrop-blur-md p-space-lg rounded-xl flex items-center justify-between">
            <div>
                <span class="text-label-sm font-label-sm text-outline uppercase">Active Bulletins</span>
                <div class="text-headline-lg font-headline-lg text-on-surface mt-space-xs">@Model.Count()</div>
                <span class="text-body-sm text-secondary mt-space-xs inline-flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">campaign</span> Live to members
                </span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-primary-container/20 text-primary flex items-center justify-center">
                <span class="material-symbols-outlined text-2xl">campaign</span>
            </div>
        </div>
        <div class="bg-surface-container-high/70 backdrop-blur-md p-space-lg rounded-xl flex items-center justify-between">
            <div>
                <span class="text-label-sm font-label-sm text-outline uppercase">Winner Laurels</span>
                <div class="text-headline-lg font-headline-lg text-on-surface mt-space-xs">@Model.Count(a => a.Type == "Winner")</div>
                <span class="text-body-sm text-primary mt-space-xs inline-flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">trophy</span> Contest Accolades
                </span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-secondary/20 text-secondary flex items-center justify-center">
                <span class="material-symbols-outlined text-2xl">emoji_events</span>
            </div>
        </div>
        <div class="bg-surface-container-high/70 backdrop-blur-md p-space-lg rounded-xl flex items-center justify-between">
            <div>
                <span class="text-label-sm font-label-sm text-outline uppercase">Platform Updates</span>
                <div class="text-headline-lg font-headline-lg text-on-surface mt-space-xs">@Model.Count(a => a.Type != "Winner")</div>
                <span class="text-body-sm text-tertiary mt-space-xs inline-flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">info</span> General Bulletins
                </span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-error/10 text-primary flex items-center justify-center">
                <span class="material-symbols-outlined text-2xl">notifications</span>
            </div>
        </div>
    </div>

    <!-- Announcements Table Section -->
    <div class="bg-surface-container-high/70 backdrop-blur-md rounded-xl border border-outline-variant/10 shadow-xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-outline-variant/10 bg-[#184238]/30">
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Title &amp; Message</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Type</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Posted Date</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990] text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/10 text-body-md text-on-surface">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="py-8 text-center text-on-surface-variant">No platform announcements posted yet.</td>
                        </tr>
                    }
                    @foreach (var ann in Model)
                    {
                        <tr class="hover:bg-[rgba(24,66,56,0.5)] transition-colors">
                            <td class="py-4 px-6 max-w-lg">
                                <div class="font-headline text-title-lg text-[#F6EFE3]">@ann.Title</div>
                                <div class="text-body-sm text-on-surface-variant line-clamp-2">@ann.Message</div>
                            </td>
                            <td class="py-4 px-6">
                                <span class="px-2.5 py-1 rounded-full text-label-sm font-semibold @(ann.Type == "Winner" ? "bg-[#D98A56]/20 text-[#D98A56] border border-[#D98A56]/40" : "bg-primary-container/20 text-primary border border-primary/40")">
                                    @ann.Type
                                </span>
                            </td>
                            <td class="py-4 px-6 text-body-sm text-[#7F9990]">
                                @ann.PostedAt.ToString("MMM dd, yyyy")
                            </td>
                            <td class="py-4 px-6 text-right">
                                <form asp-action="DeleteAnnouncement" asp-route-id="@ann.Id" method="post" class="inline" onsubmit="return confirm('Delete this announcement?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="p-1.5 rounded-lg bg-[#184238] text-error hover:bg-error/20 transition-colors cursor-pointer" title="Delete Announcement">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Create SlideOver -->
    <div class="fixed inset-0 z-50 hidden" id="slideOverOverlay">
        <div class="fixed inset-0 bg-black/60 backdrop-blur-sm transition-opacity opacity-0" id="slideBackdrop" onclick="toggleSlideOver(false)"></div>
        <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
            <div class="w-screen max-w-lg bg-[#0A211E] border-l border-outline-variant/30 shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300" id="slideOverPanel">
                <div class="p-space-lg border-b border-outline-variant/20 flex items-center justify-between">
                    <div class="flex items-center gap-space-sm">
                        <span class="material-symbols-outlined text-primary text-xl">campaign</span>
                        <h2 class="text-headline-sm font-headline text-on-surface">New Announcement</h2>
                    </div>
                    <button type="button" class="p-2 text-on-surface-variant hover:text-on-surface rounded-lg hover:bg-surface-container transition-colors cursor-pointer" onclick="toggleSlideOver(false)">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

                <form asp-action="CreateAnnouncement" method="post" class="flex-1 flex flex-col justify-between overflow-y-auto">
                    @Html.AntiForgeryToken()
                    <div class="p-space-lg space-y-space-lg">
                        <div>
                            <label class="block text-label-md text-on-surface-variant mb-space-xs">Announcement Type</label>
                            <select name="type" class="w-full bg-[#001714] text-on-surface text-body-md rounded-xl p-3 border border-outline-variant/30 focus:border-primary focus:outline-none">
                                <option value="Update">Platform Update</option>
                                <option value="Winner">Winner Accolade</option>
                                <option value="New Contest">New Contest Alert</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-label-md text-on-surface-variant mb-space-xs">Title <span class="text-primary">*</span></label>
                            <input name="title" class="w-full bg-[#001714] text-on-surface text-body-md rounded-xl p-3 border border-outline-variant/30 focus:border-primary focus:outline-none" placeholder="e.g., Masterclass Special Edition Published..." required />
                        </div>
                        <div>
                            <label class="block text-label-md text-on-surface-variant mb-space-xs">Message <span class="text-primary">*</span></label>
                            <textarea name="message" rows="6" class="w-full bg-[#001714] text-on-surface text-body-md rounded-xl p-3 border border-outline-variant/30 focus:border-primary focus:outline-none" placeholder="Compose your culinary bulletin..." required></textarea>
                        </div>
                    </div>

                    <div class="p-space-lg border-t border-outline-variant/20 flex items-center justify-end gap-space-md bg-[#052420]">
                        <button type="button" class="px-space-md py-2.5 rounded-full text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer" onclick="toggleSlideOver(false)">Cancel</button>
                        <button type="submit" class="px-6 py-2.5 rounded-full bg-primary hover:bg-[#E8A173] text-[#0A211E] font-title-md shadow-lg transition-all cursor-pointer">
                            Publish Bulletin
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleSlideOver(show) {
        const overlay = document.getElementById('slideOverOverlay');
        const backdrop = document.getElementById('slideBackdrop');
        const panel = document.getElementById('slideOverPanel');
        if (show) {
            overlay.classList.remove('hidden');
            setTimeout(() => {
                backdrop.classList.add('opacity-100');
                panel.classList.remove('translate-x-full');
            }, 10);
        } else {
            backdrop.classList.remove('opacity-100');
            panel.classList.add('translate-x-full');
            setTimeout(() => {
                overlay.classList.add('hidden');
            }, 300);
        }
    }
</script>
