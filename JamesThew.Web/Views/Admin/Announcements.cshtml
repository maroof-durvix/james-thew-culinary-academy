@{
    ViewData["Title"] = "Announcements";
}

<div class="flex flex-col w-full text-on-surface">
<!-- Top Header & Actions -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-space-md mb-space-margin">
<div>
<span class="text-label-sm font-label-sm uppercase tracking-wider text-primary">Kitchen Dispatch</span>
<h1 class="text-headline-xl font-headline-xl text-on-surface mt-space-xs">Announcements & Bulletins</h1>
<p class="text-body-md text-on-surface-variant mt-space-xs max-w-2xl">Broadcast master-class updates, contest alerts, and winner laurels to the entire James Thew culinary community.</p>
</div>
<div class="flex items-center gap-space-sm self-start md:self-auto">
<button class="inline-flex items-center gap-space-sm px-space-lg py-3 rounded-full bg-primary-container text-on-primary-container font-title-lg text-title-lg shadow-lg hover:bg-primary transition-all duration-300" onclick="toggleSlideOver(true)">
<span class="material-symbols-outlined text-sm">add</span>
<span>New Announcement</span>
</button>
</div>
</div>
<!-- Stats Grid -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-space-gutter mb-space-margin">
<div class="bg-surface-container-high/70 backdrop-blur-md p-space-lg rounded-xl flex items-center justify-between">
<div>
<span class="text-label-sm font-label-sm text-outline uppercase">Active Bulletins</span>
<div class="text-headline-lg font-headline-lg text-on-surface mt-space-xs">12</div>
<span class="text-body-sm text-secondary mt-space-xs inline-flex items-center gap-1">
<span class="material-symbols-outlined text-sm">trending_up</span> +2 this week
        </span>
</div>
<div class="w-12 h-12 rounded-xl bg-primary-container/20 text-primary flex items-center justify-center">
<span class="material-symbols-outlined text-2xl">campaign</span>
</div>
</div>
<div class="bg-surface-container-high/70 backdrop-blur-md p-space-lg rounded-xl flex items-center justify-between">
<div>
<span class="text-label-sm font-label-sm text-outline uppercase">Total Reach</span>
<div class="text-headline-lg font-headline-lg text-on-surface mt-space-xs">48.2k</div>
<span class="text-body-sm text-secondary mt-space-xs inline-flex items-center gap-1">
<span class="material-symbols-outlined text-sm">group</span> Active subscribers
        </span>
</div>
<div class="w-12 h-12 rounded-xl bg-secondary/20 text-secondary flex items-center justify-center">
<span class="material-symbols-outlined text-2xl">visibility</span>
</div>
</div>
<div class="bg-surface-container-high/70 backdrop-blur-md p-space-lg rounded-xl flex items-center justify-between">
<div>
<span class="text-label-sm font-label-sm text-outline uppercase">Priority Broadcasts</span>
<div class="text-headline-lg font-headline-lg text-on-surface mt-space-xs">3</div>
<span class="text-body-sm text-primary-container mt-space-xs inline-flex items-center gap-1">
<span class="material-symbols-outlined text-sm">star</span> Pinned to top
        </span>
</div>
<div class="w-12 h-12 rounded-xl bg-error/10 text-error flex items-center justify-center">
<span class="material-symbols-outlined text-2xl">bolt</span>
</div>
</div>
</div>
<!-- Announcements Table Section -->
<div class="bg-surface-container-low/80 backdrop-blur-xl rounded-2xl overflow-hidden shadow-2xl">
<div class="p-space-lg flex flex-col sm:flex-row items-center justify-between gap-space-md">
<div class="flex items-center gap-space-md w-full sm:w-auto">
<div class="relative flex-1 sm:w-72">
<span class="material-symbols-outlined absolute left-3 top-2.5 text-on-surface-variant text-sm">search</span>
<input class="bg-surface-container text-on-surface text-body-sm rounded-full pl-9 pr-4 py-2 w-full focus:outline-none focus:ring-1 focus:ring-primary" placeholder="Filter announcements..." type="text"/>
</div>
<select class="bg-surface-container text-on-surface text-body-sm rounded-full px-4 py-2 focus:outline-none focus:ring-1 focus:ring-primary">
<option>All Types</option>
<option>Winner</option>
<option>Update</option>
<option>New Contest</option>
</select>
</div>
<div class="text-body-sm text-on-surface-variant self-end sm:self-auto">
        Showing <span class="text-primary font-medium">4</span> of <span class="text-on-surface">12</span> entries
      </div>
</div>
<div class="overflow-x-auto">
<table class="w-full text-left border-collapse">
<thead>
<tr class="text-label-sm uppercase tracking-wider text-outline bg-surface-container/50">
<th class="py-space-md px-space-lg font-medium">Type</th>
<th class="py-space-md px-space-lg font-medium">Title & Excerpt</th>
<th class="py-space-md px-space-lg font-medium">Publish Date</th>
<th class="py-space-md px-space-lg font-medium text-right">Actions</th>
</tr>
</thead>
<tbody class="divide-y divide-outline-variant/10 text-body-md">
<!-- Row 1 -->
<tr class="hover:bg-surface-container-high/40 transition-colors group">
<td class="py-space-md px-space-lg align-top">
<span class="inline-flex items-center px-3 py-1 rounded-full text-label-sm font-label-md bg-[#d98a56]/20 text-[#d98a56] border border-[#d98a56]/40">
<span class="material-symbols-outlined text-xs mr-1">trophy</span>Winner
              </span>
</td>
<td class="py-space-md px-space-lg">
<div class="font-title-lg text-title-lg text-on-surface group-hover:text-primary transition-colors">Autumn Truffle Masterclass Winners Announced</div>
<p class="text-body-sm text-on-surface-variant line-clamp-1 mt-1">Congratulations to Chef Elena Vance and Marcus Brody for their sublime execution of the reduction...</p>
</td>
<td class="py-space-md px-space-lg align-top text-body-sm text-on-surface-variant whitespace-nowrap">
              Oct 24, 2023
            </td>
<td class="py-space-md px-space-lg align-top text-right whitespace-nowrap">
<button class="p-2 text-on-surface-variant hover:text-primary transition-colors" onclick="editAnnouncement('Autumn Truffle Masterclass Winners Announced', 'Winner', 'Congratulations to Chef Elena Vance and Marcus Brody for their sublime execution of the reduction...')" title="Edit">
<span class="material-symbols-outlined text-sm">edit</span>
</button>
<button class="p-2 text-on-surface-variant hover:text-error transition-colors ml-1" onclick="deleteRow(this)" title="Delete">
<span class="material-symbols-outlined text-sm">delete</span>
</button>
</td>
</tr>
<!-- Row 2 -->
<tr class="hover:bg-surface-container-high/40 transition-colors group">
<td class="py-space-md px-space-lg align-top">
<span class="inline-flex items-center px-3 py-1 rounded-full text-label-sm font-label-md bg-secondary/20 text-secondary border border-secondary/40">
<span class="material-symbols-outlined text-xs mr-1">bolt</span>New Contest
              </span>
</td>
<td class="py-space-md px-space-lg">
<div class="font-title-lg text-title-lg text-on-surface group-hover:text-primary transition-colors">The 2024 Winter Patisserie Open</div>
<p class="text-body-sm text-on-surface-variant line-clamp-1 mt-1">Submit your most avant-garde chocolate soufflé or layered entremet for a chance to win the Master Knife set...</p>
</td>
<td class="py-space-md px-space-lg align-top text-body-sm text-on-surface-variant whitespace-nowrap">
              Nov 02, 2023
            </td>
<td class="py-space-md px-space-lg align-top text-right whitespace-nowrap">
<button class="p-2 text-on-surface-variant hover:text-primary transition-colors" onclick="editAnnouncement('The 2024 Winter Patisserie Open', 'New Contest', 'Submit your most avant-garde chocolate soufflé or layered entremet for a chance to win the Master Knife set...')" title="Edit">
<span class="material-symbols-outlined text-sm">edit</span>
</button>
<button class="p-2 text-on-surface-variant hover:text-error transition-colors ml-1" onclick="deleteRow(this)" title="Delete">
<span class="material-symbols-outlined text-sm">delete</span>
</button>
</td>
</tr>
<!-- Row 3 -->
<tr class="hover:bg-surface-container-high/40 transition-colors group">
<td class="py-space-md px-space-lg align-top">
<span class="inline-flex items-center px-3 py-1 rounded-full text-label-sm font-label-md bg-tertiary/20 text-tertiary border border-tertiary/40">
<span class="material-symbols-outlined text-xs mr-1">update</span>Update
              </span>
</td>
<td class="py-space-md px-space-lg">
<div class="font-title-lg text-title-lg text-on-surface group-hover:text-primary transition-colors">Pantry Inventory & Sourcing Guidelines Update</div>
<p class="text-body-sm text-on-surface-variant line-clamp-1 mt-1">We have refreshed our organic herb supplier list. Please check the resources tab for the latest certified local farms...</p>
</td>
<td class="py-space-md px-space-lg align-top text-body-sm text-on-surface-variant whitespace-nowrap">
              Nov 14, 2023
            </td>
<td class="py-space-md px-space-lg align-top text-right whitespace-nowrap">
<button class="p-2 text-on-surface-variant hover:text-primary transition-colors" onclick="editAnnouncement('Pantry Inventory & Sourcing Guidelines Update', 'Update', 'We have refreshed our organic herb supplier list. Please check the resources tab for the latest certified local farms...')" title="Edit">
<span class="material-symbols-outlined text-sm">edit</span>
</button>
<button class="p-2 text-on-surface-variant hover:text-error transition-colors ml-1" onclick="deleteRow(this)" title="Delete">
<span class="material-symbols-outlined text-sm">delete</span>
</button>
</td>
</tr>
<!-- Row 4 -->
<tr class="hover:bg-surface-container-high/40 transition-colors group">
<td class="py-space-md px-space-lg align-top">
<span class="inline-flex items-center px-3 py-1 rounded-full text-label-sm font-label-md bg-tertiary/20 text-tertiary border border-tertiary/40">
<span class="material-symbols-outlined text-xs mr-1">update</span>Update
              </span>
</td>
<td class="py-space-md px-space-lg">
<div class="font-title-lg text-title-lg text-on-surface group-hover:text-primary transition-colors">Masterclass Schedule Revision for December</div>
<p class="text-body-sm text-on-surface-variant line-clamp-1 mt-1">Live streaming times for the holiday roast session have been adjusted by 30 minutes to accommodate global attendees...</p>
</td>
<td class="py-space-md px-space-lg align-top text-body-sm text-on-surface-variant whitespace-nowrap">
              Nov 20, 2023
            </td>
<td class="py-space-md px-space-lg align-top text-right whitespace-nowrap">
<button class="p-2 text-on-surface-variant hover:text-primary transition-colors" onclick="editAnnouncement('Masterclass Schedule Revision for December', 'Update', 'Live streaming times for the holiday roast session have been adjusted by 30 minutes to accommodate global attendees...')" title="Edit">
<span class="material-symbols-outlined text-sm">edit</span>
</button>
<button class="p-2 text-on-surface-variant hover:text-error transition-colors ml-1" onclick="deleteRow(this)" title="Delete">
<span class="material-symbols-outlined text-sm">delete</span>
</button>
</td>
</tr>
</tbody>
</table>
</div>
<!-- Pagination footer -->
<div class="p-space-md px-space-lg flex items-center justify-between border-t border-outline-variant/10 bg-surface-container/30">
<div class="text-body-sm text-on-surface-variant">Page 1 of 3</div>
<div class="flex items-center gap-space-sm">
<button class="px-3 py-1.5 rounded-lg bg-surface-container text-on-surface-variant hover:text-on-surface disabled:opacity-50" disabled="">Previous</button>
<button class="px-3 py-1.5 rounded-lg bg-primary-container text-on-primary-container font-medium">1</button>
<button class="px-3 py-1.5 rounded-lg bg-surface-container text-on-surface-variant hover:text-on-surface">2</button>
<button class="px-3 py-1.5 rounded-lg bg-surface-container text-on-surface-variant hover:text-on-surface">3</button>
<button class="px-3 py-1.5 rounded-lg bg-surface-container text-on-surface-variant hover:text-on-surface">Next</button>
</div>
</div>
</div>
<!-- Slide-Over Drawer backdrop & container -->
<div class="fixed inset-0 bg-surface-container-lowest/80 backdrop-blur-sm z-50 hidden transition-opacity opacity-0" id="slideOverOverlay" onclick="toggleSlideOver(false)"></div>
<div class="fixed top-0 right-0 h-full w-full max-w-lg bg-[#0A211E] border-l border-outline-variant/20 z-50 transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col shadow-2xl" id="slideOverPanel">
<!-- Header -->
<div class="p-space-lg border-b border-outline-variant/20 flex items-center justify-between">
<div class="flex items-center gap-space-sm">
<div class="w-8 h-8 rounded-lg bg-primary-container/20 text-primary flex items-center justify-center">
<span class="material-symbols-outlined text-lg">campaign</span>
</div>
<h2 class="text-headline-sm font-headline-sm text-on-surface" id="slideOverTitle">New Announcement</h2>
</div>
<button class="p-2 text-on-surface-variant hover:text-on-surface rounded-lg hover:bg-surface-container transition-colors" onclick="toggleSlideOver(false)">
<span class="material-symbols-outlined">close</span>
</button>
</div>
<!-- Form Body -->
<div class="flex-1 overflow-y-auto p-space-lg space-y-space-lg">
<div>
<label class="block text-label-md font-label-md text-on-surface-variant mb-space-xs">Announcement Type</label>
<select class="w-full bg-surface-container text-on-surface rounded-xl p-3 border border-outline-variant/30 focus:border-primary focus:outline-none" id="announcementType">
<option value="Winner">Winner Announcement</option>
<option value="Update">Kitchen Update</option>
<option value="New Contest">New Contest Alert</option>
</select>
</div>
<div>
<label class="block text-label-md font-label-md text-on-surface-variant mb-space-xs">Title</label>
<input class="w-full bg-surface-container text-on-surface rounded-xl p-3 border border-outline-variant/30 focus:border-primary focus:outline-none" id="announcementTitleInput" placeholder="e.g., Masterclass Special Edition..." type="text"/>
</div>
<div>
<label class="block text-label-md font-label-md text-on-surface-variant mb-space-xs">Message</label>
<textarea class="w-full bg-surface-container text-on-surface rounded-xl p-3 border border-outline-variant/30 focus:border-primary focus:outline-none" id="announcementMessageInput" placeholder="Compose your culinary bulletin..." rows="6"></textarea>
</div>
<div class="bg-surface-container/40 p-space-md rounded-xl border border-outline-variant/10">
<div class="flex items-center justify-between">
<div>
<span class="text-title-md font-title-md text-on-surface block">Pin to Top</span>
<span class="text-body-sm text-on-surface-variant">Display at the head of member feeds</span>
</div>
<input class="w-5 h-5 accent-primary rounded cursor-pointer" type="checkbox"/>
</div>
</div>
</div>
<!-- Footer Actions -->
<div class="p-space-lg border-t border-outline-variant/20 flex items-center justify-end gap-space-md bg-surface-container-lowest">
<button class="px-space-md py-2.5 rounded-full text-on-surface-variant hover:text-on-surface transition-colors" onclick="toggleSlideOver(false)">Cancel</button>
<button class="px-space-lg py-2.5 rounded-full bg-primary-container text-on-primary-container font-title-lg text-title-lg shadow-lg hover:bg-primary transition-all duration-300" onclick="publishAnnouncement()">
        Publish
      </button>
</div>
</div>
<script>
    function toggleSlideOver(show) {
      const overlay = document.getElementById('slideOverOverlay');
      const panel = document.getElementById('slideOverPanel');
      if (show) {
        document.getElementById('slideOverTitle').innerText = 'New Announcement';
        document.getElementById('announcementTitleInput').value = '';
        document.getElementById('announcementMessageInput').value = '';
        overlay.classList.remove('hidden');
        setTimeout(() => {
          overlay.classList.remove('opacity-0');
          panel.classList.remove('translate-x-full');
        }, 10);
      } else {
        overlay.classList.add('opacity-0');
        panel.classList.add('translate-x-full');
        setTimeout(() => {
          overlay.classList.add('hidden');
        }, 300);
      }
    }

    function editAnnouncement(title, type, message) {
      document.getElementById('slideOverTitle').innerText = 'Edit Announcement';
      document.getElementById('announcementTitleInput').value = title;
      document.getElementById('announcementMessageInput').value = message;
      document.getElementById('announcementType').value = type;
      
      const overlay = document.getElementById('slideOverOverlay');
      const panel = document.getElementById('slideOverPanel');
      overlay.classList.remove('hidden');
      setTimeout(() => {
        overlay.classList.remove('opacity-0');
        panel.classList.remove('translate-x-full');
      }, 10);
    }

    function publishAnnouncement() {
      toggleSlideOver(false);
      // Simulate success toast or refresh
      alert('Announcement published successfully.');
    }

    function deleteRow(btn) {
      if (confirm('Are you sure you want to delete this announcement?')) {
        const row = btn.closest('tr');
        row.style.opacity = '0';
        setTimeout(() => row.remove(), 300);
      }
    }
  </script>
</div>
