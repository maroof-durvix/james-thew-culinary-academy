<span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">check_circle</span>
<div>
<p class="text-title-md font-headline">Winner Announcement Published!</p>
<p class="text-body-sm text-on-surface-variant">Notifications have been dispatched to all members.</p>
</div>
</div>
<script>
    function togglePreview(btn) {
      const card = btn.closest('.bg-\\[\\#12362F\\]');
      let fullContent = card.querySelector('.full-content');
      if (!fullContent) {
        fullContent = document.createElement('div');
        fullContent.className = 'full-content mt-space-md pt-space-md border-t border-[#F6EFE3]/10 text-body-sm text-on-surface space-y-2 animate-fadeIn';
        fullContent.innerHTML = '<p class="font-medium text-primary">Complete Entry Details:</p><p>1. Prepare all mise en place carefully ensuring exact thermal thresholds.<br>2. Whisk gently without incorporating air.<br>3. Strain twice through a fine mesh.</p>';
        card.querySelector('.bg-surface-container-low').after(fullContent);
        btn.querySelector('span:first-child').textContent = 'Hide Full Entry';
      } else {
        fullContent.remove();
        btn.querySelector('span:first-child').textContent = 'View Full Entry';
      }
    }

    function publishAnnouncement() {
      const toast = document.getElementById('toast');
      toast.classList.remove('translate-y-24', 'opacity-0');
      setTimeout(() => {
        toast.classList.add('translate-y-24', 'opacity-0');
      }, 4000);
    }
  </script>
