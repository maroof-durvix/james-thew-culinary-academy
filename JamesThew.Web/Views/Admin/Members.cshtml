@{
    ViewData["Title"] = "Manage Members";
}

<div class="flex flex-col w-full space-y-space-xl">
<!-- Top Stats Row (KPI Cards) -->
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-space-lg">
<!-- Card 1: Total Members -->
<div class="p-space-lg rounded-xl bg-[#12362F]/75 backdrop-blur-md shadow-lg relative overflow-hidden flex flex-col justify-between">
<div class="absolute -right-6 -bottom-6 w-24 h-24 bg-primary/10 rounded-full blur-xl pointer-events-none"></div>
<div class="flex items-center justify-between mb-space-md">
<span class="text-label-sm text-on-surface-variant uppercase tracking-wider font-medium">Total Members</span>
<div class="w-10 h-10 rounded-full bg-primary/15 flex items-center justify-center text-primary">
<span class="material-symbols-outlined">group</span>
</div>
</div>
<div class="flex items-baseline gap-space-sm">
<span class="font-headline text-headline-xl text-on-surface">2,845</span>
<span class="text-label-sm text-[#5DBB8A] flex items-center"><span class="material-symbols-outlined text-sm mr-0.5">trending_up</span>+12.4%</span>
</div>
<span class="text-body-sm text-on-surface-variant mt-space-xs">Active community accounts</span>
</div>
<!-- Card 2: Monthly Plan -->
<div class="p-space-lg rounded-xl bg-[#12362F]/75 backdrop-blur-md shadow-lg relative overflow-hidden flex flex-col justify-between">
<div class="absolute -right-6 -bottom-6 w-24 h-24 bg-secondary/10 rounded-full blur-xl pointer-events-none"></div>
<div class="flex items-center justify-between mb-space-md">
<span class="text-label-sm text-on-surface-variant uppercase tracking-wider font-medium">Monthly Plan</span>
<div class="w-10 h-10 rounded-full bg-secondary/15 flex items-center justify-center text-secondary">
<span class="material-symbols-outlined">autorenew</span>
</div>
</div>
<div class="flex items-baseline gap-space-sm">
<span class="font-headline text-headline-xl text-on-surface">1,420</span>
<span class="text-label-sm text-[#5DBB8A] flex items-center"><span class="material-symbols-outlined text-sm mr-0.5">trending_up</span>+5.1%</span>
</div>
<span class="text-body-sm text-on-surface-variant mt-space-xs">Standard recurring tier</span>
</div>
<!-- Card 3: Yearly Plan -->
<div class="p-space-lg rounded-xl bg-[#12362F]/75 backdrop-blur-md shadow-lg relative overflow-hidden flex flex-col justify-between">
<div class="absolute -right-6 -bottom-6 w-24 h-24 bg-primary-container/10 rounded-full blur-xl pointer-events-none"></div>
<div class="flex items-center justify-between mb-space-md">
<span class="text-label-sm text-on-surface-variant uppercase tracking-wider font-medium">Yearly Plan</span>
<div class="w-10 h-10 rounded-full bg-primary-container/25 flex items-center justify-center text-primary">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
</div>
</div>
<div class="flex items-baseline gap-space-sm">
<span class="font-headline text-headline-xl text-on-surface">1,105</span>
<span class="text-label-sm text-[#5DBB8A] flex items-center"><span class="material-symbols-outlined text-sm mr-0.5">trending_up</span>+18.2%</span>
</div>
<span class="text-body-sm text-on-surface-variant mt-space-xs">VIP executive subscribers</span>
</div>
<!-- Card 4: Expiring Soon -->
<div class="p-space-lg rounded-xl bg-[#12362F]/75 backdrop-blur-md shadow-lg relative overflow-hidden flex flex-col justify-between">
<div class="absolute -right-6 -bottom-6 w-24 h-24 bg-error/10 rounded-full blur-xl pointer-events-none"></div>
<div class="flex items-center justify-between mb-space-md">
<span class="text-label-sm text-on-surface-variant uppercase tracking-wider font-medium">Expiring Soon</span>
<div class="w-10 h-10 rounded-full bg-error/15 flex items-center justify-center text-error">
<span class="material-symbols-outlined">timer</span>
</div>
</div>
<div class="flex items-baseline gap-space-sm">
<span class="font-headline text-headline-xl text-on-surface">320</span>
<span class="text-label-sm text-error flex items-center"><span class="material-symbols-outlined text-sm mr-0.5">warning</span>Action req.</span>
</div>
<span class="text-body-sm text-on-surface-variant mt-space-xs">Within next 7 days</span>
</div>
</div>
<!-- Main Content Panel / Table Section -->
