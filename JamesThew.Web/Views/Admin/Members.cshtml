<div class="relative flex-1 max-w-md">
<span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-base">search</span>
<input class="w-full bg-[#0A211E] text-on-surface text-body-sm rounded-xl pl-10 pr-space-md py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/40 placeholder:text-on-surface-variant/60 transition-all" placeholder="Search members by name, email, or phone..." type="text"/>
</div>
<!-- Plan Filter Chips & Batch Actions -->
<div class="flex flex-wrap items-center gap-space-sm">
<button class="px-space-md py-1.5 rounded-full text-label-md bg-[#D98A56]/15 text-primary border border-primary/40 font-semibold transition-all">All Members</button>
<button class="px-space-md py-1.5 rounded-full text-label-md bg-[#184238] text-on-surface-variant hover:text-on-surface hover:bg-[#184238]/80 transition-all">Monthly</button>
<button class="px-space-md py-1.5 rounded-full text-label-md bg-[#184238] text-on-surface-variant hover:text-on-surface hover:bg-[#184238]/80 transition-all">Yearly</button>
<button class="px-space-md py-1.5 rounded-full text-label-md bg-[#184238] text-on-surface-variant hover:text-on-surface hover:bg-[#184238]/80 transition-all">Expired</button>
<div class="h-6 w-px bg-outline-variant/30 mx-1 hidden sm:block"></div>
<button class="flex items-center gap-space-xs px-space-md py-1.5 rounded-full text-label-md bg-[#184238] text-on-surface hover:bg-primary hover:text-on-primary transition-all">
<span class="material-symbols-outlined text-sm">download</span>
