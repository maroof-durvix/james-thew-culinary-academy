@{
    ViewData["Title"] = "Feedback";
}

<div class="flex flex-col w-full text-on-surface">
<!-- Top Summary Cards -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-space-md mb-space-xl">
<div class="bg-surface-container/75 backdrop-blur-xl p-space-lg rounded-xl shadow-xl flex items-center justify-between">
<div>
<p class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider mb-space-xs">Average Rating</p>
<div class="flex items-baseline gap-space-sm">
<span class="text-display-lg font-display-lg text-primary">4.8</span>
<span class="text-body-sm text-secondary">/ 5.0</span>
</div>
</div>
<div class="w-12 h-12 rounded-full bg-primary-container/20 flex items-center justify-center text-primary">
<span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'FILL' 1;">star</span>
</div>
</div>
<div class="bg-surface-container/75 backdrop-blur-xl p-space-lg rounded-xl shadow-xl flex items-center justify-between">
<div>
<p class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider mb-space-xs">Total Feedback</p>
<span class="text-display-lg font-display-lg text-on-surface">1,284</span>
</div>
<div class="w-12 h-12 rounded-full bg-secondary-container/30 flex items-center justify-center text-secondary">
<span class="material-symbols-outlined text-2xl">forum</span>
</div>
</div>
<div class="bg-surface-container/75 backdrop-blur-xl p-space-lg rounded-xl shadow-xl flex items-center justify-between">
<div>
<p class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider mb-space-xs">Positive Sentiment</p>
<span class="text-display-lg font-display-lg text-secondary">94%</span>
</div>
<div class="w-12 h-12 rounded-full bg-surface-bright flex items-center justify-center text-primary">
<span class="material-symbols-outlined text-2xl">trending_up</span>
</div>
</div>
</div>
<!-- Tabs & Filters Bar -->
<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md mb-space-lg">
<!-- Tabs -->
<div class="flex items-center bg-surface-container-low p-1 rounded-full w-fit">
<button class="px-space-md py-2 rounded-full text-title-md transition-all bg-primary-container text-on-primary-container shadow-sm" id="tab-recipe" onclick="switchTab('recipe')">
        Recipe Feedback
      </button>
<button class="px-space-md py-2 rounded-full text-title-md transition-all text-on-surface-variant hover:text-on-surface" id="tab-site" onclick="switchTab('site')">
        Site Feedback
      </button>
</div>
<!-- Filters & Search -->
<div class="flex flex-wrap items-center gap-space-sm">
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-3 text-on-surface-variant text-sm">search</span>
<input class="bg-surface-container text-on-surface text-body-sm rounded-full pl-9 pr-4 py-2 border border-outline-variant/30 focus:border-primary focus:outline-none w-64" placeholder="Search feedback..." type="text"/>
</div>
<select class="bg-surface-container text-on-surface text-body-sm rounded-full px-4 py-2 border border-outline-variant/30 focus:border-primary focus:outline-none">
<option>All Ratings</option>
<option>5 Stars</option>
<option>4 Stars</option>
<option>3 Stars & Below</option>
</select>
<select class="bg-surface-container text-on-surface text-body-sm rounded-full px-4 py-2 border border-outline-variant/30 focus:border-primary focus:outline-none">
<option>Latest First</option>
<option>Oldest First</option>
</select>
</div>
</div>
<!-- Table Container -->
<div class="bg-surface-container/75 backdrop-blur-xl rounded-xl shadow-xl overflow-hidden">
<div class="overflow-x-auto">
<table class="w-full text-left border-collapse">
<thead>
<tr class="border-b border-outline-variant/10 text-label-sm text-on-surface-variant">
<th class="py-4 px-space-md font-label-sm">User</th>
<th class="py-4 px-space-md font-label-sm" id="target-header">Recipe Name</th>
<th class="py-4 px-space-md font-label-sm">Rating</th>
<th class="py-4 px-space-md font-label-sm">Comment Excerpt</th>
<th class="py-4 px-space-md font-label-sm">Date</th>
<th class="py-4 px-space-md font-label-sm text-right">Actions</th>
</tr>
</thead>
<tbody class="divide-y divide-outline-variant/10 text-body-md" id="feedback-tbody">
<!-- Populated by inline JS for demo tabs -->
</tbody>
</table>
</div>
<!-- Pagination -->
<div class="flex items-center justify-between px-space-md py-4 border-t border-outline-variant/10 text-body-sm text-on-surface-variant">
<span>Showing 1-5 of 1,284 entries</span>
<div class="flex items-center gap-space-sm">
<button class="px-3 py-1 rounded-lg bg-surface-container-high text-on-surface hover:bg-surface-bright transition-colors">Previous</button>
<button class="px-3 py-1 rounded-lg bg-primary-container text-on-primary-container font-bold">1</button>
<button class="px-3 py-1 rounded-lg bg-surface-container-high text-on-surface hover:bg-surface-bright transition-colors">2</button>
<button class="px-3 py-1 rounded-lg bg-surface-container-high text-on-surface hover:bg-surface-bright transition-colors">3</button>
<button class="px-3 py-1 rounded-lg bg-surface-container-high text-on-surface hover:bg-surface-bright transition-colors">Next</button>
</div>
</div>
</div>
<!-- View Modal (Hidden by Default) -->
<div class="fixed inset-0 bg-surface/80 backdrop-blur-md z-50 flex items-center justify-center hidden" id="feedback-modal">
<div class="bg-surface-container border border-outline-variant/30 rounded-xl p-space-xl max-w-lg w-full shadow-2xl relative">
<button class="absolute top-4 right-4 text-on-surface-variant hover:text-on-surface" onclick="closeModal()">
<span class="material-symbols-outlined">close</span>
</button>
<h3 class="text-headline-sm font-headline mb-space-md text-on-surface">Feedback Details</h3>
<div class="space-y-space-md text-body-md">
<div>
<span class="text-label-sm text-on-surface-variant block uppercase">User</span>
<p class="text-on-surface font-medium" id="modal-user">Chef Eleanor Vance (eleanor@example.com)</p>
</div>
<div>
<span class="text-label-sm text-on-surface-variant block uppercase" id="modal-target-label">Recipe</span>
<p class="text-primary font-medium" id="modal-target">Truffle Infused Risotto</p>
</div>
<div>
<span class="text-label-sm text-on-surface-variant block uppercase">Rating</span>
<div class="flex items-center gap-1 text-primary mt-1" id="modal-stars">
<span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
</div>
</div>
<div>
<span class="text-label-sm text-on-surface-variant block uppercase">Full Comment</span>
<p class="text-on-surface bg-surface p-space-md rounded-lg mt-1 italic" id="modal-comment">"The balance of the truffle oil with the Carnaroli rice was masterclass. I followed Chef James's tip on continuous stock addition and it turned out velvety smooth."</p>
</div>
<div>
<span class="text-label-sm text-on-surface-variant block uppercase">Date Submitted</span>
<p class="text-on-surface-variant text-body-sm" id="modal-date">October 24, 2023 • 14:32 EST</p>
</div>
</div>
<div class="mt-space-lg flex justify-end gap-space-sm">
<button class="px-space-md py-2 rounded-full border border-outline-variant/40 text-on-surface hover:bg-surface-bright transition-colors" onclick="closeModal()">Close</button>
<button class="px-space-md py-2 rounded-full bg-error text-on-error font-bold hover:opacity-90 transition-opacity" onclick="alert('Feedback deleted successfully'); closeModal();">Delete Feedback</button>
</div>
</div>
</div>
<script>
    const recipeData = [
      { name: "Eleanor Vance", email: "eleanor@example.com", target: "Truffle Infused Risotto", rating: 5, excerpt: "The balance of the truffle oil with the Carnaroli rice was masterclass...", date: "Oct 24, 2023" },
      { name: "Marcus Brody", email: "marcus@culinary.org", target: "Pan-Seared Duck Breast", rating: 4, excerpt: "Crispy skin achieved perfectly, though reduction needed slightly less salt...", date: "Oct 22, 2023" },
      { name: "Sophia Loren", email: "s.loren@mail.it", target: "Handmade Tagliatelle", rating: 5, excerpt: "Absolute perfection! Reminded me of my nonna's Sunday kitchen.", date: "Oct 20, 2023" },
      { name: "David Chang", email: "dchang@foodie.com", target: "Smoked Miso Glaze", rating: 3, excerpt: "Good depth of flavor, but a bit too intense for lighter seafood pairings.", date: "Oct 19, 2023" },
      { name: "Clara Oswald", email: "clara@tardis.net", target: "Saffron Panna Cotta", rating: 5, excerpt: "Silky texture and wonderful aroma. A stunning dessert presentation.", date: "Oct 18, 2023" }
    ];

    const siteData = [
      { name: "Julian Baker", email: "julian@baker.co", target: "Navigation & UI", rating: 5, excerpt: "The emerald dark theme is breathtaking. So easy on the eyes during late night planning.", date: "Oct 25, 2023" },
      { name: "Aria Stark", email: "aria@winter.com", target: "Mobile App Performance", rating: 4, excerpt: "Loads extremely fast on tablet devices. Love the smooth page transitions.", date: "Oct 23, 2023" },
      { name: "Liam Neeson", email: "liam@action.net", target: "Recipe Search", rating: 3, excerpt: "Filters are good, but would love an ingredient exclusion toggle.", date: "Oct 21, 2023" },
      { name: "Zoe Saldana", email: "zoe@galaxy.space", target: "Video Masterclasses", rating: 5, excerpt: "The multi-angle camera views in the masterclass section are phenomenal.", date: "Oct 19, 2023" },
      { name: "Oliver Queen", email: "oliver@starling.org", target: "Membership Perks", rating: 5, excerpt: "Exclusive chef Q&A sessions are worth every single penny.", date: "Oct 17, 2023" }
    ];

    function renderTable(data, type) {
      const tbody = document.getElementById('feedback-tbody');
      tbody.innerHTML = '';
      data.forEach((item, idx) => {
        let starsHtml = '';
        for(let i=0; i<5; i++) {
          starsHtml += `<span class="material-symbols-outlined text-xs ${i < item.rating ? 'text-primary' : 'text-outline-variant'}" style="font-variation-settings: 'FILL' ${i < item.rating ? 1 : 0};">star</span>`;
        }
        
        const row = document.createElement('tr');
        row.className = 'hover:bg-surface-container-high/50 transition-colors';
        row.innerHTML = `
          <td class="py-4 px-space-md">
            <div class="font-medium text-on-surface">${item.name}</div>
            <div class="text-body-sm text-on-surface-variant">${item.email}</div>
          </td>
          <td class="py-4 px-space-md text-on-surface">${item.target}</td>
          <td class="py-4 px-space-md">
            <div class="flex items-center gap-1">${starsHtml}</div>
          </td>
          <td class="py-4 px-space-md text-on-surface-variant max-w-xs truncate">${item.excerpt}</td>
          <td class="py-4 px-space-md text-on-surface-variant text-body-sm">${item.date}</td>
          <td class="py-4 px-space-md text-right">
            <div class="flex items-center justify-end gap-space-sm">
              <button onclick="openModal('${item.name}', '${item.email}', '${item.target}', ${item.rating}, '${item.excerpt}', '${item.date}', '${type}')" class="p-1.5 rounded-lg hover:bg-surface-bright text-on-surface-variant hover:text-primary transition-colors" title="View">
                <span class="material-symbols-outlined text-sm">visibility</span>
              </button>
              <button onclick="alert('Deleted feedback item')" class="p-1.5 rounded-lg hover:bg-error-container/20 text-on-surface-variant hover:text-error transition-colors" title="Delete">
                <span class="material-symbols-outlined text-sm">delete</span>
              </button>
            </div>
          </td>
        `;
        tbody.appendChild(row);
      });
    }

    function switchTab(tab) {
      const recipeBtn = document.getElementById('tab-recipe');
      const siteBtn = document.getElementById('tab-site');
      const targetHeader = document.getElementById('target-header');

      if (tab === 'recipe') {
        recipeBtn.className = "px-space-md py-2 rounded-full text-title-md transition-all bg-primary-container text-on-primary-container shadow-sm";
        siteBtn.className = "px-space-md py-2 rounded-full text-title-md transition-all text-on-surface-variant hover:text-on-surface";
        targetHeader.innerText = "Recipe Name";
        renderTable(recipeData, 'recipe');
      } else {
        siteBtn.className = "px-space-md py-2 rounded-full text-title-md transition-all bg-primary-container text-on-primary-container shadow-sm";
        recipeBtn.className = "px-space-md py-2 rounded-full text-title-md transition-all text-on-surface-variant hover:text-on-surface";
        targetHeader.innerText = "Category / Area";
        renderTable(siteData, 'site');
      }
    }

    function openModal(name, email, target, rating, comment, date, type) {
      document.getElementById('modal-user').innerText = `${name} (${email})`;
      document.getElementById('modal-target-label').innerText = type === 'recipe' ? 'Recipe Name' : 'Category / Area';
      document.getElementById('modal-target').innerText = target;
      document.getElementById('modal-comment').innerText = `"${comment}"`;
      document.getElementById('modal-date').innerText = date;
      
      let starsHtml = '';
      for(let i=0; i<5; i++) {
        starsHtml += `<span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' ${i < rating ? 1 : 0};">star</span>`;
      }
      document.getElementById('modal-stars').innerHTML = starsHtml;

      document.getElementById('feedback-modal').classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('feedback-modal').classList.add('hidden');
    }

    // Initial load
    renderTable(recipeData, 'recipe');
  </script>
</div>
