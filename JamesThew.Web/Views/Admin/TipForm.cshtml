@model JamesThew.Web.Models.ViewModels.AdminTipFormViewModel
@{
    ViewData["Title"] = Model.Id > 0 ? "Edit Culinary Tip" : "Publish Master Tip";
    Layout = "_AdminLayout";
}

<div class="flex flex-col w-full max-w-5xl mx-auto space-y-space-xl pb-space-xl">
    <!-- Top Bar / Header context -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md">
        <div class="space-y-space-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 text-label-sm font-label-sm uppercase bg-primary-container/20 text-primary rounded-full">Culinary Knowledge</span>
                <span class="text-on-surface-variant font-body-sm">•</span>
                <span class="text-on-surface-variant font-body-sm">Admin Publishing Suite</span>
            </div>
            <h1 class="font-headline-xl text-on-surface">@(Model.Id > 0 ? "Edit Culinary Tip" : "Craft Master Tip")</h1>
            <p class="font-body-md text-on-surface-variant max-w-xl">Share kitchen wisdom, techniques, and secret curation notes with the James Thew community.</p>
        </div>
        <div class="flex items-center gap-space-md">
            <a asp-action="Tips" class="px-space-md py-space-sm rounded-full font-label-md text-on-surface hover:bg-surface-container-high transition-all border border-outline-variant/30">
                Back to Tips
            </a>
        </div>
    </div>

    <!-- Main Form Card Container -->
    <form asp-action="TipForm" method="post" enctype="multipart/form-data" class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-start" id="tip-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CurrentImagePath" />

        <!-- Left Column: Main Metadata & Description (8 cols) -->
        <div class="lg:col-span-8 space-y-space-lg bg-surface-container-low/70 backdrop-blur-xl p-space-lg rounded-2xl shadow-xl">
            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-error/15 border border-error/30 text-error text-body-sm"></div>

            <!-- Title Input -->
            <div class="space-y-space-xs">
                <label asp-for="Title" class="block font-label-md text-on-surface">Tip Title <span class="text-primary">*</span></label>
                <input asp-for="Title" class="w-full bg-[#0A211E] text-on-surface font-body-md rounded-xl px-space-md py-3 border border-outline-variant/30 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" placeholder="e.g., The Secret to Achieving Perfect Glaze Emulsification" required />
                <span asp-validation-for="Title" class="text-error text-label-sm"></span>
            </div>

            <!-- Category -->
            <div class="space-y-space-xs">
                <label asp-for="CategoryId" class="block font-label-md text-on-surface">Category <span class="text-primary">*</span></label>
                <select asp-for="CategoryId" class="w-full bg-[#0A211E] text-on-surface font-body-md rounded-xl px-space-md py-3 border border-outline-variant/30 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all cursor-pointer" required>
                    <option value="">Select Category...</option>
                    @if (Model.Categories != null)
                    {
                        foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-error text-label-sm"></span>
            </div>

            <!-- Description / Body -->
            <div class="space-y-space-xs">
                <label asp-for="Description" class="block font-label-md text-on-surface">Description &amp; Step-by-Step Instructions <span class="text-primary">*</span></label>
                <textarea asp-for="Description" rows="8" class="w-full bg-[#0A211E] text-on-surface font-body-md rounded-xl p-space-md border border-outline-variant/30 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" placeholder="Outline the precise thermal thresholds, ingredient ratios, and knife techniques required to execute this culinary master tip..." required></textarea>
                <span asp-validation-for="Description" class="text-error text-label-sm"></span>
            </div>
        </div>

        <!-- Right Column: Publishing Controls & Media (4 cols) -->
        <div class="lg:col-span-4 space-y-space-lg">
            <!-- Access Tier -->
            <div class="bg-surface-container-low/70 backdrop-blur-xl p-space-lg rounded-2xl shadow-xl space-y-4">
                <h3 class="font-title-md text-on-surface">Access Tier</h3>
                <div class="space-y-3">
                    <label class="flex items-center gap-3 p-3 rounded-xl bg-[#0A211E] border border-outline-variant/30 cursor-pointer">
                        <input type="radio" asp-for="Access" value="Free" class="accent-primary" />
                        <div>
                            <span class="font-title-md text-on-surface block">Free Public</span>
                            <span class="text-label-sm text-on-surface-variant">Accessible by everyone</span>
                        </div>
                    </label>
                    <label class="flex items-center gap-3 p-3 rounded-xl bg-[#0A211E] border border-outline-variant/30 cursor-pointer">
                        <input type="radio" asp-for="Access" value="Premium" class="accent-primary" />
                        <div>
                            <span class="font-title-md text-primary block">Premium Archive</span>
                            <span class="text-label-sm text-on-surface-variant">Members only</span>
                        </div>
                    </label>
                </div>
            </div>

            <!-- Media Upload Card -->
            <div class="bg-surface-container-low/70 backdrop-blur-xl p-space-lg rounded-2xl shadow-xl space-y-space-md">
                <h3 class="font-title-md text-on-surface">Demonstration Photo</h3>
                @if (!string.IsNullOrEmpty(Model.CurrentImagePath))
                {
                    <div class="mb-2">
                        <img src="@Model.CurrentImagePath" alt="Current Image" class="w-full h-32 object-cover rounded-xl" />
                    </div>
                }
                <div class="border-2 border-dashed border-outline-variant/40 hover:border-primary rounded-xl p-4 text-center cursor-pointer transition-all bg-[#0A211E]/40" onclick="document.getElementById('admin-tip-img').click()">
                    <input type="file" id="admin-tip-img" asp-for="ImageFile" accept="image/*" class="hidden" onchange="previewAdminTipImg(this)" />
                    <span class="material-symbols-outlined text-[32px] text-primary mb-1">add_photo_alternate</span>
                    <p class="text-body-sm text-on-surface">Select Image</p>
                    <div id="admin-tip-preview-wrap" class="mt-2 hidden">
                        <img id="admin-tip-preview-img" class="max-h-28 mx-auto rounded-lg object-cover" />
                    </div>
                </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="w-full py-4 rounded-full bg-primary hover:bg-[#E8A173] text-[#0A211E] font-bold text-title-md shadow-[0_4px_16px_rgba(217,138,86,0.25)] hover:shadow-[0_6px_24px_rgba(217,138,86,0.40)] transition-all cursor-pointer flex items-center justify-center gap-2">
                <span class="material-symbols-outlined">save</span>
                @(Model.Id > 0 ? "Save Changes" : "Publish Master Tip")
            </button>
        </div>
    </form>
</div>

<script>
    function previewAdminTipImg(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('admin-tip-preview-img').src = e.target.result;
                document.getElementById('admin-tip-preview-wrap').classList.remove('hidden');
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
