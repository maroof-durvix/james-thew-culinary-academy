@model IEnumerable<JamesThew.Web.Models.Entities.Tip>
@{
    ViewData["Title"] = "Manage Culinary Tips";
    Layout = "_AdminLayout";
}

@if (TempData["Success"] != null)
{
    <div class="mb-6 p-4 rounded-xl bg-[rgba(93,187,138,0.15)] border border-[rgba(93,187,138,0.3)] text-[#5DBB8A] flex items-center gap-3">
        <span class="material-symbols-outlined text-[20px]">check_circle</span>
        <span>@TempData["Success"]</span>
    </div>
}

<div class="flex flex-col w-full text-on-surface pb-16">
    <!-- Page Header & Actions Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-space-md mb-space-xl">
        <div>
            <h1 class="font-headline-xl text-on-surface mb-space-xs">Culinary Mastery Tips</h1>
            <p class="font-body-md text-on-surface-variant">Curate and manage professional kitchen secrets, knife skills, and technique advisory notes.</p>
        </div>
        <div class="flex items-center gap-space-md">
            <a asp-action="TipForm" class="flex items-center gap-space-sm px-6 py-2.5 rounded-full bg-primary hover:bg-[#E8A173] text-[#0A211E] font-semibold text-body-md transition-all shadow-[0_4px_16px_rgba(217,138,86,0.25)]">
                <span class="material-symbols-outlined">add</span>
                <span>+ Add Tip</span>
            </a>
        </div>
    </div>

    <!-- KPI Quick Metrics (Bento Row) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-space-md mb-space-xl">
        <div class="bg-surface-container-high/75 backdrop-blur-[16px] p-space-lg rounded-[18px] border border-[rgba(246,239,227,0.12)] shadow-sm">
            <div class="flex items-center justify-between mb-space-sm">
                <span class="font-label-sm text-outline uppercase tracking-wider">Total Active Tips</span>
                <span class="material-symbols-outlined text-primary">lightbulb</span>
            </div>
            <div class="font-headline-lg text-on-surface mb-space-xs">@Model.Count()</div>
            <div class="flex items-center gap-1 font-body-sm text-secondary">
                <span class="material-symbols-outlined text-sm">verified</span>
                <span>Technique Library</span>
            </div>
        </div>

        <div class="bg-surface-container-high/75 backdrop-blur-[16px] p-space-lg rounded-[18px] border border-[rgba(246,239,227,0.12)] shadow-sm">
            <div class="flex items-center justify-between mb-space-sm">
                <span class="font-label-sm text-outline uppercase tracking-wider">Free Insights</span>
                <span class="material-symbols-outlined text-tertiary">lock_open</span>
            </div>
            <div class="font-headline-lg text-on-surface mb-space-xs">@Model.Count(t => t.Access == "Free")</div>
            <div class="flex items-center gap-1 font-body-sm text-on-surface-variant">
                <span>Publicly accessible</span>
            </div>
        </div>

        <div class="bg-surface-container-high/75 backdrop-blur-[16px] p-space-lg rounded-[18px] border border-[rgba(246,239,227,0.12)] shadow-sm">
            <div class="flex items-center justify-between mb-space-sm">
                <span class="font-label-sm text-outline uppercase tracking-wider">Masterclass Premium</span>
                <span class="material-symbols-outlined text-primary-container">workspace_premium</span>
            </div>
            <div class="font-headline-lg text-on-surface mb-space-xs">@Model.Count(t => t.Access == "Premium")</div>
            <div class="flex items-center gap-1 font-body-sm text-primary">
                <span>VIP Subscriber tier</span>
            </div>
        </div>
    </div>

    <!-- Search Toolbar -->
    <div class="mb-6 max-w-md">
        <div class="relative">
            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-sm">search</span>
            <input id="admin-tip-search" oninput="filterAdminTips()" class="w-full pl-10 pr-4 py-2.5 bg-[#0A211E] border border-[rgba(246,239,227,0.16)] rounded-xl text-body-sm text-on-surface placeholder:text-on-surface-variant focus:outline-none focus:border-primary transition-colors" placeholder="Search tips by title or category..." type="text"/>
        </div>
    </div>

    <!-- Table Container -->
    <div class="bg-surface-container-high/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] rounded-2xl overflow-hidden shadow-xl">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-[rgba(246,239,227,0.08)] bg-[#184238]/30">
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Tip Title &amp; Details</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Category</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Author</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Access Type</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Date Added</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990] text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[rgba(246,239,227,0.08)]" id="admin-tips-table-body">
                    @foreach (var tip in Model)
                    {
                        <tr class="admin-tip-row hover:bg-[rgba(24,66,56,0.5)] transition-colors" data-search="@($"{tip.Title} {tip.Category?.Name}".ToLower())">
                            <td class="py-4 px-6">
                                <div class="flex items-center gap-4">
                                    <img src="@tip.ImagePath" alt="@tip.Title" class="w-12 h-12 rounded-lg object-cover bg-surface-container shrink-0" onerror="this.src='/images/tip-default.jpg'"/>
                                    <div>
                                        <div class="font-semibold text-on-surface">@tip.Title</div>
                                        <div class="text-xs text-[#7F9990] line-clamp-1">@tip.Description</div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-4 px-6">
                                <span class="px-2.5 py-1 rounded-full text-label-sm bg-[#184238] border border-[rgba(246,239,227,0.1)] text-[#B7C7BF]">
                                    @tip.Category?.Name
                                </span>
                            </td>
                            <td class="py-4 px-6 text-body-sm text-on-surface">
                                @(tip.Author?.FullName ?? "Chef James Thew")
                            </td>
                            <td class="py-4 px-6">
                                <span class="px-2.5 py-1 rounded-full text-label-sm font-semibold @(tip.Access == "Premium" ? "bg-[rgba(217,138,86,0.18)] text-primary border border-[rgba(217,138,86,0.45)]" : "bg-[rgba(159,216,184,0.15)] text-[#9FD8B8] border border-[rgba(159,216,184,0.35)]")">
                                    @tip.Access
                                </span>
                            </td>
                            <td class="py-4 px-6 text-body-sm text-[#7F9990]">
                                @tip.CreatedAt.ToString("MMM dd, yyyy")
                            </td>
                            <td class="py-4 px-6 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a asp-controller="Tips" asp-action="Details" asp-route-id="@tip.Id" class="p-1.5 rounded-lg bg-[#184238] text-on-surface-variant hover:text-primary transition-colors" title="View Tip">
                                        <span class="material-symbols-outlined text-sm">visibility</span>
                                    </a>
                                    <a asp-action="TipForm" asp-route-id="@tip.Id" class="p-1.5 rounded-lg bg-[#184238] text-on-surface-variant hover:text-[#5DBB8A] transition-colors" title="Edit Tip">
                                        <span class="material-symbols-outlined text-sm">edit</span>
                                    </a>
                                    <form asp-action="DeleteTip" asp-route-id="@tip.Id" method="post" class="inline" onsubmit="return confirm('Are you sure you want to permanently delete this tip?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="p-1.5 rounded-lg bg-[#184238] text-error hover:bg-error/20 transition-colors cursor-pointer" title="Delete Tip">
                                            <span class="material-symbols-outlined text-sm">delete</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function filterAdminTips() {
        const query = (document.getElementById('admin-tip-search').value || '').toLowerCase();
        const rows = document.querySelectorAll('.admin-tip-row');
        rows.forEach(row => {
            const data = row.getAttribute('data-search');
            row.style.display = data.includes(query) ? '' : 'none';
        });
    }
</script>
