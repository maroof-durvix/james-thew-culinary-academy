<!-- Client-side Interactive Script -->
<script>
    let tipToDelete = '';

    function openDeleteModal(title) {
      tipToDelete = title;
      document.getElementById('delete-tip-title').innerText = '"' + title + '"';
      document.getElementById('delete-modal').classList.remove('hidden');
    }

    function closeDeleteModal() {
      document.getElementById('delete-modal').classList.add('hidden');
      tipToDelete = '';
    }

    function confirmDelete() {
      closeDeleteModal();
      showToast('Tip Deleted', 'Successfully removed ' + tipToDelete + ' from database.');
    }

    function toggleAccess(checkbox) {
      const parentLabel = checkbox.nextElementSibling.nextElementSibling;
      if (checkbox.checked) {
        parentLabel.innerText = 'Premium';
        parentLabel.className = 'ml-3 font-label-sm text-primary';
        showToast('Access Updated', 'Tip changed to Premium status.');
      } else {
        parentLabel.innerText = 'Free';
        parentLabel.className = 'ml-3 font-label-sm text-secondary';
        showToast('Access Updated', 'Tip changed to Free status.');
      }
    }

    function viewTip(title) {
      showToast('Viewing Tip', 'Loading preview mode for: ' + title);
    }

    function editTip(title) {
      showToast('Edit Mode', 'Opening editor workspace for: ' + title);
    }

    function openAddTipModal() {
      showToast('New Tip Creator', 'Opening multi-step tip authoring suite.');
    }

    function resetFilters() {
      document.getElementById('tip-search').value = '';
      document.getElementById('filter-category').value = '';
      document.getElementById('filter-access').value = '';
      document.getElementById('filter-author').value = '';
      showToast('Filters Reset', 'Showing all master tips.');
    }

    function showToast(title, message) {
      const toast = document.getElementById('toast-notification');
      document.getElementById('toast-title').innerText = title;
      document.getElementById('toast-message').innerText = message;
      toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
      setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
      }, 3500);
    }

    // Search filter simulation
    document.getElementById('tip-search').addEventListener('input', function(e) {
      const term = e.target.value.toLowerCase();
      const rows = document.querySelectorAll('#tips-table-body tr');
      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        if(text.includes(term)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });
  </script>
</div>
