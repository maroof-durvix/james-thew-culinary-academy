<button class="px-space-lg py-2 rounded-full bg-error text-on-error font-label-md hover:opacity-90 shadow-[0_4px_16px_rgba(255,180,171,0.25)] transition-all" onclick="confirmDelete()">Delete Tip</button>
</div>
</div>
