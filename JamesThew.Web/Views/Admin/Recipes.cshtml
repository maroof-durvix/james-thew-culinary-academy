@model IEnumerable<JamesThew.Web.Models.Entities.Recipe>
@{
    ViewData["Title"] = "Manage Recipes";
    Layout = "_AdminLayout";
}

@if (TempData["Success"] != null)
{
    <div class="mb-6 p-4 rounded-xl bg-[rgba(93,187,138,0.15)] border border-[rgba(93,187,138,0.3)] text-[#5DBB8A] flex items-center gap-3">
        <span class="material-symbols-outlined text-[20px]">check_circle</span>
        <span>@TempData["Success"]</span>
    </div>
}

<div class="flex flex-col w-full pb-16">
    <!-- Top Action Bar & Filters -->
    <div class="flex flex-col xl:flex-row xl:items-center xl:justify-between gap-6 mb-8">
        <div class="flex flex-wrap items-center gap-4">
            <div class="relative">
                <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-sm">search</span>
                <input id="admin-recipe-search" oninput="filterAdminRecipes()" class="w-72 pl-10 pr-4 py-2.5 bg-[#0A211E] border border-[rgba(246,239,227,0.16)] rounded-xl text-body-sm text-on-surface placeholder:text-on-surface-variant focus:outline-none focus:border-primary transition-colors" placeholder="Search recipes by title or author..." type="text"/>
            </div>
        </div>
        <div>
            <a asp-action="RecipeForm" class="inline-flex items-center gap-2 px-6 py-2.5 bg-primary hover:bg-[#E8A173] text-[#0A211E] font-semibold text-body-md rounded-full shadow-[0_4px_16px_rgba(217,138,86,0.25)] hover:shadow-[0_6px_24px_rgba(217,138,86,0.40)] transition-all">
                <span class="material-symbols-outlined text-lg">add</span>
                <span>Add Recipe</span>
            </a>
        </div>
    </div>

    <!-- KPI / Quick Stats Strip -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] rounded-xl p-6 shadow-sm">
            <div class="text-label-sm text-outline uppercase tracking-wider mb-2">Total Recipes</div>
            <div class="text-[36px] font-headline text-[#F6EFE3] leading-none mb-1">@Model.Count()</div>
            <div class="text-body-sm text-[#5DBB8A] flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">menu_book</span> Catalog entries
            </div>
        </div>
        <div class="bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] rounded-xl p-6 shadow-sm">
            <div class="text-label-sm text-outline uppercase tracking-wider mb-2">Free Public Tier</div>
            <div class="text-[36px] font-headline text-[#F6EFE3] leading-none mb-1">@Model.Count(r => r.Access == "Free")</div>
            <div class="text-body-sm text-tertiary">Accessible to all users</div>
        </div>
        <div class="bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] rounded-xl p-6 shadow-sm">
            <div class="text-label-sm text-outline uppercase tracking-wider mb-2">Premium Masterclasses</div>
            <div class="text-[36px] font-headline text-[#F6EFE3] leading-none mb-1">@Model.Count(r => r.Access == "Premium")</div>
            <div class="text-body-sm text-primary flex items-center gap-1">
                <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">workspace_premium</span> Exclusive VIP content
            </div>
        </div>
    </div>

    <!-- Recipes Table Container -->
    <div class="bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] rounded-2xl overflow-hidden shadow-xl">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-[rgba(246,239,227,0.08)] bg-[#184238]/30">
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Thumbnail &amp; Title</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Category</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Author</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Access Type</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Date Posted</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990] text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[rgba(246,239,227,0.08)]" id="admin-recipes-table-body">
                    @foreach (var recipe in Model)
                    {
                        <tr class="admin-recipe-row hover:bg-[rgba(24,66,56,0.5)] transition-colors" data-search="@($"{recipe.Title} {recipe.Author?.FullName}".ToLower())">
                            <td class="py-4 px-6">
                                <div class="flex items-center gap-4">
                                    <img src="@recipe.ImagePath" alt="@recipe.Title" class="w-12 h-12 rounded-lg object-cover bg-surface-container-high" onerror="this.src='/images/recipe-default.jpg'"/>
                                    <div>
                                        <div class="font-semibold text-on-surface">@recipe.Title</div>
                                        <div class="text-xs text-[#7F9990]">@recipe.PrepMinutes m prep · @recipe.CookMinutes m cook</div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-4 px-6">
                                <span class="px-2.5 py-1 rounded-full text-label-sm bg-[#184238] border border-[rgba(246,239,227,0.1)] text-[#B7C7BF]">
                                    @recipe.Category?.Name
                                </span>
                            </td>
                            <td class="py-4 px-6 text-body-sm text-on-surface">
                                @(recipe.Author?.FullName ?? "Executive Chef")
                            </td>
                            <td class="py-4 px-6">
                                <span class="px-2.5 py-1 rounded-full text-label-sm font-semibold @(recipe.Access == "Premium" ? "bg-[rgba(217,138,86,0.18)] text-primary border border-[rgba(217,138,86,0.45)]" : "bg-[rgba(159,216,184,0.15)] text-[#9FD8B8] border border-[rgba(159,216,184,0.35)]")">
                                    @recipe.Access
                                </span>
                            </td>
                            <td class="py-4 px-6 text-body-sm text-[#7F9990]">
                                @recipe.CreatedAt.ToString("MMM dd, yyyy")
                            </td>
                            <td class="py-4 px-6 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipe.Id" class="p-1.5 rounded-lg bg-[#184238] text-on-surface-variant hover:text-primary transition-colors" title="View Public Recipe">
                                        <span class="material-symbols-outlined text-sm">visibility</span>
                                    </a>
                                    <a asp-action="RecipeForm" asp-route-id="@recipe.Id" class="p-1.5 rounded-lg bg-[#184238] text-on-surface-variant hover:text-[#5DBB8A] transition-colors" title="Edit Recipe">
                                        <span class="material-symbols-outlined text-sm">edit</span>
                                    </a>
                                    <form asp-action="DeleteRecipe" asp-route-id="@recipe.Id" method="post" class="inline" onsubmit="return confirm('Are you sure you want to permanently delete this recipe?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="p-1.5 rounded-lg bg-[#184238] text-error hover:bg-error/20 transition-colors cursor-pointer" title="Delete Recipe">
                                            <span class="material-symbols-outlined text-sm">delete</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function filterAdminRecipes() {
        const query = (document.getElementById('admin-recipe-search').value || '').toLowerCase();
        const rows = document.querySelectorAll('.admin-recipe-row');
        rows.forEach(row => {
            const data = row.getAttribute('data-search');
            row.style.display = data.includes(query) ? '' : 'none';
        });
    }
</script>
