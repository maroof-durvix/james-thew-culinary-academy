<!-- DELETE CONFIRMATION MODAL -->
<div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-md hidden" id="deleteModal">
<div class="bg-[#184238] border border-[rgba(246,239,227,0.2)] rounded-2xl p-8 max-w-md w-full mx-4 shadow-2xl relative">
<div class="w-12 h-12 rounded-full bg-[rgba(229,115,106,0.15)] border border-[rgba(229,115,106,0.3)] text-[#E5736A] flex items-center justify-center mb-4">
<span class="material-symbols-outlined text-2xl">warning</span>
</div>
<h3 class="text-headline-sm font-headline text-[#F6EFE3] mb-2">Confirm Recipe Deletion</h3>
<p class="text-body-md text-[#B7C7BF] mb-6">Are you sure you want to permanently delete this recipe? This action cannot be undone and will remove it from all member feeds.</p>
<div class="flex items-center justify-end gap-3">
<button class="px-5 py-2.5 rounded-full border border-[rgba(246,239,227,0.4)] text-[#F6EFE3] hover:bg-[rgba(246,239,227,0.08)] transition-all text-body-md" onclick="document.getElementById('deleteModal').classList.add('hidden')">Cancel</button>
<button class="px-5 py-2.5 rounded-full bg-[#E5736A] hover:bg-[#d96259] text-white font-semibold transition-all text-body-md shadow-lg" onclick="document.getElementById('deleteModal').classList.add('hidden')">Delete Recipe</button>
</div>
</div>
</div>
<!-- ADD RECIPE MODAL -->
<div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-md hidden" id="addRecipeModal">
<div class="bg-[#184238] border border-[rgba(246,239,227,0.2)] rounded-2xl p-8 max-w-2xl w-full mx-4 shadow-2xl relative max-h-[921px] overflow-y-auto">
<div class="flex items-center justify-between mb-6">
<h3 class="text-headline-sm font-headline text-[#F6EFE3]">Add New Culinary Recipe</h3>
<button class="text-[#7F9990] hover:text-[#F6EFE3]" onclick="document.getElementById('addRecipeModal').classList.add('hidden')">
<span class="material-symbols-outlined">close</span>
</button>
</div>
<div class="space-y-4">
<div>
<label class="block text-label-sm uppercase tracking-wider text-[#7F9990] mb-2">Recipe Title</label>
<input class="w-full px-4 py-2.5 bg-[#0A211E] border border-[rgba(246,239,227,0.16)] rounded-xl text-body-sm text-[#F6EFE3] placeholder:text-[#7F9990] focus:outline-none focus:border-primary" placeholder="e.g. Herb-Crusted Rack of Lamb" type="text"/>
</div>
<div class="grid grid-cols-2 gap-4">
<div>
<label class="block text-label-sm uppercase tracking-wider text-[#7F9990] mb-2">Category</label>
