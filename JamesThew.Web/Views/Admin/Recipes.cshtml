@{
    ViewData["Title"] = "Recipes";
}

<div class="flex flex-col w-full pb-16">
<!-- Top Action Bar & Filters -->
<div class="flex flex-col xl:flex-row xl:items-center xl:justify-between gap-6 mb-8">
<div class="flex flex-wrap items-center gap-4">
<div class="relative">
<span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-sm">search</span>
<input class="w-72 pl-10 pr-4 py-2.5 bg-[#0A211E] border border-[rgba(246,239,227,0.16)] rounded-xl text-body-sm text-on-surface placeholder:text-on-surface-variant focus:outline-none focus:border-primary transition-colors" placeholder="Search recipes..." type="text"/>
</div>
<select class="px-4 py-2.5 bg-[#0A211E] border border-[rgba(246,239,227,0.16)] rounded-xl text-body-sm text-on-surface focus:outline-none focus:border-primary transition-colors">
<option>All Categories</option>
<option>Main Course</option>
<option>Pasta & Grains</option>
<option>Beverages</option>
<option>Desserts</option>
</select>
<select class="px-4 py-2.5 bg-[#0A211E] border border-[rgba(246,239,227,0.16)] rounded-xl text-body-sm text-on-surface focus:outline-none focus:border-primary transition-colors">
<option>Access: All</option>
<option>Free</option>
<option>Premium</option>
</select>
<select class="px-4 py-2.5 bg-[#0A211E] border border-[rgba(246,239,227,0.16)] rounded-xl text-body-sm text-on-surface focus:outline-none focus:border-primary transition-colors">
<option>All Authors</option>
<option>Chef James</option>
<option>Elena Vance</option>
<option>Marcus Sterling</option>
</select>
</div>
<div>
<button class="inline-flex items-center gap-2 px-6 py-2.5 bg-primary hover:bg-[#E8A173] text-[#0A211E] font-semibold text-body-md rounded-full shadow-[0_4px_16px_rgba(217,138,86,0.25)] hover:shadow-[0_6px_24px_rgba(217,138,86,0.40)] transition-all" onclick="document.getElementById('addRecipeModal').classList.remove('hidden')">
<span class="material-symbols-outlined text-lg">add</span>
<span>Add Recipe</span>
</button>
</div>
</div>
<!-- KPI / Quick Stats Strip -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
<div class="bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] rounded-xl p-6 shadow-sm">
<div class="text-label-sm text-outline uppercase tracking-wider mb-2">Total Recipes</div>
<div class="text-[36px] font-headline text-[#F6EFE3] leading-none mb-1">142</div>
<div class="text-body-sm text-[#5DBB8A] flex items-center gap-1"><span class="material-symbols-outlined text-sm">trending_up</span> +4 this week</div>
</div>
<div class="bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] rounded-xl p-6 shadow-sm">
<div class="text-label-sm text-outline uppercase tracking-wider mb-2">Free Access</div>
<div class="text-[36px] font-headline text-[#F6EFE3] leading-none mb-1">68</div>
<div class="text-body-sm text-tertiary">Publicly available</div>
</div>
<div class="bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] rounded-xl p-6 shadow-sm">
<div class="text-label-sm text-outline uppercase tracking-wider mb-2">Premium Masterclasses</div>
<div class="text-[36px] font-headline text-[#F6EFE3] leading-none mb-1">74</div>
<div class="text-body-sm text-primary flex items-center gap-1"><span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">workspace_premium</span> Exclusive content</div>
