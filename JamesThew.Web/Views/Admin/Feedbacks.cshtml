@model (List<JamesThew.Web.Models.Entities.ContactMessage> contactMessages, List<JamesThew.Web.Models.Entities.SiteFeedback> siteFeedbacks)
@{
    ViewData["Title"] = "Feedbacks & Contact Inquiries";
    Layout = "_AdminLayout";

    var avgRating = Model.siteFeedbacks.Any() ? Model.siteFeedbacks.Average(f => f.Rating).ToString("0.0") : "5.0";
}

@if (TempData["Success"] != null)
{
    <div class="mb-6 p-4 rounded-xl bg-[rgba(93,187,138,0.15)] border border-[rgba(93,187,138,0.3)] text-[#5DBB8A] flex items-center gap-3">
        <span class="material-symbols-outlined text-[20px]">check_circle</span>
        <span>@TempData["Success"]</span>
    </div>
}

<div class="flex flex-col w-full text-on-surface pb-16">
    <!-- Top Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md mb-space-xl">
        <div class="bg-surface-container/75 backdrop-blur-xl p-space-lg rounded-xl shadow-xl flex items-center justify-between">
            <div>
                <p class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider mb-space-xs">Average Site Rating</p>
                <div class="flex items-baseline gap-space-sm">
                    <span class="text-display-lg font-display-lg text-primary text-4xl font-bold font-headline">@avgRating</span>
                    <span class="text-body-sm text-secondary">/ 5.0</span>
                </div>
            </div>
            <div class="w-12 h-12 rounded-full bg-primary-container/20 flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'FILL' 1;">star</span>
            </div>
        </div>

        <div class="bg-surface-container/75 backdrop-blur-xl p-space-lg rounded-xl shadow-xl flex items-center justify-between">
            <div>
                <p class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider mb-space-xs">Contact Messages</p>
                <span class="text-display-lg font-display-lg text-on-surface text-4xl font-bold font-headline">@Model.contactMessages.Count</span>
            </div>
            <div class="w-12 h-12 rounded-full bg-secondary-container/30 flex items-center justify-center text-secondary">
                <span class="material-symbols-outlined text-2xl">mail</span>
            </div>
        </div>

        <div class="bg-surface-container/75 backdrop-blur-xl p-space-lg rounded-xl shadow-xl flex items-center justify-between">
            <div>
                <p class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider mb-space-xs">Community Testimonials</p>
                <span class="text-display-lg font-display-lg text-secondary text-4xl font-bold font-headline">@Model.siteFeedbacks.Count</span>
            </div>
            <div class="w-12 h-12 rounded-full bg-surface-bright flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-2xl">forum</span>
            </div>
        </div>
    </div>

    <!-- Tabs Bar -->
    <div class="flex items-center bg-surface-container-low p-1 rounded-full w-fit mb-6">
        <button class="px-6 py-2 rounded-full text-title-md transition-all bg-primary-container text-on-primary-container shadow-sm cursor-pointer" id="tab-inquiries-btn" onclick="switchFeedbackTab('inquiries')">
            Contact Inquiries (@Model.contactMessages.Count)
        </button>
        <button class="px-6 py-2 rounded-full text-title-md transition-all text-on-surface-variant hover:text-on-surface cursor-pointer" id="tab-reviews-btn" onclick="switchFeedbackTab('reviews')">
            Site Reviews &amp; Testimonials (@Model.siteFeedbacks.Count)
        </button>
    </div>

    <!-- Tab 1: Contact Messages -->
    <div id="tab-inquiries" class="bg-surface-container/75 backdrop-blur-xl rounded-xl shadow-xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-[rgba(246,239,227,0.08)] bg-[#184238]/30">
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Sender</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Email</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Message</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Received</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990] text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[rgba(246,239,227,0.08)] text-body-md text-on-surface">
                    @if (!Model.contactMessages.Any())
                    {
                        <tr>
                            <td colspan="5" class="py-8 text-center text-on-surface-variant">No contact inquiries in inbox.</td>
                        </tr>
                    }
                    @foreach (var msg in Model.contactMessages)
                    {
                        <tr class="hover:bg-[rgba(24,66,56,0.5)] transition-colors">
                            <td class="py-4 px-6 font-semibold">@msg.Name</td>
                            <td class="py-4 px-6 text-primary">@msg.Email</td>
                            <td class="py-4 px-6 text-on-surface-variant max-w-md">@msg.Message</td>
                            <td class="py-4 px-6 text-[#7F9990] text-sm">@msg.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="py-4 px-6 text-right">
                                <form asp-action="DeleteContactMessage" asp-route-id="@msg.Id" method="post" class="inline" onsubmit="return confirm('Delete this message?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="p-1.5 rounded-lg bg-[#184238] text-error hover:bg-error/20 transition-colors cursor-pointer" title="Delete Message">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Tab 2: Site Feedbacks -->
    <div id="tab-reviews" class="hidden bg-surface-container/75 backdrop-blur-xl rounded-xl shadow-xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-[rgba(246,239,227,0.08)] bg-[#184238]/30">
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Author</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Category</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Rating</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Comments</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990]">Show on Home</th>
                        <th class="py-4 px-6 text-label-sm uppercase tracking-wider text-[#7F9990] text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[rgba(246,239,227,0.08)] text-body-md text-on-surface">
                    @if (!Model.siteFeedbacks.Any())
                    {
                        <tr>
                            <td colspan="6" class="py-8 text-center text-on-surface-variant">No site reviews submitted yet.</td>
                        </tr>
                    }
                    @foreach (var fb in Model.siteFeedbacks)
                    {
                        <tr class="hover:bg-[rgba(24,66,56,0.5)] transition-colors">
                            <td class="py-4 px-6 font-semibold">
                                <div>@fb.Name</div>
                                <div class="text-xs text-[#7F9990]">@fb.Email</div>
                            </td>
                            <td class="py-4 px-6">
                                <span class="px-2.5 py-0.5 rounded-full text-label-sm bg-surface-container text-[#B7C7BF]">@fb.Category</span>
                            </td>
                            <td class="py-4 px-6">
                                <div class="flex items-center text-primary">
                                    @for (int i = 0; i < fb.Rating; i++)
                                    {
                                        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
                                    }
                                </div>
                            </td>
                            <td class="py-4 px-6 text-on-surface-variant max-w-sm">@fb.Comments</td>
                            <td class="py-4 px-6">
                                <form asp-action="ToggleShowOnHome" asp-route-id="@fb.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="px-3 py-1 rounded-full text-label-sm font-semibold @(fb.ShowOnHome ? "bg-[#5DBB8A]/20 text-[#5DBB8A] border border-[#5DBB8A]/40" : "bg-surface-container-high text-on-surface-variant") cursor-pointer transition-all">
                                        @(fb.ShowOnHome ? "Approved (Live)" : "Hidden")
                                    </button>
                                </form>
                            </td>
                            <td class="py-4 px-6 text-right">
                                <form asp-action="DeleteFeedback" asp-route-id="@fb.Id" method="post" class="inline" onsubmit="return confirm('Delete this feedback?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="p-1.5 rounded-lg bg-[#184238] text-error hover:bg-error/20 transition-colors cursor-pointer" title="Delete Review">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function switchFeedbackTab(tab) {
        const inq = document.getElementById('tab-inquiries');
        const rev = document.getElementById('tab-reviews');
        const btnInq = document.getElementById('tab-inquiries-btn');
        const btnRev = document.getElementById('tab-reviews-btn');

        if (tab === 'inquiries') {
            inq.classList.remove('hidden');
            rev.classList.add('hidden');
            btnInq.className = "px-6 py-2 rounded-full text-title-md transition-all bg-primary-container text-on-primary-container shadow-sm cursor-pointer";
            btnRev.className = "px-6 py-2 rounded-full text-title-md transition-all text-on-surface-variant hover:text-on-surface cursor-pointer";
        } else {
            inq.classList.add('hidden');
            rev.classList.remove('hidden');
            btnRev.className = "px-6 py-2 rounded-full text-title-md transition-all bg-primary-container text-on-primary-container shadow-sm cursor-pointer";
            btnInq.className = "px-6 py-2 rounded-full text-title-md transition-all text-on-surface-variant hover:text-on-surface cursor-pointer";
        }
    }
</script>
