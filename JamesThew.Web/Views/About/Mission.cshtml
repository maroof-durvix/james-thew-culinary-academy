@{
    ViewData["Title"] = "Our Mission - Chef James Thew Culinary Academy";
}

<div class="relative w-full overflow-hidden">
<div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[720px] h-[360px] bg-primary/10 rounded-full blur-[120px] pointer-events-none"></div>
<div class="absolute top-20 right-[-100px] w-[450px] h-[450px] bg-secondary-container/20 rounded-full blur-[140px] pointer-events-none"></div>
<!-- Content Envelope -->
<div class="relative w-full max-w-7xl mx-auto px-margin-mobile lg:px-margin pt-space-md pb-space-xl">
<!-- Breadcrumb Bar -->
<nav aria-label="Breadcrumb" class="flex items-center gap-space-xs font-label-md text-label-md text-on-surface-variant mb-space-lg">
<a class="hover:text-primary transition-colors" asp-controller="Home" asp-action="Index">Home</a>
<span class="text-outline/50">/</span>
<span class="text-outline">About</span>
<span class="text-outline/50">/</span>
<span class="text-primary font-semibold">Our Mission</span>
</nav>
<!-- Editorial Header / Manifesto Hero -->
<header class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-end pb-space-xl">
<div class="lg:col-span-8 flex flex-col gap-space-sm">
<div class="flex items-center gap-space-xs font-label-sm text-label-sm uppercase tracking-widest text-primary">
<span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
            Culinary Philosophy &amp; Purpose
          </div>
<h1 class="font-display-lg text-display-lg text-on-surface tracking-tight leading-tight">
            “Exquisite cuisine is not an exclusive privilege; it is an enduring language of craft, patience, and shared joy that belongs in every kitchen worldwide.”
          </h1>
</div>
<div class="lg:col-span-4 flex flex-col gap-space-sm lg:pl-space-md lg:pb-space-xs">
<div class="flex items-center gap-space-sm">
<span class="font-headline-sm text-headline-sm text-on-surface">Chef James Thew</span>
<span class="material-symbols-outlined text-primary text-[20px]" style="font-variation-settings: 'FILL' 1;">verified</span>
</div>
<p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
            Executive 5-Star Chef, Author, and Culinary Educator striving to bridge the divide between grand hotel brigade mastery and the everyday home stove.
          </p>
<div class="flex items-center gap-space-xs text-secondary font-label-md text-label-md pt-space-xs">
<span class="material-symbols-outlined text-[16px]">restaurant_menu</span>
<span>Five-Star Kitchen Pedagogy</span>
</div>
</div>
</header>
<!-- Narrative Visual Anchor: Atelier Kitchen Stills -->
<section class="grid grid-cols-1 lg:grid-cols-12 gap-gutter mb-space-xl items-center">
<div class="lg:col-span-7 relative group overflow-hidden rounded-xl bg-surface-container-high shadow-xl">
<div class="relative h-[340px] md:h-[420px] w-full overflow-hidden">
<img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" data-alt="Close up photograph of a professional chef hand precisely garnishing an artisanal dish with delicate microgreens in a moody dimly lit emerald culinary suite with warm copper sauté pans glowing in ambient light, Michelin star fine dining photography" src="~/images/close-up-photograph-of-a-professional-chef-hand-17da3d.jpg"/>
<div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/30 to-transparent"></div>
<div class="absolute bottom-space-lg left-space-lg right-space-lg flex items-end justify-between">
<div>
<p class="font-label-sm text-label-sm uppercase tracking-wider text-primary">Mastercraft Precision</p>
<p class="font-headline-sm text-headline-sm text-on-surface">From Michelin Brigade to Domestic Sanctuary</p>
</div>
<span class="material-symbols-outlined text-primary-fixed bg-surface-container-highest/80 p-space-xs rounded-full backdrop-blur-md">skillet</span>
</div>
</div>
</div>
<div class="lg:col-span-5 flex flex-col justify-between h-full gap-gutter">
<div class="bg-surface-container-low/90 backdrop-blur-xl p-space-lg rounded-xl shadow-lg relative overflow-hidden">
<div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-full blur-2xl pointer-events-none"></div>
<div class="flex items-center gap-space-sm mb-space-sm">
<span class="material-symbols-outlined text-primary text-[22px]">auto_stories</span>
<span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary">Foundational Creed</span>
</div>
<p class="font-body-md text-body-md text-on-surface leading-relaxed">
              We dispel the myth that haute cuisine demands unattainable ingredients or impenetrable French kitchen nomenclature. By deconstructing balance, heat control, seasoning, and texture, we empower cooks of every origin to cook with profound instinct and fearless curiosity.
            </p>
</div>
<div class="bg-surface-container-low/90 backdrop-blur-xl p-space-lg rounded-xl shadow-lg flex items-center gap-space-md">
<div class="w-14 h-14 shrink-0 rounded-full bg-secondary-container/40 flex items-center justify-center text-secondary">
<span class="material-symbols-outlined text-[28px]">local_dining</span>
</div>
<div>
<h3 class="font-title-lg text-title-lg text-on-surface">Open Pedagogy</h3>
<p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">
                Freely shared master fundamentals paired with tiered mentorship, ensuring refined technique is never kept behind gatekept guild doors.
              </p>
</div>
</div>
</div>
</section>
<!-- Dual Pillar Cards: Mission & Vision -->
<section class="grid grid-cols-1 md:grid-cols-2 gap-gutter mb-space-xl">
