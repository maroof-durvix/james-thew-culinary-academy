      const isHidden = content.classList.contains('hidden');

      // Close other accordions for clean single open behavior
      document.querySelectorAll('#plansFaqContainer .faq-content').forEach(el => {
        el.classList.add('hidden');
      });
      document.querySelectorAll('#plansFaqContainer .faq-icon').forEach(ic => {
        ic.style.transform = 'rotate(0deg)';
      });

      if (isHidden) {
        content.classList.remove('hidden');
        icon.style.transform = 'rotate(180deg)';
      }
    }

    function switchBillingCycle(cycle) {
      const monthlyBtn = document.getElementById('monthlyTabBtn');
      const yearlyBtn = document.getElementById('yearlyTabBtn');

      if (cycle === 'monthly') {
        monthlyBtn.className = 'px-space-lg py-2 rounded-full font-title-md text-title-md transition-all duration-300 bg-primary-container text-on-primary-container shadow-[0_4px_16px_rgba(217,138,86,0.3)] cursor-pointer';
        yearlyBtn.className = 'relative px-space-lg py-2 rounded-full font-title-md text-title-md transition-all duration-300 text-on-surface-variant bg-transparent cursor-pointer';
      } else {
        yearlyBtn.className = 'relative px-space-lg py-2 rounded-full font-title-md text-title-md transition-all duration-300 bg-primary-container text-on-primary-container shadow-[0_4px_16px_rgba(217,138,86,0.3)] cursor-pointer';
        monthlyBtn.className = 'px-space-lg py-2 rounded-full font-title-md text-title-md transition-all duration-300 text-on-surface-variant bg-transparent cursor-pointer';
      }
    }
  </script>
