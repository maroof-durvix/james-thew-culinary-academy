@{
    ViewData["Title"] = "Access Denied";
}

<section class="relative w-full min-h-[80vh] flex items-center justify-center px-4 bg-surface">
    <div class="w-full max-w-md text-center space-y-6">
        <!-- Icon -->
        <div class="w-20 h-20 mx-auto rounded-2xl bg-error-container/20 flex items-center justify-center shadow-lg">
            <span class="material-symbols-outlined text-4xl text-error" style="font-variation-settings: 'FILL' 1;">lock</span>
        </div>

        <!-- Heading -->
        <div>
            <h1 class="font-headline-xl text-headline-xl text-on-surface mb-2">Access Denied</h1>
            <p class="font-body-md text-body-md text-on-surface-variant">
                You do not have permission to access this page. This area is restricted to authorized members only.
            </p>
        </div>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center pt-2">
            <a asp-controller="Auth" asp-action="Login"
               class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-primary-container text-on-primary font-title-md text-title-md transition-all hover:opacity-90 shadow-md">
                <span class="material-symbols-outlined text-xl">login</span>
                Login
            </a>
            <a asp-controller="Plans" asp-action="Index"
               class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl border border-outline text-on-surface font-title-md text-title-md transition-all hover:bg-surface-container-high">
                <span class="material-symbols-outlined text-xl">workspace_premium</span>
                View Plans
            </a>
        </div>

        <!-- Back -->
        <p class="font-body-sm text-body-sm text-on-surface-variant">
            <a asp-controller="Home" asp-action="Index" class="text-primary hover:underline">← Return to Home</a>
        </p>
    </div>
</section>
