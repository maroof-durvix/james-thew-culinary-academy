@model JamesThew.Web.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<section class="relative w-full min-h-[80vh] flex items-center justify-center px-4 bg-surface">
    <div class="w-full max-w-md">
        <!-- Card -->
        <div class="bg-surface-container-low rounded-2xl shadow-xl border border-outline-variant/30 p-8 space-y-6">
            <!-- Icon + Title -->
            <div class="text-center space-y-2">
                <div class="w-14 h-14 mx-auto rounded-2xl bg-primary-container/20 flex items-center justify-center">
                    <span class="material-symbols-outlined text-3xl text-primary-container" style="font-variation-settings: 'FILL' 1;">lock_reset</span>
                </div>
                <h1 class="font-headline-md text-headline-md text-on-surface">Reset Your Password</h1>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Enter your new password below.</p>
            </div>

            <!-- Alerts -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="bg-error-container/20 border border-error/30 rounded-xl px-4 py-3 flex items-start gap-3">
                    <span class="material-symbols-outlined text-error text-xl mt-0.5" style="font-variation-settings: 'FILL' 1;">error</span>
                    <div class="font-body-sm text-body-sm text-error">
                        @Html.ValidationSummary(false, "", new { @class = "list-none p-0 m-0" })
                    </div>
                </div>
            }

            <!-- Form -->
            <form asp-action="ResetPassword" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Email" />

                <div class="space-y-1.5">
                    <label class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wide" asp-for="NewPassword">New Password</label>
                    <input asp-for="NewPassword" type="password" placeholder="Enter new password"
                           class="w-full px-4 py-3 rounded-xl bg-surface-container border border-outline-variant text-on-surface placeholder-outline font-body-md focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container/50 transition" />
                    <span asp-validation-for="NewPassword" class="font-body-sm text-body-sm text-error"></span>
                </div>

                <div class="space-y-1.5">
                    <label class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wide" asp-for="ConfirmPassword">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" placeholder="Confirm new password"
                           class="w-full px-4 py-3 rounded-xl bg-surface-container border border-outline-variant text-on-surface placeholder-outline font-body-md focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container/50 transition" />
                    <span asp-validation-for="ConfirmPassword" class="font-body-sm text-body-sm text-error"></span>
                </div>

                <button type="submit"
                        class="w-full px-6 py-3.5 rounded-xl bg-primary-container text-on-primary font-title-md text-title-md transition-all hover:opacity-90 shadow-md flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-xl">lock_reset</span>
                    Reset Password
                </button>
            </form>

            <p class="text-center font-body-sm text-body-sm text-on-surface-variant">
                <a asp-controller="Auth" asp-action="Login" class="text-primary hover:underline">← Back to Login</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
