@model IEnumerable<JamesThew.Web.Models.Entities.Recipe>
@{
    ViewData["Title"] = "Premium Recipes (Member)";
}

<div class="flex flex-col w-full">
<!-- Subtle Ambient Glow -->
<div class="relative w-full overflow-hidden">
<div class="absolute -top-32 left-1/4 w-96 h-96 bg-primary-container/10 rounded-full blur-3xl pointer-events-none"></div>
<div class="absolute top-20 right-10 w-80 h-80 bg-secondary/10 rounded-full blur-3xl pointer-events-none"></div>
<!-- Authenticated Member Utility Sub-Nav (Injects Member Session Indicators) -->
<div class="w-full bg-surface-container-lowest/70 backdrop-blur-md px-margin-mobile lg:px-margin py-space-sm flex items-center justify-between">
<!-- Breadcrumb -->
<nav aria-label="Breadcrumb" class="flex items-center gap-space-xs text-label-sm font-label-sm">
<a class="text-on-surface-variant hover:text-primary transition-colors" data-path="home" href="#">Home</a>
<span class="text-outline/40">/</span>
<a class="text-on-surface-variant hover:text-primary transition-colors" data-path="recipes" href="#">Recipes</a>
<span class="text-outline/40">/</span>
<span class="text-primary font-medium">Premium Recipes</span>
</nav>
<!-- Authenticated Member Header Widget -->
<div class="flex items-center gap-space-md">
<!-- Notification Bell with Dot -->
<button aria-label="Notifications" class="relative p-2 rounded-full hover:bg-surface-container text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer">
<span class="material-symbols-outlined text-[20px]">notifications</span>
<span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-primary ring-2 ring-surface-container-lowest"></span>
</button>
<!-- User Profile Dropdown Capsule -->
<div class="relative group">
<button class="flex items-center gap-space-sm py-1 px-2.5 rounded-full bg-surface-container hover:bg-surface-container-high transition-colors cursor-pointer text-left" id="user-menu-btn">
<div class="w-7 h-7 rounded-full bg-primary-container text-on-primary font-title-md flex items-center justify-center text-xs font-bold">
              EL
            </div>
<div class="hidden sm:flex flex-col">
<span class="font-label-sm text-[11px] leading-tight text-on-surface font-semibold flex items-center gap-1">
                Elena Rostova
                <span class="material-symbols-outlined text-[13px] text-primary" style="font-variation-settings: 'FILL' 1;">verified</span>
</span>
<span class="font-label-sm text-[9px] uppercase tracking-wider text-primary">Master Pass</span>
</div>
<span class="material-symbols-outlined text-[16px] text-outline group-hover:rotate-180 transition-transform duration-200">expand_more</span>
</button>
<!-- Dropdown Menu -->
<div class="absolute right-0 top-full pt-1.5 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50 min-w-[190px]">
<div class="p-space-xs bg-surface-container-high/95 backdrop-blur-2xl rounded-xl shadow-xl">
<div class="px-space-md py-space-xs text-label-sm text-outline">Member Access Active</div>
<a class="flex items-center gap-2 px-space-md py-space-sm rounded-lg font-body-sm text-body-sm text-on-surface-variant hover:bg-surface-container-highest hover:text-on-surface transition-colors" data-path="member-dashboard" href="#">
<span class="material-symbols-outlined text-[17px] text-secondary">dashboard</span>
                Dashboard
              </a>
<a class="flex items-center gap-2 px-space-md py-space-sm rounded-lg font-body-sm text-body-sm text-on-surface-variant hover:bg-surface-container-highest hover:text-on-surface transition-colors" data-path="member-profile" href="#">
<span class="material-symbols-outlined text-[17px] text-primary">person</span>
                Profile &amp; Trophies
              </a>
<a class="flex items-center gap-2 px-space-md py-space-sm rounded-lg font-body-sm text-body-sm text-on-surface-variant hover:bg-surface-container-highest hover:text-on-surface transition-colors" data-path="saved-recipes" href="#">
<span class="material-symbols-outlined text-[17px] text-primary">bookmark</span>
                Saved Recipes (24)
              </a>
<div class="my-1 h-px bg-outline-variant/30"></div>
<a class="flex items-center gap-2 px-space-md py-space-sm rounded-lg font-body-sm text-body-sm text-error hover:bg-surface-container-highest transition-colors" data-path="logout" href="#">
<span class="material-symbols-outlined text-[17px]">logout</span>
                Logout
              </a>
</div>
</div>
</div>
</div>
</div>
<!-- Editorial Header Section -->
<section class="w-full px-margin-mobile lg:px-margin pt-space-xl pb-space-lg">
<div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md">
<div>
<div class="flex items-center gap-2 mb-2">
<span class="px-2.5 py-0.5 rounded-full text-label-sm font-label-sm uppercase tracking-wider bg-primary-container/20 text-primary flex items-center gap-1">
<span class="material-symbols-outlined text-[13px]" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
              VIP Tier Unlocked
            </span>
<span class="text-label-sm font-label-sm text-secondary">All Master Classes Accessible</span>
</div>
<h1 class="font-headline-xl text-headline-xl text-on-surface tracking-tight">Premium Recipes</h1>
<p class="font-body-md text-body-md text-on-surface-variant mt-1">
            Welcome back, Member • Exclusive recipes by Chef James and our master community
          </p>
</div>
<!-- KPI Pill Metric for Paid Member -->
<div class="hidden lg:flex items-center gap-space-lg px-space-lg py-space-sm rounded-2xl bg-surface-container/70 backdrop-blur-md">
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-primary text-[28px]" style="font-variation-settings: 'FILL' 1;">restaurant_menu</span>
<div class="flex flex-col">
<span class="font-headline-sm text-headline-sm text-on-surface leading-tight">48</span>
<span class="font-label-sm text-label-sm text-outline">Chef Masterpieces</span>
</div>
</div>
<div class="w-px h-8 bg-surface-container-highest"></div>
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-secondary text-[28px]">lock_open</span>
<div class="flex flex-col">
<span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary font-semibold">100% Unlocked</span>
<span class="font-label-sm text-label-sm text-outline">Unlimited Access</span>
</div>
</div>
</div>
</div>
</section>
<!-- Top Controls & Interactive Filter Bar -->
<section class="w-full px-margin-mobile lg:px-margin pb-space-lg">
<div class="p-space-md lg:p-space-lg rounded-2xl bg-surface-container/85 backdrop-blur-xl shadow-lg flex flex-col gap-space-md">
<!-- Row 1: Search + Access Filter + Sort -->
<div class="grid grid-cols-1 md:grid-cols-12 gap-space-md items-center">
<!-- Search Input with Clear Action -->
<div class="md:col-span-6 relative">
<span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-[20px] text-outline pointer-events-none">search</span>
<input class="w-full pl-11 pr-10 py-2.5 rounded-xl bg-surface-container-lowest text-on-surface placeholder:text-outline font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary/40 transition-all" id="recipe-search" placeholder="Search master ingredients, technique, or spice blend..." type="text" value="Truffle Infusions"/>
<button aria-label="Clear Search" class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface transition-colors p-1" id="clear-search" onclick="document.getElementById('recipe-search').value=''; this.classList.add('hidden');">
<span class="material-symbols-outlined text-[18px]">close</span>
</button>
</div>
<!-- Access Filter Toggle (All | Premium [Active] | Free) -->
<div class="md:col-span-3 flex items-center justify-start md:justify-center">
<div class="inline-flex p-1 rounded-full bg-surface-container-lowest text-label-md font-label-md">
<button class="px-3.5 py-1.5 rounded-full text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer">
                All
              </button>
<button class="px-4 py-1.5 rounded-full bg-primary-container text-surface-container-lowest font-semibold flex items-center gap-1 shadow-sm transition-all cursor-pointer">
<span class="material-symbols-outlined text-[13px]" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
                Premium
              </button>
<button class="px-3.5 py-1.5 rounded-full text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer">
                Free
              </button>
</div>
</div>
<!-- Sort Dropdown -->
<div class="md:col-span-3 flex justify-end">
<div class="relative w-full md:w-auto min-w-[180px]">
<select class="w-full appearance-none pl-3.5 pr-10 py-2.5 rounded-xl bg-surface-container-lowest text-on-surface font-title-md text-title-md cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary/40">
<option selected="" value="top-rated">Sort: Top Rated</option>
<option value="newest">Sort: Newest First</option>
<option value="fastest-prep">Sort: Fastest Prep</option>
<option value="difficulty">Sort: Difficulty Level</option>
</select>
<span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-[20px] text-outline pointer-events-none">expand_more</span>
</div>
</div>
</div>
<!-- Row 2: Category Chips & Count Indicator -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm pt-space-xs">
<!-- Category Chips -->
<div class="flex flex-wrap items-center gap-2">
<!-- All (Active) -->
<button class="px-4 py-1.5 rounded-full bg-primary-container/20 text-primary font-title-md text-title-md cursor-pointer flex items-center gap-1.5 shadow-sm">
<span>All Specialties</span>
<span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
</button>
<!-- Juices -->
<button class="px-3.5 py-1.5 rounded-full bg-surface-container-highest/60 hover:bg-surface-container-highest text-on-surface-variant hover:text-on-surface font-title-md text-title-md transition-colors cursor-pointer">
              Artisanal Juices
            </button>
<!-- Vegetarian -->
<button class="px-3.5 py-1.5 rounded-full bg-surface-container-highest/60 hover:bg-surface-container-highest text-on-surface-variant hover:text-on-surface font-title-md text-title-md transition-colors cursor-pointer">
              Vegetarian
            </button>
<!-- Non-Vegetarian -->
<button class="px-3.5 py-1.5 rounded-full bg-surface-container-highest/60 hover:bg-surface-container-highest text-on-surface-variant hover:text-on-surface font-title-md text-title-md transition-colors cursor-pointer">
              Non-Vegetarian
            </button>
<!-- Italian -->
<button class="px-3.5 py-1.5 rounded-full bg-surface-container-highest/60 hover:bg-surface-container-highest text-on-surface-variant hover:text-on-surface font-title-md text-title-md transition-colors cursor-pointer">
              Haute Italian
            </button>
</div>
<!-- Dynamic Results Count Label -->
<div class="text-label-md font-label-md text-secondary shrink-0 flex items-center gap-1.5">
<span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
            Showing 48 exclusive master recipes
          </div>
</div>
</div>
</section>
<!-- Recipe Grid: 8 Fully Unlocked, Crisp Recipe Cards in 4 Columns -->
<section class="w-full px-margin-mobile lg:px-margin pb-space-xl">
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-gutter">
@foreach(var recipe in Model) {
    var isLocked = !(User.Identity?.IsAuthenticated ?? false);
    var blurClass = isLocked ? "blur-sm pointer-events-none select-none opacity-80" : "";
<article class="group rounded-2xl bg-surface-container/75 backdrop-blur-md overflow-hidden hover:-translate-y-1.5 transition-all duration-300 shadow-md hover:shadow-2xl flex flex-col justify-between relative @blurClass">
<div class="relative w-full">
<div class="aspect-[16/11] w-full overflow-hidden relative">
<img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" data-alt="@recipe.Title" src="@recipe.ImagePath"/>
<div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/80 via-transparent to-black/25"></div>
</div>
<!-- Category & Premium Badges -->
<div class="absolute top-3 left-3 flex items-center gap-1.5">
<span class="px-2.5 py-1 rounded-full text-label-sm font-label-sm uppercase bg-surface-container-lowest/90 backdrop-blur-md text-secondary">
                @recipe.Category.Name
              </span>
<span class="px-2.5 py-1 rounded-full text-label-sm font-label-sm uppercase bg-primary-container text-surface-container-lowest font-bold flex items-center gap-1 shadow-sm">
<span class="material-symbols-outlined text-[13px]" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
                Premium
              </span>
</div>
<!-- Member Bookmark Toggle -->
<button aria-label="Save Recipe" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-surface-container-lowest/80 backdrop-blur-md flex items-center justify-center text-primary hover:scale-110 transition-transform cursor-pointer">
<span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">bookmark</span>
</button>
</div>
<div class="p-space-md flex flex-col flex-1 justify-between gap-space-sm">
<div>
<div class="flex items-center gap-2 mb-2">
<span class="font-label-sm text-label-sm text-on-surface-variant flex items-center gap-1">
                  By @recipe.Author.FullName
</span>
</div>
<h2 class="font-headline-sm text-headline-sm text-on-surface line-clamp-1 group-hover:text-primary transition-colors">
                @recipe.Title
              </h2>
<p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2 mt-1">
                @recipe.Procedure.Substring(0, Math.Min(recipe.Procedure.Length, 80))...
              </p>
</div>
<div class="pt-space-sm flex flex-col gap-space-sm">
<div class="flex items-center justify-between text-label-sm font-label-sm text-outline">
<span class="flex items-center gap-1">
<span class="material-symbols-outlined text-[16px] text-secondary">schedule</span>
                  @recipe.PrepMinutes mins prep • @recipe.CookMinutes mins cook
                </span>
<span class="flex items-center gap-1 font-semibold text-primary">
<span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">star</span>
                  5.0 <span class="text-outline font-normal">(0)</span>
</span>
</div>
<a class="w-full py-2.5 rounded-full bg-primary-container text-surface-container-lowest font-title-md text-title-md font-semibold text-center hover:bg-primary shadow-[0_4px_16px_rgba(217,138,86,0.25)] hover:shadow-[0_6px_20px_rgba(217,138,86,0.35)] transition-all flex items-center justify-center gap-1.5" href="/Recipe/Details/@recipe.Id">
<span>View Recipe</span>
<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</a>
</div>
</div>
</article>
}
<!-- Centered Pagination Controls -->
<section class="w-full pb-space-xl flex justify-center items-center">
<nav aria-label="Recipe Pagination" class="inline-flex items-center gap-1.5 p-1.5 rounded-full bg-surface-container-high/90 backdrop-blur-xl shadow-lg">
<!-- Previous Page -->
<button aria-label="Previous Page" class="w-9 h-9 rounded-full flex items-center justify-center text-outline hover:text-on-surface hover:bg-surface-container-highest transition-colors cursor-pointer">
<span class="material-symbols-outlined text-[18px]">chevron_left</span>
</button>
<!-- Page Numbers -->
<button class="w-9 h-9 rounded-full bg-primary-container text-surface-container-lowest font-title-md text-title-md font-bold flex items-center justify-center shadow-sm">
          1
        </button>
<button class="w-9 h-9 rounded-full text-on-surface-variant hover:text-on-surface hover:bg-surface-container-highest font-title-md text-title-md flex items-center justify-center transition-colors cursor-pointer">
          2
        </button>
<button class="w-9 h-9 rounded-full text-on-surface-variant hover:text-on-surface hover:bg-surface-container-highest font-title-md text-title-md flex items-center justify-center transition-colors cursor-pointer">
          3
        </button>
<span class="w-7 text-center font-title-md text-outline">...</span>
<button class="w-9 h-9 rounded-full text-on-surface-variant hover:text-on-surface hover:bg-surface-container-highest font-title-md text-title-md flex items-center justify-center transition-colors cursor-pointer">
          6
        </button>
<!-- Next Page -->
<button aria-label="Next Page" class="w-9 h-9 rounded-full flex items-center justify-center text-on-surface-variant hover:text-on-surface hover:bg-surface-container-highest transition-colors cursor-pointer">
<span class="material-symbols-outlined text-[18px]">chevron_right</span>
</button>
</nav>
</section>
</div>
<!-- Floating Member Action Button: Add Recipe (+ Submit) -->
<div class="fixed bottom-6 right-6 z-40">
<a class="group inline-flex items-center gap-2 pl-4 pr-5 py-3 rounded-full bg-primary-container hover:bg-primary text-surface-container-lowest font-title-md text-title-md font-semibold shadow-[0_6px_28px_rgba(217,138,86,0.45)] hover:shadow-[0_8px_32px_rgba(217,138,86,0.6)] hover:scale-105 active:scale-95 transition-all" data-path="submit-recipe" href="#">
<span class="material-symbols-outlined text-[22px] group-hover:rotate-90 transition-transform duration-300">add</span>
<span>Add Recipe</span>
</a>
</div>
</div>
