<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>@ViewData["Title"] - Dashboard - JamesThew.com</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true"/>
    <link rel="shortcut icon" href="~/favicon.ico" asp-append-version="true"/>
    <style>
        @@layer base {
            html, body { margin: 0; padding: 0; }
            body { overscroll-behavior: none; }
            main > :first-child { margin-top: 0 !important; }
            main > :last-child { margin-bottom: 0 !important; }
        }
        ::-webkit-scrollbar { display: none; }
    </style>
    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "on-secondary-fixed": "#002113", "tertiary-fixed": "#c0ecdd", "on-secondary": "#003824", "on-tertiary-fixed-variant": "#254e43", "on-error": "#690005", "primary-fixed": "#ffdbc8", "surface-container-low": "#02201c", "on-primary-container": "#572700", "secondary-fixed-dim": "#9ad3b3", "secondary-container": "#1b533a", "primary-container": "#d98a56", "primary-fixed-dim": "#ffb689", "surface-variant": "#1d3a35", "surface": "#001714", "on-surface-variant": "#d9c2b6", "surface-dim": "#001714", "surface-tint": "#ffb689", "on-error-container": "#ffdad6", "inverse-primary": "#8e4d1f", "on-secondary-fixed-variant": "#185038", "on-primary-fixed-variant": "#713708", "on-background": "#c9e9e2", "inverse-on-surface": "#183531", "on-tertiary-fixed": "#002019", "on-secondary-container": "#8cc5a5", "inverse-surface": "#c9e9e2", "tertiary": "#a4d0c2", "tertiary-fixed-dim": "#a4d0c2", "secondary-fixed": "#b5efce", "on-primary-fixed": "#311300", "on-tertiary-container": "#0f3b31", "surface-container-high": "#112f2b", "primary": "#ffb689", "secondary": "#9ad3b3", "outline": "#a18d82", "background": "#001714", "surface-container": "#052420", "on-surface": "#c9e9e2", "on-tertiary": "#0a372d", "surface-bright": "#223e3a", "tertiary-container": "#7ba598", "surface-container-lowest": "#00110f", "error-container": "#93000a", "surface-container-highest": "#1d3a35", "error": "#ffb4ab", "outline-variant": "#53443b", "on-primary": "#512300"
                    },
                    borderRadius: { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" },
                    spacing: { "margin-mobile": "1.25rem", "space-sm": "0.5rem", "space-md": "1rem", "space-xs": "0.25rem", "gutter": "1.5rem", "margin": "3rem", "space-xl": "2.5rem", "gutter-mobile": "1rem", "space-lg": "1.5rem" },
                    fontFamily: { "headline-xl-mobile": ["EB Garamond"], "headline-md": ["EB Garamond"], "headline-sm": ["EB Garamond"], "title-md": ["Inter"], "body-md": ["Inter"], "headline-lg": ["EB Garamond"], "label-md": ["Inter"], "title-lg": ["Inter"], "body-lg": ["Inter"], "label-sm": ["Inter"], "display-lg": ["EB Garamond"], "headline-xl": ["EB Garamond"], "body-sm": ["Inter"], "display-lg-mobile": ["EB Garamond"] },
                    fontSize: { "headline-xl-mobile": ["30px", {"lineHeight": "38px", "letterSpacing": "-0.01em", "fontWeight": "400"}], "headline-md": ["26px", {"lineHeight": "34px", "fontWeight": "500"}], "headline-sm": ["22px", {"lineHeight": "28px", "fontWeight": "600"}], "title-md": ["16px", {"lineHeight": "24px", "fontWeight": "600"}], "body-md": ["15px", {"lineHeight": "24px", "fontWeight": "400"}], "headline-lg": ["32px", {"lineHeight": "40px", "fontWeight": "500"}], "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.04em", "fontWeight": "600"}], "title-lg": ["18px", {"lineHeight": "26px", "letterSpacing": "-0.01em", "fontWeight": "600"}], "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}], "label-sm": ["11px", {"lineHeight": "14px", "letterSpacing": "0.05em", "fontWeight": "500"}], "display-lg": ["56px", {"lineHeight": "64px", "letterSpacing": "-0.02em", "fontWeight": "400"}], "headline-xl": ["40px", {"lineHeight": "48px", "letterSpacing": "-0.015em", "fontWeight": "400"}], "body-sm": ["13px", {"lineHeight": "20px", "fontWeight": "400"}], "display-lg-mobile": ["38px", {"lineHeight": "46px", "letterSpacing": "-0.01em", "fontWeight": "400"}] }
                }
            }
        };
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@100..900&family=Inter:wght@100..900&display=swap" rel="stylesheet"/>
</head>
<body class="bg-surface font-body text-on-surface">
    <aside class="fixed left-0 top-0 h-full w-64 bg-[#0A211E] z-50 flex flex-col pt-6 pb-8 overflow-y-auto">
        <div class="px-6 mb-8 flex items-center justify-between">
            <a asp-controller="Home" asp-action="Index" class="flex items-center hover:opacity-90 transition-opacity" title="Back to JamesThew.com">
                <img alt="JamesThew.com" class="h-9 w-auto object-contain" src="~/images/logo.png" asp-append-version="true" />
            </a>
        </div>
        <nav class="flex-1 px-4 space-y-1">
            <a class="flex items-center px-4 py-3 rounded-xl text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all mb-2" asp-controller="Home" asp-action="Index">
                <span class="material-symbols-outlined mr-3 text-[20px]">arrow_back</span>Public Website
            </a>
            <a class="flex items-center px-4 py-3 rounded-xl transition-all hover:bg-primary-container hover:text-on-primary-container" asp-controller="Dashboard" asp-action="Index">
                <span class="material-symbols-outlined mr-3 text-[20px]">dashboard</span>Overview
            </a>
            <a class="flex items-center px-4 py-3 rounded-xl text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all" asp-controller="Dashboard" asp-action="MyRecipes">
                <span class="material-symbols-outlined mr-3 text-[20px]">menu_book</span>My Recipes
            </a>
            <a class="flex items-center px-4 py-3 rounded-xl text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all" asp-controller="Dashboard" asp-action="AddRecipe">
                <span class="material-symbols-outlined mr-3 text-[20px]">add_circle</span>Add Recipe
            </a>
            <a class="flex items-center px-4 py-3 rounded-xl text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all" asp-controller="Dashboard" asp-action="MyTips">
                <span class="material-symbols-outlined mr-3 text-[20px]">lightbulb</span>My Tips
            </a>
            <a class="flex items-center px-4 py-3 rounded-xl text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all" asp-controller="Dashboard" asp-action="AddTip">
                <span class="material-symbols-outlined mr-3 text-[20px]">note_add</span>Add Tip
            </a>
            <a class="flex items-center px-4 py-3 rounded-xl text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all" asp-controller="Dashboard" asp-action="MyEntries">
                <span class="material-symbols-outlined mr-3 text-[20px]">military_tech</span>My Contest Entries
            </a>
            <a class="flex items-center px-4 py-3 rounded-xl text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all" asp-controller="Dashboard" asp-action="Subscription">
                <span class="material-symbols-outlined mr-3 text-[20px]">card_membership</span>Subscription
            </a>
            <a class="flex items-center px-4 py-3 rounded-xl text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all" asp-controller="Dashboard" asp-action="Profile">
                <span class="material-symbols-outlined mr-3 text-[20px]">settings</span>Profile Settings
            </a>
            <a class="flex items-center px-4 py-3 rounded-xl text-on-surface-variant hover:bg-error-container hover:text-on-error-container transition-all mt-6" asp-controller="Auth" asp-action="Logout">
                <span class="material-symbols-outlined mr-3 text-[20px]">logout</span>Logout
            </a>
        </nav>
    </aside>

    <div class="pl-64">
        <header class="fixed top-0 left-64 right-0 h-16 bg-surface/80 backdrop-blur-xl z-40 flex items-center justify-between px-8 shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
            <div class="flex items-center gap-4">
                <h1 class="text-headline-sm font-headline text-on-surface">@ViewData["Title"]</h1>
            </div>
            <div class="flex items-center gap-4">
                <div class="relative flex items-center">
                    <span class="material-symbols-outlined absolute left-3 text-on-surface-variant text-[18px]">search</span>
                    <input class="w-64 bg-[#0A211E] text-on-surface placeholder:text-on-surface-variant text-body-sm rounded-xl pl-9 pr-4 py-2 border border-outline-variant focus:outline-none focus:border-primary transition-all" placeholder="Search culinary archive..." type="text"/>
                </div>
                <button class="w-10 h-10 rounded-xl bg-[#0A211E] border border-outline-variant flex items-center justify-center text-on-surface-variant hover:text-on-surface hover:border-primary transition-all">
                    <span class="material-symbols-outlined text-[20px]">notifications</span>
                </button>
                <a asp-controller="Dashboard" asp-action="Profile" class="flex items-center gap-2 text-on-surface hover:text-primary transition-colors cursor-pointer" title="Profile Settings">
                    <span class="text-body-sm font-semibold hidden md:inline text-on-surface">@User.Identity?.Name</span>
                    <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center">
                        <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
                    </div>
                </a>
            </div>
        </header>
        
        <main class="relative pt-16 bg-[#0C2A26] min-h-screen px-margin py-margin">
            <div class="flex flex-col w-full">
                @RenderBody()
            </div>
        </main>
    </div>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
