<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JamesThew.com Dashboard</title>
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JamesThew.Web.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <partial name="_MemberNavbar" />
    </header>
    <main role="main" class="flex-shrink-0 container py-4">
        <div class="row">
            <div class="col-lg-3 mb-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h5 class="font-heading mb-3 text-cream">Member Menu</h5>
                        <ul class="nav flex-column">
                            <li class="nav-item">
                                <a class="nav-link text-cream d-flex align-items-center gap-2" href="/Account/Dashboard">
                                    <span class="material-symbols-outlined fs-5">dashboard</span> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-cream d-flex align-items-center gap-2" href="/Recipe/Saved">
                                    <span class="material-symbols-outlined fs-5">bookmark</span> Saved Recipes
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-cream d-flex align-items-center gap-2" href="/Contest/MyEntries">
                                    <span class="material-symbols-outlined fs-5">emoji_events</span> My Contests
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-cream d-flex align-items-center gap-2" href="/Account/Profile">
                                    <span class="material-symbols-outlined fs-5">person</span> Profile
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-lg-9">
                @RenderBody()
            </div>
        </div>
    </main>
    <partial name="_Footer" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
