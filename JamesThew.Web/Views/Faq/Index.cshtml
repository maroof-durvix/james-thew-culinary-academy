@{
    ViewData["Title"] = "FAQ";
}

<div class="flex flex-col w-full">
<div class="relative w-full overflow-hidden px-margin-mobile lg:px-margin py-space-xl">
<!-- Ambient Atmospheric Glows -->
<div class="pointer-events-none absolute top-12 left-1/4 w-[520px] h-[340px] bg-primary/10 rounded-full blur-[140px] -z-10"></div>
<div class="pointer-events-none absolute top-40 right-1/4 w-[460px] h-[400px] bg-secondary-container/20 rounded-full blur-[160px] -z-10"></div>
<div class="max-w-5xl mx-auto flex flex-col gap-space-xl">
<!-- Breadcrumbs -->
<nav aria-label="Breadcrumb" class="flex items-center gap-space-xs text-on-surface-variant font-label-md text-label-md tracking-wider uppercase">
<a class="hover:text-primary transition-colors" data-path="home" href="#">Home</a>
<span class="material-symbols-outlined text-[14px] text-outline">chevron_right</span>
<span class="hover:text-primary transition-colors cursor-default">Help</span>
<span class="material-symbols-outlined text-[14px] text-outline">chevron_right</span>
<span class="text-primary font-semibold">FAQ</span>
</nav>
<!-- Page Header -->
<div class="flex flex-col gap-space-sm max-w-3xl">
<div class="inline-flex items-center gap-space-xs text-primary font-label-md text-label-md tracking-widest uppercase">
<span class="w-1.5 h-1.5 rounded-full bg-primary-container"></span>
          Knowledge Base &amp; Guidance
        </div>
<h1 class="font-display-lg text-display-lg text-on-surface tracking-tight font-headline-xl">
          Frequently Asked Questions
        </h1>
<p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
          Everything you need to know about membership tiers, recipes, tip exchanges, contest rules, and academy access.
        </p>
</div>
<!-- Search & Filters Container -->
<div class="flex flex-col gap-space-md p-space-md lg:p-space-lg rounded-[18px] bg-surface-container/70 backdrop-blur-xl shadow-xl">
<!-- Search Input -->
<div class="relative w-full">
<span class="material-symbols-outlined absolute left-space-md top-1/2 -translate-y-1/2 text-outline text-[22px] pointer-events-none">search</span>
<input class="w-full pl-12 pr-space-md py-space-sm rounded-xl bg-surface-container-lowest text-on-surface placeholder:text-outline font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary-container/40 transition-all shadow-inner" id="faq-search" placeholder="Search questions, membership rules, contest policies..." type="text"/>
</div>
<!-- Filter Category Chips -->
<div class="flex flex-wrap items-center gap-space-xs pt-space-xs" id="filter-container">
<button class="filter-pill active px-space-md py-1.5 rounded-full font-label-md text-label-md tracking-wide cursor-pointer transition-all bg-primary-container/20 text-primary" data-filter="all" type="button">
            All Questions
          </button>
<button class="filter-pill px-space-md py-1.5 rounded-full font-label-md text-label-md tracking-wide cursor-pointer transition-all bg-surface-container-highest/60 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-highest" data-filter="membership" type="button">
            Membership &amp; Pricing
          </button>
<button class="filter-pill px-space-md py-1.5 rounded-full font-label-md text-label-md tracking-wide cursor-pointer transition-all bg-surface-container-highest/60 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-highest" data-filter="recipes" type="button">
            Recipes &amp; Tips
          </button>
<button class="filter-pill px-space-md py-1.5 rounded-full font-label-md text-label-md tracking-wide cursor-pointer transition-all bg-surface-container-highest/60 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-highest" data-filter="contests" type="button">
