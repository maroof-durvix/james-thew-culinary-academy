<!-- Question 6 -->
<div class="faq-item rounded-[18px] bg-surface-container/60 backdrop-blur-md overflow-hidden transition-all shadow-md group" data-category="feedback">
<button aria-expanded="false" class="faq-trigger w-full flex items-center justify-between p-space-lg text-left gap-space-md cursor-pointer transition-colors" type="button">
<span class="flex items-center gap-space-md min-w-0">
<span class="faq-number font-headline-sm text-headline-sm text-outline shrink-0">06</span>
<span class="font-headline-sm text-headline-sm text-on-surface tracking-normal group-hover:text-primary transition-colors">
                How to post a feedback?
              </span>
</span>
<span class="faq-icon material-symbols-outlined text-outline text-[24px] shrink-0 transition-transform duration-300">
              expand_more
            </span>
</button>
<div class="faq-content hidden px-space-lg pb-space-lg pt-0 text-on-surface-variant font-body-md text-body-md leading-relaxed">
<p class="max-w-3xl">
              You can post recipe feedback and tasting notes directly on each individual recipe page under the ‘Community Feedback’ section. For overall website suggestions, academy queries, or general observations, please use our dedicated Give Feedback page.
            </p>
</div>
</div>
<!-- Question 7 -->
<div class="faq-item rounded-[18px] bg-surface-container/60 backdrop-blur-md overflow-hidden transition-all shadow-md group" data-category="contests">
<button aria-expanded="false" class="faq-trigger w-full flex items-center justify-between p-space-lg text-left gap-space-md cursor-pointer transition-colors" type="button">
<span class="flex items-center gap-space-md min-w-0">
<span class="faq-number font-headline-sm text-headline-sm text-outline shrink-0">07</span>
<span class="font-headline-sm text-headline-sm text-on-surface tracking-normal group-hover:text-primary transition-colors">
                I have posted a recipe or a tip with respect to the contest. How can I know who is the winner?
              </span>
</span>
<span class="faq-icon material-symbols-outlined text-outline text-[24px] shrink-0 transition-transform duration-300">
              expand_more
            </span>
</button>
<div class="faq-content hidden px-space-lg pb-space-lg pt-0 text-on-surface-variant font-body-md text-body-md leading-relaxed">
<p class="max-w-3xl">
              Contest winners are officially announced on the Announcements page and archived in Past Winners following comprehensive review and adjudication by Chef James Thew and the executive tasting panel. Winners are also notified via their registered contact email.
            </p>
</div>
</div>
</div>
<!-- Bottom Card: Still have questions? -->
<div class="relative overflow-hidden rounded-[18px] bg-surface-container-high/90 p-space-xl backdrop-blur-xl shadow-2xl">
<!-- Subtle copper rim background tint -->
<div class="absolute inset-0 bg-gradient-to-r from-primary-container/10 via-transparent to-primary/5 pointer-events-none"></div>
<div class="relative flex flex-col md:flex-row items-start md:items-center justify-between gap-space-lg">
<div class="flex flex-col gap-space-xs max-w-xl">
<span class="font-headline-sm text-headline-sm text-on-surface">
              Still have questions?
            </span>
<p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
              Can't find the answer you're looking for? Reach out directly to our academy support desk and concierge.
            </p>
</div>
<div class="flex items-center flex-wrap gap-space-md shrink-0">
<a class="inline-flex items-center justify-center px-space-xl py-space-sm rounded-full bg-primary-container text-surface-container-lowest font-title-md text-title-md shadow-[0_4px_16px_rgba(217,138,86,0.25)] hover:bg-primary hover:shadow-[0_6px_24px_rgba(217,138,86,0.4)] transition-all cursor-pointer" data-path="contact-us" href="#">
              Contact Us
            </a>
<a class="inline-flex items-center justify-center px-space-lg py-space-sm rounded-full bg-surface-container-highest/60 text-on-surface font-title-md text-title-md hover:bg-surface-container-highest hover:text-primary transition-all cursor-pointer" data-path="give-feedback" href="#">
              Give Feedback
            </a>
</div>
</div>
</div>
</div>
</div>
</div>
<script>
  (function () {
    const triggers = document.querySelectorAll('.faq-trigger');
    const searchInput = document.getElementById('faq-search');
    const filterPills = document.querySelectorAll('.filter-pill');
    const faqItems = document.querySelectorAll('.faq-item');

    // Accordion Toggle Logic
    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const item = trigger.closest('.faq-item');
        const content = item.querySelector('.faq-content');
        const icon = item.querySelector('.faq-icon');
        const number = item.querySelector('.faq-number');
        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

        if (isExpanded) {
          trigger.setAttribute('aria-expanded', 'false');
          content.classList.add('hidden');
          icon.classList.remove('rotate-180', 'text-primary');
          icon.classList.add('text-outline');
          number.classList.remove('text-primary-container');
          number.classList.add('text-outline');
        } else {
          trigger.setAttribute('aria-expanded', 'true');
          content.classList.remove('hidden');
          icon.classList.add('rotate-180', 'text-primary');
          icon.classList.remove('text-outline');
          number.classList.add('text-primary-container');
          number.classList.remove('text-outline');
        }
      });
    });

    // Filtering & Search Combine
    let currentFilter = 'all';

    function applyFilters() {
      const query = (searchInput.value || '').toLowerCase().trim();

      faqItems.forEach((item) => {
        const category = item.getAttribute('data-category');
        const questionText = item.querySelector('.faq-trigger')?.innerText.toLowerCase() || '';
        const answerText = item.querySelector('.faq-content')?.innerText.toLowerCase() || '';

        const matchesCategory = currentFilter === 'all' || category === currentFilter;
        const matchesQuery = !query || questionText.includes(query) || answerText.includes(query);

        if (matchesCategory && matchesQuery) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', applyFilters);
    }

    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        filterPills.forEach((p) => {
          p.classList.remove('active', 'bg-primary-container/20', 'text-primary');
          p.classList.add('bg-surface-container-highest/60', 'text-on-surface-variant');
        });
        pill.classList.remove('bg-surface-container-highest/60', 'text-on-surface-variant');
        pill.classList.add('active', 'bg-primary-container/20', 'text-primary');

        currentFilter = pill.getAttribute('data-filter');
        applyFilters();
      });
    });
  })();
</script>
