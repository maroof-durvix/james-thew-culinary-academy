@model IEnumerable<JamesThew.Web.Models.Entities.Recipe>
@{
    ViewData["Title"] = "Premium Master Recipes - James Thew VIP";
    var categories = ViewBag.Categories as IEnumerable<JamesThew.Web.Models.Entities.Category> ?? new List<JamesThew.Web.Models.Entities.Category>();
    var selectedCat = ViewBag.SelectedCategory as string ?? "All";
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    bool isMember = ViewBag.IsMember ?? false;
    bool isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
    var recipeCount = Model?.Count() ?? 0;
}

<!-- Subtle Ambient Glow -->
<div class="relative w-full overflow-hidden">
  <div class="absolute -top-32 left-1/4 w-96 h-96 bg-primary-container/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-20 right-10 w-80 h-80 bg-secondary/10 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Authenticated Member Utility Sub-Nav -->
  <div class="w-full bg-surface-container-lowest/70 backdrop-blur-md px-margin-mobile lg:px-margin py-space-sm flex items-center justify-between">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-space-xs text-label-sm font-label-sm">
      <a class="text-on-surface-variant hover:text-primary transition-colors" asp-controller="Home" asp-action="Index">Home</a>
      <span class="text-outline/40">/</span>
      <a class="text-on-surface-variant hover:text-primary transition-colors" asp-controller="Recipes" asp-action="Free">Recipes</a>
      <span class="text-outline/40">/</span>
      <span class="text-primary font-medium">Premium Recipes</span>
    </nav>

    <!-- Member Session Indicators -->
    <div class="flex items-center gap-space-md">
      @if (isMember)
      {
        <span class="px-2.5 py-0.5 rounded-full text-label-sm font-label-sm uppercase tracking-wider bg-primary-container/20 text-primary flex items-center gap-1">
          <span class="material-symbols-outlined text-[13px]" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
          VIP Pass Active
        </span>
      }
      else if (isAuthenticated)
      {
        <a asp-controller="Plans" asp-action="Index" class="px-3 py-1 rounded-full text-label-sm font-label-sm uppercase tracking-wider bg-primary-container text-surface-container-lowest font-semibold hover:bg-primary transition-all">
          Upgrade to Access
        </a>
      }
      else
      {
        <a asp-controller="Auth" asp-action="Register" class="px-3 py-1 rounded-full text-label-sm font-label-sm uppercase tracking-wider bg-primary-container text-surface-container-lowest font-semibold hover:bg-primary transition-all">
          Register to Access
        </a>
      }
    </div>
  </div>

  <!-- Editorial Header Section -->
  <section class="w-full px-margin-mobile lg:px-margin pt-space-xl pb-space-lg">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="px-2.5 py-0.5 rounded-full text-label-sm font-label-sm uppercase tracking-wider bg-primary-container/20 text-primary flex items-center gap-1">
            <span class="material-symbols-outlined text-[13px]" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
            @(isMember ? "VIP Tier Unlocked" : "Members Only Vault")
          </span>
          <span class="text-label-sm font-label-sm text-secondary">All Master Classes & Reserve Recipes</span>
        </div>
        <h1 class="font-headline-xl text-headline-xl text-on-surface tracking-tight">Premium Recipes</h1>
        <p class="font-body-md text-body-md text-on-surface-variant mt-1">
          Exclusive culinary creations by Chef James and verified gourmet master contributors.
        </p>
      </div>

      <!-- KPI Pill Metric -->
      <div class="hidden lg:flex items-center gap-space-lg px-space-lg py-space-sm rounded-2xl bg-surface-container/70 backdrop-blur-md">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-primary text-[28px]" style="font-variation-settings: 'FILL' 1;">restaurant_menu</span>
          <div class="flex flex-col">
            <span class="font-headline-sm text-headline-sm text-on-surface leading-tight">@recipeCount</span>
            <span class="font-label-sm text-label-sm text-outline">Masterpieces</span>
          </div>
        </div>
        <div class="w-px h-8 bg-surface-container-highest"></div>
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-secondary text-[28px]">@(isMember ? "lock_open" : "lock")</span>
          <div class="flex flex-col">
            <span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary font-semibold">
              @(isMember ? "100% Unlocked" : "VIP Subscription")
            </span>
            <span class="font-label-sm text-label-sm text-outline">
              @(isMember ? "Unlimited Access" : "Subscribe to View")
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  @if (!isMember)
  {
    <section class="w-full px-margin-mobile lg:px-margin mb-space-lg">
      <div class="p-space-lg rounded-2xl bg-gradient-to-r from-primary-container/20 via-surface-container-high to-surface-container border border-primary-container/30 flex flex-col md:flex-row items-center justify-between gap-space-md shadow-xl">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-full bg-primary-container/20 flex items-center justify-center text-primary shrink-0">
            <span class="material-symbols-outlined text-[28px]" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
          </div>
          <div>
            <h3 class="font-headline-sm text-headline-sm text-on-surface">You are browsing the VIP Catalog in Preview Mode</h3>
            <p class="font-body-sm text-on-surface-variant">Upgrade your account to a full Member subscription ($10/mo or $100/yr) to unlock ingredients, secret cooking procedures, and direct feedback channels.</p>
          </div>
        </div>
        @if (isAuthenticated)
        {
          <a asp-controller="Plans" asp-action="Index" class="shrink-0 px-space-xl py-3 rounded-full bg-primary-container text-surface-container-lowest font-title-md text-title-md hover:bg-primary transition-all shadow-[0_4px_16px_rgba(217,138,86,0.3)]">
            Upgrade Now
          </a>
        }
        else
        {
          <a asp-controller="Auth" asp-action="Register" class="shrink-0 px-space-xl py-3 rounded-full bg-primary-container text-surface-container-lowest font-title-md text-title-md hover:bg-primary transition-all shadow-[0_4px_16px_rgba(217,138,86,0.3)]">
            Register to Unlock
          </a>
        }
      </div>
    </section>
  }

  <!-- Filter & Search Toolbar -->
  <section class="w-full px-margin-mobile lg:px-margin pb-space-lg">
    <div class="p-space-md lg:p-space-lg rounded-2xl bg-surface-container/85 backdrop-blur-xl shadow-lg flex flex-col gap-space-md">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-space-md items-center">
        <!-- Search Input -->
        <form method="get" asp-action="Premium" class="md:col-span-8 relative">
          <input type="hidden" name="category" value="@selectedCat" />
          <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-[20px] text-outline pointer-events-none">search</span>
          <input name="search" value="@searchTerm" class="w-full pl-11 pr-10 py-2.5 rounded-xl bg-surface-container-lowest text-on-surface placeholder:text-outline font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary/40 transition-all" placeholder="Search master ingredients, technique, or formula..." type="text" />
        </form>

        <!-- Access Filter Toggle (Free / Premium) -->
        <div class="md:col-span-4 flex items-center justify-start md:justify-end">
          <div class="inline-flex p-1 rounded-full bg-surface-container-lowest text-label-md font-label-md">
            <a asp-action="Free" class="px-3.5 py-1.5 rounded-full text-on-surface-variant hover:text-on-surface transition-colors">
              Free Recipes
            </a>
            <span class="px-4 py-1.5 rounded-full bg-primary-container text-surface-container-lowest font-semibold flex items-center gap-1 shadow-sm">
              <span class="material-symbols-outlined text-[13px]" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
              Premium
            </span>
          </div>
        </div>
      </div>

      <!-- Category Chips -->
      <div class="flex flex-wrap items-center gap-2 pt-space-xs">
        <a href="@Url.Action("Premium", "Recipes", new { category = "All", search = searchTerm })"
           class="px-4 py-1.5 rounded-full font-title-md text-title-md transition-all @(selectedCat == "All" || string.IsNullOrEmpty(selectedCat) ? "bg-primary-container text-surface-container-lowest shadow-sm" : "bg-surface-container-highest/60 hover:bg-surface-container-highest text-on-surface-variant hover:text-on-surface")">
          All Specialties
        </a>
        @foreach (var cat in categories)
        {
          <a href="@Url.Action("Premium", "Recipes", new { category = cat.Name, search = searchTerm })"
             class="px-3.5 py-1.5 rounded-full font-title-md text-title-md transition-all @(selectedCat == cat.Name ? "bg-primary-container text-surface-container-lowest shadow-sm" : "bg-surface-container-highest/60 hover:bg-surface-container-highest text-on-surface-variant hover:text-on-surface")">
            @cat.Name
          </a>
        }
      </div>
    </div>
  </section>

  <!-- Recipe Grid -->
  <section class="w-full px-margin-mobile lg:px-margin pb-space-xl">
    @if (Model != null && Model.Any())
    {
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-gutter">
        @foreach (var recipe in Model)
        {
          var avgRating = recipe.Feedbacks != null && recipe.Feedbacks.Any() ? recipe.Feedbacks.Average(f => f.Rating).ToString("0.00") : "4.95";
          var imgUrl = !string.IsNullOrEmpty(recipe.ImagePath) ? recipe.ImagePath : "/images/recipe-1.jpg";

          <article class="group rounded-2xl bg-surface-container/75 backdrop-blur-md overflow-hidden hover:-translate-y-1.5 transition-all duration-300 shadow-md hover:shadow-2xl flex flex-col justify-between">
            <div class="relative w-full">
              @if (isMember)
              {
                <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipe.Id" class="block aspect-[16/11] w-full overflow-hidden relative bg-surface-container-highest cursor-pointer">
                  <img src="@imgUrl" alt="@recipe.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.src='/images/recipe-1.jpg'" />
                  <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/80 via-transparent to-black/25 pointer-events-none"></div>
                </a>
              }
              else if (!isAuthenticated)
              {
                <a asp-controller="Auth" asp-action="Register" class="block aspect-[16/11] w-full overflow-hidden relative bg-surface-container-highest cursor-pointer">
                  <img src="@imgUrl" alt="@recipe.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.src='/images/recipe-1.jpg'" />
                  <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/80 via-transparent to-black/25 pointer-events-none"></div>
                </a>
              }
              else
              {
                <a asp-controller="Plans" asp-action="Index" class="block aspect-[16/11] w-full overflow-hidden relative bg-surface-container-highest cursor-pointer">
                  <img src="@imgUrl" alt="@recipe.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.src='/images/recipe-1.jpg'" />
                  <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/80 via-transparent to-black/25 pointer-events-none"></div>
                </a>
              }

              <!-- Category & Premium Badges -->
              <div class="absolute top-3 left-3 flex items-center gap-1.5 pointer-events-none">
                <span class="px-2.5 py-1 rounded-full text-label-sm font-label-sm uppercase bg-surface-container-lowest/90 backdrop-blur-md text-secondary">
                  @(recipe.Category?.Name ?? "Specialty")
                </span>
                <span class="px-2.5 py-1 rounded-full text-label-sm font-label-sm uppercase bg-primary-container text-surface-container-lowest font-bold flex items-center gap-1 shadow-sm">
                  <span class="material-symbols-outlined text-[13px]" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
                  VIP
                </span>
              </div>
            </div>

            <div class="p-space-md flex flex-col flex-1 justify-between gap-space-sm">
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <span class="font-label-sm text-label-sm text-on-surface-variant flex items-center gap-1">
                    By @(recipe.Author?.FullName ?? "Chef James Thew")
                    <span class="material-symbols-outlined text-[13px] text-primary" style="font-variation-settings: 'FILL' 1;">verified</span>
                  </span>
                </div>
                <h2 class="font-headline-sm text-headline-sm text-on-surface line-clamp-1 group-hover:text-primary transition-colors">
                  @if (isMember)
                  {
                    <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipe.Id">@recipe.Title</a>
                  }
                  else if (!isAuthenticated)
                  {
                    <a asp-controller="Auth" asp-action="Register">@recipe.Title</a>
                  }
                  else
                  {
                    <a asp-controller="Plans" asp-action="Index">@recipe.Title</a>
                  }
                </h2>
                <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2 mt-1">
                  @recipe.Procedure
                </p>
              </div>

              <div class="pt-space-sm flex flex-col gap-space-sm">
                <div class="flex items-center justify-between text-label-sm font-label-sm text-outline">
                  <span class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-[16px] text-secondary">schedule</span>
                    @(recipe.PrepMinutes)m prep • @(recipe.CookMinutes)m cook
                  </span>
                  <span class="flex items-center gap-1 font-semibold text-primary">
                    <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">star</span>
                    @avgRating
                  </span>
                </div>

                @if (isMember)
                {
                  <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipe.Id" class="w-full py-2.5 rounded-full bg-primary-container text-surface-container-lowest font-title-md text-title-md font-semibold text-center hover:bg-primary shadow-[0_4px_16px_rgba(217,138,86,0.25)] transition-all flex items-center justify-center gap-1.5">
                    <span>View Recipe</span>
                    <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                  </a>
                }
                else if (!isAuthenticated)
                {
                  <a asp-controller="Auth" asp-action="Register" class="w-full py-2.5 rounded-full bg-primary-container text-surface-container-lowest hover:bg-primary font-title-md text-title-md font-semibold text-center shadow-[0_4px_16px_rgba(217,138,86,0.25)] transition-all flex items-center justify-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px]">lock</span>
                    <span>Register to Unlock</span>
                  </a>
                }
                else
                {
                  <a asp-controller="Plans" asp-action="Index" class="w-full py-2.5 rounded-full bg-surface-container-highest text-on-surface hover:text-primary font-title-md text-title-md font-semibold text-center border border-primary-container/40 transition-all flex items-center justify-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px] text-primary">workspace_premium</span>
                    <span>Upgrade to Unlock</span>
                  </a>
                }
              </div>
            </div>
          </article>
        }
      </div>
    }
    else
    {
      <div class="py-16 text-center bg-surface-container/40 rounded-2xl border border-outline-variant/30 mb-space-xl p-space-lg">
        <span class="material-symbols-outlined text-5xl text-outline mb-2">workspace_premium</span>
        <h3 class="font-headline-sm text-headline-sm text-on-surface">No Premium Recipes Found</h3>
        <p class="font-body-sm text-on-surface-variant mt-1 max-w-md mx-auto">No premium master recipes match your current query.</p>
        <a asp-action="Premium" class="inline-block mt-4 px-space-lg py-2 rounded-full bg-primary-container text-surface-container-lowest font-title-md text-sm">Clear Filters</a>
      </div>
    }
  </section>

  <!-- Floating Member Action Button: Add Recipe -->
  <div class="fixed bottom-6 right-6 z-40">
    <a asp-controller="Dashboard" asp-action="AddRecipe" class="group inline-flex items-center gap-2 pl-4 pr-5 py-3 rounded-full bg-primary-container hover:bg-primary text-surface-container-lowest font-title-md text-title-md font-semibold shadow-[0_6px_28px_rgba(217,138,86,0.45)] hover:shadow-[0_8px_32px_rgba(217,138,86,0.6)] hover:scale-105 active:scale-95 transition-all">
      <span class="material-symbols-outlined text-[22px] group-hover:rotate-90 transition-transform duration-300">add</span>
      <span>Add Recipe</span>
    </a>
  </div>
</div>
