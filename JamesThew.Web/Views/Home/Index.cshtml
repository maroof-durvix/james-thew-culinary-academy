@{
    ViewData["Title"] = "Master Culinary Arts - Chef James Thew";
    var featuredRecipes = ViewBag.FeaturedRecipes as IEnumerable<JamesThew.Web.Models.Entities.Recipe> ?? new List<JamesThew.Web.Models.Entities.Recipe>();
    var activeContest = ViewBag.ActiveContest as JamesThew.Web.Models.Entities.Contest;
    var latestWinner = ViewBag.LatestWinner as JamesThew.Web.Models.Entities.ContestEntry;
    var testimonials = ViewBag.Testimonials as IEnumerable<JamesThew.Web.Models.Entities.SiteFeedback> ?? new List<JamesThew.Web.Models.Entities.SiteFeedback>();
    int totalRecipes = ViewBag.TotalRecipes ?? 50;
    int totalUsers = ViewBag.TotalUsers ?? 100;
}

<!-- 1. HERO SECTION -->
<section class="relative w-full -mt-20 pt-32 pb-24 px-margin-mobile lg:px-margin overflow-hidden flex flex-col justify-center min-h-[85vh]">
  <div class="absolute inset-0 bg-cover bg-center -z-20 transform scale-105" style="background-image: url('/images/dramatic-dynamic-kitchen-shot-of-chef-james-sear-70a0b1.jpg')"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-background via-background/85 to-surface-container-lowest/80 -z-10"></div>
  <div class="absolute -top-32 right-10 w-96 h-96 rounded-full bg-primary/10 blur-[120px] pointer-events-none -z-10"></div>
  <div class="absolute bottom-10 left-10 w-80 h-80 rounded-full bg-secondary-container/20 blur-[100px] pointer-events-none -z-10"></div>

  <div class="max-w-4xl mx-auto text-center flex flex-col items-center gap-space-lg">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-surface-container-high/80 backdrop-blur-md shadow-sm">
      <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
      <span class="font-label-sm text-label-sm uppercase tracking-widest text-primary">Haute Cuisine Masterclasses</span>
    </div>

    <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight leading-tight max-w-4xl">
      Master Culinary Arts with <span class="text-primary-container italic font-normal">5-Star Chef</span> James Thew
    </h1>
    <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl leading-relaxed">
      Specializing in Juices, Vegetarian, Non-Vegetarian &amp; Italian Cuisines. Elevate your palate with Michelin-grade technique, disciplined kitchencraft, and signature formulas from Karachi’s celebrated mentor.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-space-md pt-space-sm">
      <a asp-controller="Plans" asp-action="Index" class="inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-primary-container text-surface-container-lowest font-title-md text-title-md shadow-[0_4px_20px_rgba(217,138,86,0.3)] hover:bg-primary hover:shadow-[0_6px_28px_rgba(217,138,86,0.5)] transition-all transform hover:-translate-y-0.5">
        Join Now ($10/mo)
      </a>
      <a asp-controller="Recipes" asp-action="Free" class="inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-surface-container-highest/60 hover:bg-surface-container-highest text-on-surface font-title-md text-title-md backdrop-blur-md shadow-sm transition-all transform hover:-translate-y-0.5">
        Browse Free Recipes
      </a>
    </div>
  </div>
</section>

<!-- 2. STATS BAR -->
<section class="w-full px-margin-mobile lg:px-margin -mt-10 z-10">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">
    <div class="bg-surface-container/75 backdrop-blur-xl rounded-[18px] p-6 shadow-xl flex flex-col justify-between transition-all hover:bg-surface-container-high/80 group">
      <div class="flex items-center justify-between mb-4">
        <span class="material-symbols-outlined text-primary text-[28px]">menu_book</span>
        <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">Curated</span>
      </div>
      <div>
        <div class="font-headline-xl text-headline-xl text-primary font-serif font-normal">@totalRecipes+</div>
        <div class="font-body-md text-body-md text-on-surface-variant group-hover:text-on-surface transition-colors mt-1 font-medium">Signature Recipes</div>
      </div>
    </div>

    <div class="bg-surface-container/75 backdrop-blur-xl rounded-[18px] p-6 shadow-xl flex flex-col justify-between transition-all hover:bg-surface-container-high/80 group">
      <div class="flex items-center justify-between mb-4">
        <span class="material-symbols-outlined text-primary text-[28px]">groups</span>
        <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">Worldwide</span>
      </div>
      <div>
        <div class="font-headline-xl text-headline-xl text-primary font-serif font-normal">@totalUsers+</div>
        <div class="font-body-md text-body-md text-on-surface-variant group-hover:text-on-surface transition-colors mt-1 font-medium">Culinary Enthusiasts</div>
      </div>
    </div>

    <div class="bg-surface-container/75 backdrop-blur-xl rounded-[18px] p-6 shadow-xl flex flex-col justify-between transition-all hover:bg-surface-container-high/80 group">
      <div class="flex items-center justify-between mb-4">
        <span class="material-symbols-outlined text-primary text-[28px]">emoji_events</span>
        <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">Compete</span>
      </div>
      <div>
        <div class="font-headline-xl text-headline-xl text-primary font-serif font-normal">Seasonal</div>
        <div class="font-body-md text-body-md text-on-surface-variant group-hover:text-on-surface transition-colors mt-1 font-medium">Contests &amp; Prizes</div>
      </div>
    </div>

    <div class="bg-surface-container/75 backdrop-blur-xl rounded-[18px] p-6 shadow-xl flex flex-col justify-between transition-all hover:bg-surface-container-high/80 group">
      <div class="flex items-center justify-between mb-4">
        <span class="material-symbols-outlined text-primary text-[28px]">workspace_premium</span>
        <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">In-Person</span>
      </div>
      <div>
        <div class="font-headline-xl text-headline-xl text-primary font-serif font-normal">Affordable</div>
        <div class="font-body-md text-body-md text-on-surface-variant group-hover:text-on-surface transition-colors mt-1 font-medium">Weekend Classes</div>
      </div>
    </div>
  </div>
</section>

<!-- 3. MEET CHEF JAMES -->
<section class="w-full px-margin-mobile lg:px-margin py-space-xl my-8">
  <div class="bg-surface-container-low/90 rounded-[24px] p-space-md lg:p-space-xl shadow-2xl border border-outline-variant/30">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">
      <!-- Portrait Left -->
      <div class="lg:col-span-5 relative">
        <div class="relative w-full aspect-square max-w-md mx-auto rounded-[18px] overflow-hidden shadow-2xl bg-surface-container-highest">
          <img alt="Professional portrait of Chef James Thew" class="w-full h-full object-cover" src="/images/chef-james-portrait.jpg" />
          <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between">
            <span class="font-label-sm text-label-sm px-3 py-1 rounded-full bg-surface-container-highest/90 text-on-surface backdrop-blur-md">Karachi, PK</span>
            <span class="font-label-sm text-label-sm text-primary flex items-center gap-1 font-medium">
              <span class="material-symbols-outlined text-[16px]">verified</span> 20+ Yrs Mastery
            </span>
          </div>
        </div>
      </div>

      <!-- Bio Right -->
      <div class="lg:col-span-7 flex flex-col gap-space-md">
        <div class="inline-flex items-center gap-2">
          <span class="material-symbols-outlined text-secondary text-[20px]">restaurant_menu</span>
          <span class="font-label-md text-label-md uppercase tracking-wider text-secondary">Executive Chef &amp; Mentor</span>
        </div>
        <h2 class="font-headline-xl text-headline-xl text-on-surface font-serif">
          Crafting Culinary Mastery Through Disciplined Passion
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
          Having directed brigade kitchens in luxury five-star hotels and Michelin-recognized hospitality institutes, Chef James Thew brings fine dining technique within reach of every home cook.
        </p>
        <div class="grid grid-cols-2 gap-space-md pt-2">
          <div class="border-l-2 border-primary-container pl-4">
            <span class="font-title-md text-on-surface block">Classical Foundations</span>
            <span class="font-body-sm text-outline">French, Mediterranean &amp; South Asian precision</span>
          </div>
          <div class="border-l-2 border-secondary pl-4">
            <span class="font-title-md text-on-surface block">Hands-On Mentorship</span>
            <span class="font-body-sm text-outline">Interactive weekend masterclasses in Karachi</span>
          </div>
        </div>
        <div class="pt-space-sm flex flex-wrap gap-space-md">
          <a asp-controller="About" asp-action="Chef" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-surface-container-highest text-on-surface hover:text-primary transition-colors font-title-md">
            <span>Read Chef's Story</span>
            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
          </a>
          <a asp-controller="About" asp-action="Classes" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-primary-container text-surface-container-lowest hover:bg-primary transition-all font-title-md">
            <span>Cookery Classes</span>
            <span class="material-symbols-outlined text-[18px]">calendar_today</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 4. COOKERY CLASSES CALLOUT BANNER -->
<section class="w-full px-margin-mobile lg:px-margin mb-8">
  <div class="relative overflow-hidden rounded-[20px] bg-gradient-to-r from-surface-container-high via-surface-container to-surface-container-low p-space-lg lg:p-space-xl border border-primary-container/30 shadow-2xl">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-space-lg">
      <div class="max-w-2xl text-center lg:text-left">
        <span class="font-label-md text-label-md text-primary uppercase tracking-widest block mb-2">Karachi Studio Classes</span>
        <h3 class="font-headline-lg text-headline-lg text-on-surface mb-2">Weekend Cookery Classes by Chef James</h3>
        <p class="font-body-md text-on-surface-variant">Step into the chef's professional kitchen studio. Learn pasta making from scratch, delicate sauce emulsification, and commercial pan searing techniques.</p>
      </div>
      <a asp-controller="About" asp-action="Classes" class="shrink-0 px-8 py-3.5 rounded-full bg-primary-container text-surface-container-lowest font-title-md hover:bg-primary transition-all shadow-[0_4px_16px_rgba(217,138,86,0.3)]">
        View Class Schedules
      </a>
    </div>
  </div>
</section>

<!-- 5. FEATURED FREE RECIPES -->
<section class="w-full px-margin-mobile lg:px-margin py-space-xl">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-sm mb-space-lg">
    <div>
      <span class="font-label-md text-label-md uppercase tracking-wider text-secondary">Complimentary Repertoire</span>
      <h2 class="font-headline-xl text-headline-xl text-on-surface font-serif mt-1">Featured Free Recipes</h2>
      <p class="font-body-md text-body-md text-on-surface-variant mt-1">Chef-crafted culinary guides accessible to everyone.</p>
    </div>
    <a asp-controller="Recipes" asp-action="Free" class="hidden md:inline-flex items-center gap-2 font-title-md text-title-md text-primary hover:text-primary-fixed transition-colors">
      View All Free Recipes <span class="material-symbols-outlined text-[18px]">east</span>
    </a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">
    @if (featuredRecipes.Any())
    {
      @foreach (var r in featuredRecipes)
      {
        var avgR = r.Feedbacks.Any() ? r.Feedbacks.Average(f => f.Rating).ToString("0.0") : "4.9";
        var rImg = !string.IsNullOrEmpty(r.ImagePath) ? r.ImagePath : "/images/gourmet-black-summer-truffle-risotto-plated-on-h-bc284a.jpg";

        <div class="group bg-surface-container/75 backdrop-blur-md rounded-[18px] overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 flex flex-col justify-between hover:-translate-y-1">
          <div>
            <div class="relative w-full aspect-[16/10] overflow-hidden bg-surface-container-highest">
              <img src="@rImg" alt="@r.Title" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" onerror="this.src='/images/gourmet-black-summer-truffle-risotto-plated-on-h-bc284a.jpg'" />
              <div class="absolute top-3 left-3">
                <span class="px-3 py-1 rounded-full bg-secondary-container/90 text-secondary text-label-sm font-label-sm font-semibold uppercase tracking-wider backdrop-blur-md shadow-sm">Free</span>
              </div>
              <div class="absolute bottom-3 right-3 px-2.5 py-1 rounded-full bg-surface-container-lowest/80 text-on-surface-variant text-label-sm font-label-sm backdrop-blur-md flex items-center gap-1">
                <span class="material-symbols-outlined text-[14px]">timer</span> @(r.PrepMinutes + r.CookMinutes) mins
              </div>
            </div>
            <div class="p-5 flex flex-col gap-2">
              <div class="flex items-center justify-between text-outline text-label-sm font-label-sm">
                <span class="uppercase tracking-wider text-secondary font-medium">@(r.Category?.Name ?? "Recipe")</span>
                <div class="flex items-center text-primary-container">
                  <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">star</span>
                  <span class="ml-1 text-on-surface font-semibold text-body-sm">@avgR</span>
                </div>
              </div>
              <h3 class="font-headline-sm text-headline-sm text-on-surface font-serif group-hover:text-primary transition-colors leading-snug line-clamp-1">
                @r.Title
              </h3>
              <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2">
                @r.Procedure
              </p>
            </div>
          </div>
          <div class="px-5 pb-5 pt-2 flex items-center justify-between border-t border-surface-container-highest/40">
            <span class="font-label-sm text-label-sm text-outline">By @(r.Author?.FullName ?? "Chef James")</span>
            <a asp-controller="Recipes" asp-action="Details" asp-route-id="@r.Id" class="font-title-md text-title-md text-primary group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
              View <span class="material-symbols-outlined text-[16px]">chevron_right</span>
            </a>
          </div>
        </div>
      }
    }
  </div>
</section>

<!-- 6. CATEGORY TILES -->
<section class="w-full px-margin-mobile lg:px-margin py-space-xl">
  <div class="text-center max-w-2xl mx-auto mb-space-xl">
    <span class="font-label-md text-label-md uppercase tracking-wider text-secondary">Gastronomic Pillars</span>
    <h2 class="font-headline-xl text-headline-xl text-on-surface font-serif mt-1">Explore Culinary Disciplines</h2>
    <p class="font-body-md text-body-md text-on-surface-variant mt-2">Precision recipes structured around James Thew’s core areas of restaurant specialization.</p>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">
    <!-- Juices -->
    <a asp-controller="Recipes" asp-action="Free" asp-route-category="Juices" class="group relative rounded-[20px] overflow-hidden aspect-[4/5] p-6 flex flex-col justify-end shadow-xl transform transition-transform duration-300 hover:-translate-y-1">
      <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110" style="background-image: url('/images/vibrant-artisanal-cold-pressed-botanical-beverag-245094.jpg')"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/60 to-transparent"></div>
      <div class="relative z-10">
        <div class="w-10 h-10 rounded-full bg-surface-container-high/80 backdrop-blur-md flex items-center justify-center text-primary mb-3">
          <span class="material-symbols-outlined text-[22px]">local_drink</span>
        </div>
        <h3 class="font-headline-md text-headline-md text-on-surface font-serif group-hover:text-primary transition-colors">Juices</h3>
        <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">Cold-pressed elixirs, botanical tonics, and cellular wellness detoxes.</p>
      </div>
    </a>

    <!-- Vegetarian -->
    <a asp-controller="Recipes" asp-action="Free" asp-route-category="Vegetarian" class="group relative rounded-[20px] overflow-hidden aspect-[4/5] p-6 flex flex-col justify-end shadow-xl transform transition-transform duration-300 hover:-translate-y-1">
      <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110" style="background-image: url('/images/gourmet-roasted-heirloom-vegetables-caramelized-5bdc19.jpg')"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/60 to-transparent"></div>
      <div class="relative z-10">
        <div class="w-10 h-10 rounded-full bg-surface-container-high/80 backdrop-blur-md flex items-center justify-center text-secondary mb-3">
          <span class="material-symbols-outlined text-[22px]">spa</span>
        </div>
        <h3 class="font-headline-md text-headline-md text-on-surface font-serif group-hover:text-primary transition-colors">Vegetarian</h3>
        <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">Artisanal plant-based entrees, hearty grains, and fragrant farm herbs.</p>
      </div>
    </a>

    <!-- Non-Vegetarian -->
    <a asp-controller="Recipes" asp-action="Free" asp-route-category="Non-Vegetarian" class="group relative rounded-[20px] overflow-hidden aspect-[4/5] p-6 flex flex-col justify-end shadow-xl transform transition-transform duration-300 hover:-translate-y-1">
      <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110" style="background-image: url('/images/a-sizzling-thick-cut-dry-aged-steak-resting-alon-924634.jpg')"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/60 to-transparent"></div>
      <div class="relative z-10">
        <div class="w-10 h-10 rounded-full bg-surface-container-high/80 backdrop-blur-md flex items-center justify-center text-primary-fixed mb-3">
          <span class="material-symbols-outlined text-[22px]">kebab_dining</span>
        </div>
        <h3 class="font-headline-md text-headline-md text-on-surface font-serif group-hover:text-primary transition-colors">Non-Vegetarian</h3>
        <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">Prime cuts, coastal seafood, and traditional slow-cooked braises.</p>
      </div>
    </a>

    <!-- Italian -->
    <a asp-controller="Recipes" asp-action="Free" asp-route-category="Italian" class="group relative rounded-[20px] overflow-hidden aspect-[4/5] p-6 flex flex-col justify-end shadow-xl transform transition-transform duration-300 hover:-translate-y-1">
      <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110" style="background-image: url('/images/handcrafted-fresh-tagliatelle-pasta-tossed-in-ag-6c7b12.jpg')"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/60 to-transparent"></div>
      <div class="relative z-10">
        <div class="w-10 h-10 rounded-full bg-surface-container-high/80 backdrop-blur-md flex items-center justify-center text-primary mb-3">
          <span class="material-symbols-outlined text-[22px]">dinner_dining</span>
        </div>
        <h3 class="font-headline-md text-headline-md text-on-surface font-serif group-hover:text-primary transition-colors">Italian</h3>
        <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">Authentic fresh pasta, wood-fired sauces, and classic antipasti.</p>
      </div>
    </a>
  </div>
</section>

<!-- 7. ACTIVE CONTEST & LATEST WINNER -->
<section class="w-full px-margin-mobile lg:px-margin py-space-xl">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-stretch">
    <!-- Active Contest -->
    <div class="lg:col-span-8 bg-surface-container-high/90 backdrop-blur-xl rounded-[18px] p-8 shadow-2xl flex flex-col justify-between relative overflow-hidden border border-primary-container/20">
      <div class="absolute top-0 right-0 w-80 h-80 bg-primary/10 rounded-full blur-[100px] pointer-events-none"></div>
      <div class="relative z-10">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/20 text-primary font-label-sm text-label-sm font-semibold uppercase tracking-wider mb-4">
          <span class="material-symbols-outlined text-[16px]">local_fire_department</span> Active Challenge
        </div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface font-serif leading-snug mb-3">
          @(activeContest?.Title ?? "Monthly Master Chef Challenge: Artisan Seafood & Pasta Fusion")
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant mb-6 max-w-xl">
          @(activeContest?.Description ?? "Submit your signature dish. Judged personally by Chef James on balance, textural execution, and aesthetic plating.")
        </p>
        <div class="p-4 rounded-xl bg-surface-container-lowest/70 backdrop-blur-sm mb-6 flex items-start gap-3">
          <span class="material-symbols-outlined text-primary text-[24px] shrink-0 mt-0.5">card_membership</span>
          <div>
            <span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary block">Grand Prize Package</span>
            <p class="font-title-md text-title-md text-on-surface font-medium">@(activeContest?.Prize ?? "Grand Prize: $500 Kitchen Kit + 1-on-1 Masterclass Consultation")</p>
          </div>
        </div>
      </div>
      <div class="relative z-10 pt-2 flex items-center gap-4">
        <a asp-controller="Contests" asp-action="Participate" class="inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-primary-container text-surface-container-lowest font-title-md text-title-md shadow-[0_4px_16px_rgba(217,138,86,0.3)] hover:bg-primary transition-all">
          Participate Now
        </a>
        <a asp-controller="Contests" asp-action="Index" class="font-title-md text-title-md text-on-surface-variant hover:text-on-surface transition-colors px-4 py-2">
          Read Rules
        </a>
      </div>
    </div>

    <!-- Latest Winner Snippet -->
    <div class="lg:col-span-4 bg-surface-container/80 backdrop-blur-xl rounded-[18px] p-6 lg:p-8 shadow-xl flex flex-col justify-between relative overflow-hidden border border-outline-variant/30">
      <div>
        <div class="flex items-center justify-between mb-6">
          <span class="font-label-sm text-label-sm uppercase tracking-widest text-primary font-semibold">Hall of Honor</span>
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-primary/15 text-primary text-label-sm font-label-sm">
            <span class="material-symbols-outlined text-[13px]">military_tech</span> Victor
          </span>
        </div>
        <div class="flex flex-col items-center text-center">
          <div class="w-20 h-20 rounded-full bg-primary-container text-surface-container-lowest flex items-center justify-center font-bold text-2xl shadow-xl mb-3">
            @((latestWinner?.User?.FullName ?? latestWinner?.GuestName ?? "Farah").Substring(0, 1))
          </div>
          <div class="px-3 py-1 rounded-full bg-surface-container-high text-secondary text-label-sm font-label-sm uppercase tracking-wider mb-2">
            @(latestWinner?.Contest?.Title ?? "Recent Challenge")
          </div>
          <h3 class="font-headline-sm text-headline-sm text-on-surface font-serif">
            @(latestWinner?.User?.FullName ?? (string.IsNullOrEmpty(latestWinner?.GuestName) ? "Farah Al-Sayed" : latestWinner.GuestName))
          </h3>
