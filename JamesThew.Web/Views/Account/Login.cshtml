@model JamesThew.Web.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card bg-surface text-cream border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header border-0 bg-transparent text-center pt-5 pb-3">
                    <h2 class="font-heading text-copper mb-2">Welcome Back</h2>
                    <p class="text-muted mb-0">Login to your James Thew account</p>
                </div>
                <div class="card-body p-4 p-md-5 pt-0">
                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control bg-dark text-cream border-secondary" placeholder="name@example.com" />
                            <label asp-for="Email" class="text-muted">Email address</label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="Password" class="form-control bg-dark text-cream border-secondary" placeholder="Password" />
                            <label asp-for="Password" class="text-muted">Password</label>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold">
                                Login to Kitchen <span class="material-symbols-outlined align-middle fs-5 ms-1">arrow_forward</span>
                            </button>
                        </div>
                    </form>
                    
                    <div class="text-center mt-4">
                        <p class="mb-0 text-muted">
                            Don't have an account? 
                            <a asp-action="Register" class="text-mint text-decoration-none fw-semibold">Join Now</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
