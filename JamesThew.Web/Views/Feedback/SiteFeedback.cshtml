<button aria-label="1 Star" class="star-btn text-surface-variant hover:text-primary-container transition-colors focus:outline-none" data-val="1" type="button">
<span class="material-symbols-outlined text-[24px]">star</span>
</button>
<button aria-label="2 Stars" class="star-btn text-surface-variant hover:text-primary-container transition-colors focus:outline-none" data-val="2" type="button">
<span class="material-symbols-outlined text-[24px]">star</span>
</button>
<button aria-label="3 Stars" class="star-btn text-surface-variant hover:text-primary-container transition-colors focus:outline-none" data-val="3" type="button">
<span class="material-symbols-outlined text-[24px]">star</span>
</button>
<button aria-label="4 Stars" class="star-btn text-surface-variant hover:text-primary-container transition-colors focus:outline-none" data-val="4" type="button">
<span class="material-symbols-outlined text-[24px]">star</span>
</button>
<button aria-label="5 Stars" class="star-btn text-surface-variant hover:text-primary-container transition-colors focus:outline-none" data-val="5" type="button">
<span class="material-symbols-outlined text-[24px]">star</span>
</button>
</div>
</div>
<!-- Comments -->
<div class="flex flex-col gap-space-xs">
<label class="font-title-md text-title-md text-on-surface" for="comments">Comments</label>
<textarea class="w-full p-space-md rounded-xl bg-surface-container-lowest text-on-surface placeholder:text-outline font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary-container transition-all resize-y" id="comments" name="comments" placeholder="Tell us what you loved, what could be improved, or any features you'd like to see..." required="" rows="5"></textarea>
</div>
<!-- Submit & Assurance -->
<div class="flex flex-col sm:flex-row items-center justify-between gap-space-md pt-space-xs">
<p class="font-body-sm text-body-sm text-outline max-w-xs text-center sm:text-left">
                  Your feedback is read directly by our culinary and administrative staff.
                </p>
<button class="inline-flex items-center justify-center gap-space-sm px-space-xl py-space-sm rounded-full bg-primary-container text-surface-container-lowest font-title-md text-title-md shadow-[0_4px_16px_rgba(217,138,86,0.25)] hover:bg-primary hover:shadow-[0_6px_24px_rgba(217,138,86,0.4)] transition-all cursor-pointer shrink-0" type="submit">
<span>Submit Feedback</span>
<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</button>
</div>
</form>
</div>
</section>
</div>
</div>
</div>
<script>
    (function initRatingStars() {
      const starBtns = document.querySelectorAll('#starRatingGroup .star-btn');
      const ratingStatus = document.getElementById('ratingStatus');
      let currentRating = 5;

      function renderStars(rating) {
        starBtns.forEach((btn, index) => {
          const icon = btn.querySelector('.material-symbols-outlined');
          if (index < rating) {
            btn.classList.remove('text-surface-variant');
            btn.classList.add('text-primary-container');
            icon.style.fontVariationSettings = "'FILL' 1";
          } else {
            btn.classList.remove('text-primary-container');
            btn.classList.add('text-surface-variant');
            icon.style.fontVariationSettings = "'FILL' 0";
          }
        });
        if (ratingStatus) {
          ratingStatus.textContent = rating ? rating + ' of 5 Stars' : 'Select rating';
        }
      }

      starBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          currentRating = parseInt(btn.dataset.val, 10);
          renderStars(currentRating);
        });
      });

      // Default highlight 5 stars for high culinary confidence
      renderStars(currentRating);
    })();
  </script>
</div>
