@model IEnumerable<JamesThew.Web.Models.Entities.Recipe>
@{
    ViewData["Title"] = "My Recipes";
    Layout = "_DashboardLayout";
}

@if (TempData["Success"] != null)
{
    <div class="mb-6 p-4 rounded-xl bg-[rgba(93,187,138,0.15)] border border-[rgba(93,187,138,0.3)] text-[#5DBB8A] flex items-center gap-3">
        <span class="material-symbols-outlined text-[20px]">check_circle</span>
        <span>@TempData["Success"]</span>
    </div>
}

<!-- Top Action & Header Bar -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-space-xl">
    <div>
        <span class="text-label-md uppercase tracking-wider text-primary mb-1 block">Culinary Archive</span>
        <h2 class="text-headline-xl font-headline text-on-surface">My Authored Recipes</h2>
    </div>
    <div class="flex items-center gap-4">
        <div class="relative flex-1 md:w-80">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">search</span>
            <input id="recipe-search" oninput="filterRecipes()" class="w-full bg-surface-container text-on-surface placeholder:text-on-surface-variant text-body-sm rounded-xl pl-9 pr-4 py-2.5 border border-outline-variant focus:outline-none focus:border-primary transition-all" placeholder="Filter my recipes..." type="text"/>
        </div>
        <a asp-action="AddRecipe" class="flex items-center gap-2 px-6 py-2.5 bg-primary text-on-primary font-title-md rounded-full shadow-[0_4px_16px_rgba(217,138,86,0.25)] hover:bg-[#E8A173] hover:shadow-[0_6px_24px_rgba(217,138,86,0.40)] transition-all cursor-pointer whitespace-nowrap">
            <span class="material-symbols-outlined text-[20px]">add</span>
            Add Recipe
        </a>
    </div>
</div>

<!-- KPI / Stats Summary Row -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-gutter mb-space-xl">
    <div class="bg-surface-container/70 backdrop-blur-[16px] rounded-xl p-space-lg shadow-sm border border-[rgba(246,239,227,0.12)]">
        <div class="flex items-center justify-between mb-2">
            <span class="text-label-sm text-on-surface-variant uppercase">Total Recipes</span>
            <span class="material-symbols-outlined text-primary text-[22px]">restaurant_menu</span>
        </div>
        <div class="text-headline-lg font-headline text-on-surface">@Model.Count()</div>
        <div class="text-body-sm text-[#5DBB8A] mt-1 flex items-center gap-1">
            <span class="material-symbols-outlined text-[16px]">menu_book</span> Personal Creations
        </div>
    </div>
    <div class="bg-surface-container/70 backdrop-blur-[16px] rounded-xl p-space-lg shadow-sm border border-[rgba(246,239,227,0.12)]">
        <div class="flex items-center justify-between mb-2">
            <span class="text-label-sm text-on-surface-variant uppercase">Free Public Tier</span>
            <span class="material-symbols-outlined text-[#9FD8B8] text-[22px]">public</span>
        </div>
        <div class="text-headline-lg font-headline text-on-surface">@Model.Count(r => r.Access == "Free")</div>
        <div class="text-body-sm text-on-surface-variant mt-1">Open to all community members</div>
    </div>
    <div class="bg-surface-container/70 backdrop-blur-[16px] rounded-xl p-space-lg shadow-sm border border-[rgba(246,239,227,0.12)]">
        <div class="flex items-center justify-between mb-2">
            <span class="text-label-sm text-on-surface-variant uppercase">Premium Tier</span>
            <span class="material-symbols-outlined text-primary text-[22px]" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
        </div>
        <div class="text-headline-lg font-headline text-on-surface">@Model.Count(r => r.Access == "Premium")</div>
        <div class="text-body-sm text-primary mt-1">Exclusive Sanctuary Archive</div>
    </div>
</div>

<!-- Recipes List Section -->
@if (!Model.Any())
{
    <div class="bg-surface-container/70 backdrop-blur-[16px] rounded-xl p-12 text-center border border-[rgba(246,239,227,0.12)]">
        <span class="material-symbols-outlined text-primary text-[48px] mb-3">menu_book</span>
        <h3 class="text-headline-md font-headline text-on-surface mb-2">No Recipes Published Yet</h3>
        <p class="text-body-md text-on-surface-variant max-w-md mx-auto mb-6">You have not submitted any recipes to The Sanctuary archive yet. Share your first signature dish!</p>
        <a asp-action="AddRecipe" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-on-primary font-title-md rounded-full shadow-lg hover:bg-[#E8A173] transition-all">
            <span class="material-symbols-outlined text-[20px]">add_circle</span>
            Publish First Recipe
        </a>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6" id="recipes-grid">
        @foreach (var recipe in Model)
        {
            <div class="recipe-card bg-surface-container/70 backdrop-blur-[16px] rounded-xl overflow-hidden border border-[rgba(246,239,227,0.12)] hover:border-primary/50 transition-all flex flex-col justify-between group" data-title="@recipe.Title.ToLower()">
                <div>
                    <div class="h-48 w-full relative overflow-hidden bg-surface-container-high">
                        <img src="@recipe.ImagePath" alt="@recipe.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" onerror="this.src='/images/recipe-default.jpg'"/>
                        <span class="absolute top-3 right-3 px-3 py-1 rounded-full text-label-sm font-semibold @(recipe.Access == "Premium" ? "bg-primary text-on-primary shadow-md" : "bg-[#184238]/90 text-on-surface border border-[rgba(246,239,227,0.2)]")">
                            @recipe.Access
                        </span>
                        <span class="absolute bottom-3 left-3 px-2.5 py-0.5 rounded-lg text-label-sm bg-[#0A211E]/80 backdrop-blur-sm text-primary">
                            @recipe.Category?.Name
                        </span>
                    </div>
                    <div class="p-6">
                        <h3 class="text-title-lg font-headline text-on-surface mb-2 group-hover:text-primary transition-colors line-clamp-1">
                            @recipe.Title
                        </h3>
                        <div class="flex items-center gap-4 text-body-sm text-on-surface-variant mb-4">
                            <span class="flex items-center gap-1">
                                <span class="material-symbols-outlined text-[16px]">schedule</span> @recipe.PrepMinutes m prep
                            </span>
                            <span class="flex items-center gap-1">
                                <span class="material-symbols-outlined text-[16px]">timer</span> @recipe.CookMinutes m cook
                            </span>
                        </div>
                        <p class="text-body-sm text-on-surface-variant/80 line-clamp-2">
                            @(recipe.Ingredients?.Replace("\n", ", ") ?? "")
                        </p>
                    </div>
                </div>
                <div class="px-6 pb-6 pt-2 border-t border-[rgba(246,239,227,0.06)] flex items-center justify-between">
                    <span class="text-label-sm text-outline">@recipe.CreatedAt.ToString("MMM dd, yyyy")</span>
                    <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipe.Id" class="text-primary hover:text-[#E8A173] text-title-md flex items-center gap-1 transition-colors">
                        View Details <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                    </a>
                </div>
            </div>
        }
    </div>
}

<script>
    function filterRecipes() {
        const query = document.getElementById('recipe-search').value.toLowerCase();
        const cards = document.querySelectorAll('.recipe-card');
        cards.forEach(card => {
            const title = card.getAttribute('data-title');
            if (title.includes(query)) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });
    }
</script>
