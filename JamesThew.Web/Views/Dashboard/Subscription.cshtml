<td class="py-4 px-4">
<span class="px-2.5 py-0.5 rounded-full text-label-sm bg-[rgba(93,187,138,0.15)] text-[#5DBB8A] border border-[rgba(93,187,138,0.3)]">Completed</span>
</td>
