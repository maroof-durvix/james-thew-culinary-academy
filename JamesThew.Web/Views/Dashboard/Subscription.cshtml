<!-- Toast Notification Container -->
<div class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none" id="toast-container"></div>
<!-- Interactive Modal Overlay -->
<div class="fixed inset-0 bg-[#001714]/80 backdrop-blur-md z-50 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300" id="modal-overlay">
<div class="bg-[#184238] border border-[rgba(246,239,227,0.20)] rounded-xl p-space-lg max-w-md w-full mx-4 shadow-2xl transform scale-95 transition-transform duration-300" id="modal-card">
<div class="flex items-center justify-between mb-space-md">
<h4 class="font-headline-md text-on-surface" id="modal-title">Confirm Subscription Action</h4>
<button class="w-8 h-8 rounded-full bg-[#0A211E] flex items-center justify-center text-on-surface-variant hover:text-on-surface transition-colors" onclick="closeModal()">
<span class="material-symbols-outlined text-[18px]">close</span>
</button>
</div>
<p class="font-body-sm text-on-surface-variant mb-space-lg" id="modal-desc">Are you sure you wish to process this simulated payment action for your membership?</p>
<div class="flex items-center gap-space-md">
<button class="flex-1 py-3 rounded-full border-[1.5px] border-[rgba(246,239,227,0.40)] text-on-surface font-title-md hover:bg-[rgba(246,239,227,0.08)] transition-all" onclick="closeModal()">Cancel</button>
<button class="flex-1 py-3 rounded-full bg-primary text-on-primary font-title-md hover:bg-[#E8A173] transition-all" id="modal-confirm-btn" onclick="confirmAction()">Confirm Payment</button>
</div>
</div>
</div>
<script>
    function scrollToPlans() {
      document.getElementById('plans-section').scrollIntoView({ behavior: 'smooth' });
    }

    function showToast(message) {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = 'bg-[#0A211E] text-on-surface px-4 py-3 rounded-xl border border-primary/40 shadow-xl font-body-sm flex items-center gap-3 pointer-events-auto transform translate-y-4 opacity-0 transition-all duration-300';
      toast.innerHTML = \`<span class="material-symbols-outlined text-primary text-[18px]">check_circle</span><span>\${message}</span>\`;
      container.appendChild(toast);
      
      setTimeout(() => {
        toast.classList.remove('translate-y-4', 'opacity-0');
      }, 10);

      setTimeout(() => {
        toast.classList.add('translate-y-4', 'opacity-0');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    let pendingActionType = '';

    function openRenewModal() {
      pendingActionType = 'renew';
      document.getElementById('modal-title').innerText = 'Simulate Plan Renewal';
      document.getElementById('modal-desc').innerText = 'This will simulate a renewal charge of $100.00 for your Yearly Mastership plan. Proceed?';
      document.getElementById('modal-confirm-btn').innerText = 'Process Renewal';
      
      const overlay = document.getElementById('modal-overlay');
      const card = document.getElementById('modal-card');
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      card.classList.remove('scale-95');
    }

    function selectPlan(planName, price) {
      pendingActionType = 'change';
      document.getElementById('modal-title').innerText = \`Switch to \${planName} Plan\`;
      document.getElementById('modal-desc').innerText = \`You are about to switch your active billing tier to \${planName} (\${price}). Simulated payment will be processed immediately.\`;
      document.getElementById('modal-confirm-btn').innerText = \`Confirm \${planName}\`;
      
      const overlay = document.getElementById('modal-overlay');
      const card = document.getElementById('modal-card');
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      card.classList.remove('scale-95');
    }

    function closeModal() {
      const overlay = document.getElementById('modal-overlay');
      const card = document.getElementById('modal-card');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      card.classList.add('scale-95');
    }

    function confirmAction() {
      closeModal();
      if (pendingActionType === 'renew') {
        showToast('Renewal successful! Simulated payment of $100.00 processed.');
      } else {
        showToast('Plan successfully updated and simulated charge completed.');
      }
    }
  </script>
</div>
