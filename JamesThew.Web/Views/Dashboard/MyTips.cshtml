<button class="px-5 py-2.5 rounded-full bg-primary text-on-primary font-title-md shadow-[0_4px_16px_rgba(217,138,86,0.25)] hover:bg-[#E8A173] transition-all" onclick="closeAddTipModal()">
          Publish Tip
