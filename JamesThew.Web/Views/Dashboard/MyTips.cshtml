<!-- Delete Confirmation Modal (Hidden by default, shown via toggle) -->
<div class="fixed inset-0 z-50 flex items-center justify-center bg-surface/80 backdrop-blur-md hidden" id="deleteModal">
<div class="bg-[#184238] border border-[rgba(246,239,227,0.20)] rounded-xl p-8 max-w-md w-full shadow-[0_8px_32px_rgba(0,0,0,0.5)] relative">
<div class="w-12 h-12 rounded-full bg-error-container/40 border border-error/30 flex items-center justify-center text-error mb-4">
<span class="material-symbols-outlined text-[24px]">warning</span>
</div>
<h3 class="text-headline-sm font-headline text-on-surface mb-2">Delete Culinary Tip</h3>
<p class="text-body-md text-on-surface-variant mb-6">Are you sure you want to permanently delete <strong class="text-on-surface" id="modalTipTitle">"Precision Julienne: The Wet-Honing Method"</strong>? This action cannot be undone and will remove it from community view.</p>
<div class="flex items-center justify-end gap-3">
<button class="px-5 py-2.5 rounded-full border border-[rgba(246,239,227,0.40)] text-on-surface hover:bg-[rgba(246,239,227,0.08)] transition-all font-title-md" onclick="closeDeleteModal()">
          Cancel
        </button>
<button class="px-5 py-2.5 rounded-full bg-error text-on-error font-title-md shadow-[0_4px_16px_rgba(255,180,171,0.25)] hover:opacity-90 transition-all" onclick="confirmDelete()">
          Confirm Deletion
        </button>
</div>
</div>
</div>
