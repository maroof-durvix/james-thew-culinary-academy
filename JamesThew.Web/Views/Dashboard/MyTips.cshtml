<div class="flex gap-4">
<label class="flex items-center gap-2 cursor-pointer text-on-surface text-body-sm">
<input checked="" class="accent-[#D98A56]" name="access" type="radio"/> Free Access
            </label>
<label class="flex items-center gap-2 cursor-pointer text-on-surface text-body-sm">
<input class="accent-[#D98A56]" name="access" type="radio"/> Premium Sanctuary Members Only
            </label>
</div>
</div>
