</div>
<div>
<label class="block text-label-md uppercase text-on-surface-variant mb-2">Category</label>
<select class="w-full bg-[#0A211E] text-on-surface text-body-sm rounded-xl px-4 py-2.5 border border-outline-variant focus:outline-none focus:border-primary transition-all">
<option>Knife Skills</option>
<option>Meat &amp; Poultry</option>
<option>Sauces &amp; Reductions</option>
<option>Baking &amp; Pastry</option>
<option>Equipment Mastery</option>
</select>
</div>
<div>
