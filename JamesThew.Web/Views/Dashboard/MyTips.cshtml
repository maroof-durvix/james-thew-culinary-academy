</div>
</div>
</div>
<script>
    function openDeleteModal(title) {
      document.getElementById('modalTipTitle').textContent = '"' + title + '"';
      document.getElementById('deleteModal').classList.remove('hidden');
    }
    function closeDeleteModal() {
      document.getElementById('deleteModal').classList.add('hidden');
    }
    function confirmDelete() {
      closeDeleteModal();
      // Simulate removal action
    }
    function openAddTipModal() {
      document.getElementById('addTipModal').classList.remove('hidden');
    }
    function closeAddTipModal() {
      document.getElementById('addTipModal').classList.add('hidden');
    }
  </script>
</div>
