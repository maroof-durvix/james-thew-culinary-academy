@model JamesThew.Web.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Profile Settings";
    Layout = "_DashboardLayout";
}

@if (TempData["Success"] != null)
{
    <div class="mb-6 p-4 rounded-xl bg-[rgba(93,187,138,0.15)] border border-[rgba(93,187,138,0.3)] text-[#5DBB8A] flex items-center gap-3">
        <span class="material-symbols-outlined text-[20px]">check_circle</span>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-6 p-4 rounded-xl bg-error/15 border border-error/30 text-error flex items-center gap-3">
        <span class="material-symbols-outlined text-[20px]">error</span>
        <span>@TempData["Error"]</span>
    </div>
}

<!-- Top Section / Hero Header Card -->
<div class="relative w-full rounded-xl bg-surface-container-high p-8 overflow-hidden mb-space-xl">
    <div class="absolute -right-20 -top-20 w-80 h-80 rounded-full bg-primary-container/10 blur-3xl pointer-events-none"></div>
    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-center gap-6">
            <!-- Avatar with photo trigger -->
            <div class="relative group">
                <div class="w-24 h-24 rounded-full bg-surface-container-lowest overflow-hidden border-2 border-primary/40 shadow-[0_4px_20px_rgba(217,138,86,0.25)] flex items-center justify-center">
                    @if (!string.IsNullOrEmpty(Model.AvatarPath))
                    {
                        <img src="@Model.AvatarPath" alt="@Model.FullName" class="w-full h-full object-cover" onerror="this.style.display='none'; document.getElementById('default-avatar-icon').style.display='block';"/>
                        <span id="default-avatar-icon" class="material-symbols-outlined text-primary text-[48px] hidden">person</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-primary text-[48px]" style="font-variation-settings: 'FILL' 1;">person</span>
                    }
                </div>
            </div>
            <!-- User info -->
            <div>
                <div class="flex items-center gap-3">
                    <h2 class="font-headline text-headline-lg text-on-surface">@Model.FullName</h2>
                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-primary-container/20 border border-primary-container/50 text-primary text-label-sm">
                        <span class="material-symbols-outlined text-[12px]" style="font-variation-settings: 'FILL' 1;">crown</span>
                        @Model.Role Tier
                    </span>
                </div>
                <p class="text-body-md text-on-surface-variant mt-1">@Model.Email</p>
                <div class="flex items-center gap-2 mt-2 text-body-sm text-outline">
                    <span class="material-symbols-outlined text-[16px] text-tertiary">verified_user</span>
                    <span>Sanctuary Community Registered Member</span>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-surface-container-low text-secondary text-body-sm">
                <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
                Account Active
            </span>
        </div>
    </div>
</div>

<!-- Settings Interface with Tabs -->
<div class="w-full">
    <!-- Tab Navigation -->
    <div class="flex items-center gap-3 border-b border-outline-variant/30 pb-4 mb-space-lg">
        <button id="btn-tab-personal" onclick="switchProfileTab('personal')" class="px-6 py-3 rounded-xl text-body-md transition-all flex items-center gap-2 cursor-pointer bg-primary-container text-on-primary-container font-semibold shadow-[0_4px_16px_rgba(217,138,86,0.25)]">
            <span class="material-symbols-outlined text-[18px]">badge</span>
            Personal Information
        </button>
        <button id="btn-tab-password" onclick="switchProfileTab('password')" class="px-6 py-3 rounded-xl text-body-md transition-all flex items-center gap-2 cursor-pointer bg-surface-container-high text-on-surface-variant hover:text-on-surface">
            <span class="material-symbols-outlined text-[18px]">lock_reset</span>
            Change Password
        </button>
    </div>

    <!-- Tab Content: Personal Information -->
    <div id="tab-personal" class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <div class="lg:col-span-8 bg-surface-container-high rounded-xl p-8 shadow-sm">
            <h3 class="font-headline text-headline-sm text-on-surface mb-2">Edit Profile Details</h3>
            <p class="text-body-md text-on-surface-variant mb-6">Update your personal credentials and professional contact details.</p>

            <form asp-action="UpdateProfile" method="post" enctype="multipart/form-data" class="space-y-6">
                @Html.AntiForgeryToken()

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="FullName" class="block text-label-md text-on-surface-variant mb-2">Full Name <span class="text-primary">*</span></label>
                        <input asp-for="FullName" class="w-full bg-[#0A211E] text-on-surface placeholder:text-outline text-body-md rounded-xl px-4 py-3 border border-outline-variant focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" required pattern="^[a-zA-Z\s]{2,50}$" minlength="2" maxlength="50" title="Full name must contain only letters and spaces (2 to 50 characters)" />
                    </div>
                    <div>
                        <label asp-for="Email" class="block text-label-md text-on-surface-variant mb-2">Email Address (Read-Only)</label>
                        <input asp-for="Email" class="w-full bg-[#0A211E]/50 text-on-surface-variant text-body-md rounded-xl px-4 py-3 border border-outline-variant/30 cursor-not-allowed" readonly />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="Phone" class="block text-label-md text-on-surface-variant mb-2">Phone Number</label>
                        <input asp-for="Phone" class="w-full bg-[#0A211E] text-on-surface placeholder:text-outline text-body-md rounded-xl px-4 py-3 border border-outline-variant focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" placeholder="+1 (555) 000-0000" type="tel" pattern="^[\+]?[0-9\s\-]{7,16}$" title="Please enter a valid phone number (7 to 16 digits)" />
                    </div>
                    <div>
                        <label asp-for="AvatarFile" class="block text-label-md text-on-surface-variant mb-2">Profile Avatar Photo</label>
                        <input asp-for="AvatarFile" type="file" accept="image/*" class="w-full bg-[#0A211E] text-on-surface text-body-sm rounded-xl px-4 py-2.5 border border-outline-variant file:mr-4 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-primary file:text-on-primary file:font-semibold" />
                    </div>
                </div>

                <div class="pt-4 border-t border-[rgba(246,239,227,0.1)] flex justify-end">
                    <button type="submit" class="px-8 py-3 rounded-full bg-primary hover:bg-[#E8A173] text-on-primary font-title-md shadow-[0_4px_16px_rgba(217,138,86,0.25)] transition-all cursor-pointer">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>

        <div class="lg:col-span-4 space-y-6">
            <div class="bg-surface-container-high rounded-xl p-6 shadow-sm border border-outline-variant/20">
                <h4 class="font-title-md text-on-surface mb-3 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">security</span>
                    Privacy Guarantee
                </h4>
                <p class="text-body-sm text-on-surface-variant leading-relaxed">
                    Your contact information is strictly used for order receipts and contest victory notifications. We never share user data with third-party advertisers.
                </p>
            </div>
        </div>
    </div>

    <!-- Tab Content: Change Password -->
    <div id="tab-password" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-8">
        <div class="lg:col-span-8 bg-surface-container-high rounded-xl p-8 shadow-sm">
            <h3 class="font-headline text-headline-sm text-on-surface mb-2">Update Password</h3>
            <p class="text-body-md text-on-surface-variant mb-6">Ensure your account uses a strong passphrase of at least 6 characters.</p>

            <form asp-action="ChangePassword" method="post" class="space-y-6">
                @Html.AntiForgeryToken()

                <div>
                    <label asp-for="CurrentPassword" class="block text-label-md text-on-surface-variant mb-2">Current Password <span class="text-primary">*</span></label>
                    <input asp-for="CurrentPassword" type="password" class="w-full bg-[#0A211E] text-on-surface placeholder:text-outline text-body-md rounded-xl px-4 py-3 border border-outline-variant focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" required />
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="NewPassword" class="block text-label-md text-on-surface-variant mb-2">New Password <span class="text-primary">*</span></label>
                        <input asp-for="NewPassword" type="password" minlength="6" class="w-full bg-[#0A211E] text-on-surface placeholder:text-outline text-body-md rounded-xl px-4 py-3 border border-outline-variant focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" required />
                    </div>
                    <div>
                        <label asp-for="ConfirmPassword" class="block text-label-md text-on-surface-variant mb-2">Confirm New Password <span class="text-primary">*</span></label>
                        <input asp-for="ConfirmPassword" type="password" minlength="6" class="w-full bg-[#0A211E] text-on-surface placeholder:text-outline text-body-md rounded-xl px-4 py-3 border border-outline-variant focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" required />
                    </div>
                </div>

                <div class="pt-4 border-t border-[rgba(246,239,227,0.1)] flex justify-end">
                    <button type="submit" class="px-8 py-3 rounded-full bg-primary hover:bg-[#E8A173] text-on-primary font-title-md shadow-[0_4px_16px_rgba(217,138,86,0.25)] transition-all cursor-pointer">
                        Update Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function switchProfileTab(tabName) {
        const personalTab = document.getElementById('tab-personal');
        const passwordTab = document.getElementById('tab-password');
        const btnPersonal = document.getElementById('btn-tab-personal');
        const btnPassword = document.getElementById('btn-tab-password');

        if (tabName === 'personal') {
            personalTab.classList.remove('hidden');
            passwordTab.classList.add('hidden');
            btnPersonal.className = "px-6 py-3 rounded-xl text-body-md transition-all flex items-center gap-2 cursor-pointer bg-primary-container text-on-primary-container font-semibold shadow-[0_4px_16px_rgba(217,138,86,0.25)]";
            btnPassword.className = "px-6 py-3 rounded-xl text-body-md transition-all flex items-center gap-2 cursor-pointer bg-surface-container-high text-on-surface-variant hover:text-on-surface";
        } else {
            personalTab.classList.add('hidden');
            passwordTab.classList.remove('hidden');
            btnPassword.className = "px-6 py-3 rounded-xl text-body-md transition-all flex items-center gap-2 cursor-pointer bg-primary-container text-on-primary-container font-semibold shadow-[0_4px_16px_rgba(217,138,86,0.25)]";
            btnPersonal.className = "px-6 py-3 rounded-xl text-body-md transition-all flex items-center gap-2 cursor-pointer bg-surface-container-high text-on-surface-variant hover:text-on-surface";
        }
    }
</script>
