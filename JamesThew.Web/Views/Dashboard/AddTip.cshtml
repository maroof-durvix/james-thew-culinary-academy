@{
    ViewData["Title"] = "Add Tip";
}

<div class="flex flex-col w-full max-w-5xl mx-auto space-y-10 pb-16">
<!-- Page Header -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 pb-6 border-b border-outline-variant/30">
<div class="space-y-2">
<div class="flex items-center gap-2 text-primary font-label-md uppercase tracking-wider">
<span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">lightbulb</span>
        Culinary Knowledge Base
      </div>
<h2 class="font-headline-xl text-on-surface">Publish a Professional Tip</h2>
<p class="font-body-md text-on-surface-variant max-w-2xl">
        Share your refined techniques, pairing secrets, or kitchen shortcuts with the community. Member-submitted tips are curated and published directly to our exclusive Premium library.
      </p>
</div>
<div class="flex items-center gap-3 bg-surface-container-high px-4 py-3 rounded-xl border border-outline-variant/30 shadow-sm">
<span class="material-symbols-outlined text-primary text-[20px]">card_membership</span>
<div class="text-left">
<span class="block font-label-sm text-on-surface-variant uppercase">Publishing Tier</span>
<span class="font-title-md text-primary flex items-center gap-1">
<span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
          Premium Archive
        </span>
</div>
</div>
</div>
<!-- Form Layout: Asymmetric Grid -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
<!-- Main Form Glass Card -->
<div class="lg:col-span-8 bg-[#12362F]/75 backdrop-blur-[16px] p-8 rounded-xl shadow-xl relative overflow-hidden ring-1 ring-[#f6efe3]/10">
<!-- Ambient interior glow -->
<div class="absolute -top-24 -right-24 w-64 h-64 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
<form class="space-y-6 relative z-10" id="add-tip-form" onsubmit="event.preventDefault(); showToast();">
<!-- Tip Title -->
<div class="space-y-2">
<label class="block font-label-md text-on-surface uppercase tracking-wider">Tip Title <span class="text-primary">*</span></label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3.5 top-3.5 text-outline text-[18px]">title</span>
<input class="w-full bg-[#0A211E] text-on-surface placeholder:text-outline text-body-md rounded-xl pl-11 pr-4 py-3 border border-outline-variant/40 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all shadow-inner" placeholder="e.g., The Secret to Crystal-Clear Consomé Every Time" required="" type="text"/>
</div>
<p class="font-body-sm text-on-surface-variant/70">Craft a compelling, descriptive headline for your culinary insight.</p>
</div>
<!-- Category Dropdown -->
<div class="space-y-2">
<label class="block font-label-md text-on-surface uppercase tracking-wider">Category <span class="text-primary">*</span></label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3.5 top-3.5 text-outline text-[18px]">category</span>
<select class="w-full bg-[#0A211E] text-on-surface text-body-md rounded-xl pl-11 pr-10 py-3 border border-outline-variant/40 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all appearance-none cursor-pointer shadow-inner" required="">
<option disabled="" selected="" value="">Select kitchen domain...</option>
<option value="knife-skills">Knife Skills &amp; Prep</option>
<option value="sauces-stocks">Sauces &amp; Stocks</option>
<option value="baking-pastry">Baking &amp; Pastry Precision</option>
<option value="heat-control">Heat Control &amp; Searing</option>
<option value="plating-aesthetics">Plating &amp; Presentation</option>
<option value="flavor-pairing">Flavor Pairing &amp; Seasoning</option>
</select>
<span class="material-symbols-outlined absolute right-3.5 top-3.5 text-outline text-[20px] pointer-events-none">expand_more</span>
</div>
</div>
<!-- Tip Description Textarea -->
<div class="space-y-2">
<label class="block font-label-md text-on-surface uppercase tracking-wider">Tip Description &amp; Methodology <span class="text-primary">*</span></label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3.5 top-3.5 text-outline text-[18px]">description</span>
<textarea class="w-full bg-[#0A211E] text-on-surface placeholder:text-outline text-body-md rounded-xl pl-11 pr-4 py-3 border border-outline-variant/40 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all resize-y shadow-inner" placeholder="Describe your technique step-by-step. Include the science, the exact conditions, and why this elevates the dish..." required="" rows="6"></textarea>
</div>
<div class="flex justify-between items-center text-body-sm text-on-surface-variant/70">
<span>Markdown formatting supported.</span>
<span id="char-count">0 / 2000 chars</span>
</div>
</div>
<!-- Optional Image Upload Drop Zone -->
<div class="space-y-2">
<label class="block font-label-md text-on-surface uppercase tracking-wider">Demonstration Visual (Optional)</label>
<div class="border-2 border-dashed border-outline-variant/50 hover:border-primary/60 rounded-xl p-8 text-center bg-[#0A211E]/50 hover:bg-[#0A211E] transition-all cursor-pointer group relative">
<input accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20" onchange="updateFileName(this)" type="file"/>
<div class="flex flex-col items-center justify-center space-y-3 relative z-10 pointer-events-none">
<div class="w-12 h-12 rounded-full bg-surface-container-highest flex items-center justify-center text-primary group-hover:scale-110 transition-transform shadow-md">
<span class="material-symbols-outlined text-[24px]">cloud_upload</span>
</div>
<div class="space-y-1">
<p class="font-title-md text-on-surface group-hover:text-primary transition-colors">Drag &amp; drop visual evidence here</p>
<p class="font-body-sm text-on-surface-variant" id="file-upload-label">Supports high-res PNG, JPG, WebP up to 15MB</p>
</div>
<span class="inline-block px-3 py-1 rounded-full bg-surface-container text-label-sm text-primary border border-outline-variant/30">Browse Files</span>
</div>
</div>
</div>
<!-- Form Actions -->
<div class="flex items-center justify-end gap-4 pt-6 border-t border-outline-variant/20">
<a class="px-6 py-3 rounded-full text-on-surface-variant hover:text-on-surface font-title-md transition-colors" href="#">
            Cancel
          </a>
<button class="px-8 py-3.5 rounded-full bg-primary hover:bg-[#E8A173] text-on-primary font-title-md shadow-[0_4px_16px_rgba(217,138,86,0.25)] hover:shadow-[0_6px_24px_rgba(217,138,86,0.40)] transition-all flex items-center gap-2 cursor-pointer" type="submit">
<span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">publish</span>
            Submit Tip
          </button>
</div>
</form>
</div>
<!-- Sidebar Guidelines & Preview Card -->
    lg:col-span-4 space-y-6"&gt;
      
      <!-- Expert Guidelines -->
<div class="bg-[#12362F]/75 backdrop-blur-[16px] p-6 rounded-xl shadow-xl ring-1 ring-[#f6efe3]/10 space-y-4">
<div class="flex items-center gap-3 text-primary">
<span class="material-symbols-outlined text-[24px]">workspace_premium</span>
<h3 class="font-headline-sm text-on-surface">The Executive Standard</h3>
</div>
<p class="font-body-sm text-on-surface-variant leading-relaxed">
          Tips published to The Sanctuary undergo peer review by our executive kitchen panel. Ensure your instructions are precise, reproducible, and offer authentic culinary value.
        </p>
<div class="space-y-3 pt-2">
<div class="flex items-start gap-3">
<span class="material-symbols-outlined text-secondary text-[18px] mt-0.5">check_circle</span>
<span class="font-body-sm text-on-surface">Provide exact measurements or time markers.</span>
</div>
<div class="flex items-start gap-3">
<span class="material-symbols-outlined text-secondary text-[18px] mt-0.5">check_circle</span>
<span class="font-body-sm text-on-surface">Explain the 'why' behind the technique.</span>
</div>
<div class="flex items-start gap-3">
<span class="material-symbols-outlined text-secondary text-[18px] mt-0.5">check_circle</span>
<span class="font-body-sm text-on-surface">High-contrast photos increase member engagement by 40%.</span>
</div>
</div>
</div>
<!-- Live Metadata Preview Box -->
<div class="bg-[#0A211E] p-6 rounded-xl border border-outline-variant/30 space-y-4 relative overflow-hidden">
<div class="absolute top-0 right-0 w-32 h-32 bg-secondary/5 rounded-full blur-2xl pointer-events-none"></div>
<div class="flex items-center justify-between">
<span class="font-label-md text-outline uppercase tracking-wider">Live Preview Badge</span>
<span class="px-2.5 py-1 rounded-full bg-[#D98A56]/18 border border-[#D98A56]/45 text-[#D98A56] text-label-sm font-semibold flex items-center gap-1">
<span class="material-symbols-outlined text-[12px]" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
            PREMIUM TIP
          </span>
</div>
<div class="space-y-1">
<h4 class="font-headline-sm text-on-surface line-clamp-1">Your Tip Headline Appears Here</h4>
<p class="font-body-sm text-on-surface-variant/70 line-clamp-2">Category selection and short description will be indexed instantly upon successful submission.</p>
</div>
<div class="pt-2 flex items-center justify-between text-label-sm text-outline border-t border-outline-variant/20">
<span>By Executive Chef (You)</span>
<span>Pending Review</span>
</div>
</div>
</div>
</div>
<!-- Toast Notification (Hidden by default) -->
<div class="fixed bottom-8 right-8 bg-[#0A211E] border-l-4 border-primary text-on-surface px-6 py-4 rounded-xl shadow-2xl backdrop-blur-xl transform translate-y-24 opacity-0 transition-all duration-300 z-50 flex items-center gap-4" id="success-toast">
<div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center text-primary">
<span class="material-symbols-outlined text-[22px]">verified</span>
</div>
<div>
<h5 class="font-title-md text-on-surface">Tip Submitted Successfully</h5>
<p class="font-body-sm text-on-surface-variant">Your submission is now queued for Premium archival review.</p>
</div>
</div>
<script>
    // Character counter simulation
    const textarea = document.querySelector('textarea');
    const charCount = document.getElementById('char-count');
    if (textarea && charCount) {
      textarea.addEventListener('input', (e) => {
        const len = e.target.value.length;
        charCount.textContent = `${len} / 2000 chars`;
      });
    }

    // File name update simulation
    function updateFileName(input) {
      const label = document.getElementById('file-upload-label');
      if (input.files && input.files[0]) {
        label.textContent = `Selected: ${input.files[0].name}`;
        label.classList.add('text-primary', 'font-semibold');
      }
    }

    // Toast trigger simulation
    function showToast() {
      const toast = document.getElementById('success-toast');
      toast.classList.remove('translate-y-24', 'opacity-0');
      setTimeout(() => {
        toast.classList.add('translate-y-24', 'opacity-0');
      }, 4000);
    }
  </script>
