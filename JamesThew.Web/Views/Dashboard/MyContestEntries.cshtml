<!-- Client-side filter script -->
<script>
    function filterEntries(category) {
      const rows = document.querySelectorAll('#entriesTable tbody tr');
      const tabs = ['all', 'pending', 'winner'];
      
      tabs.forEach(tab => {
        const btn = document.getElementById('tab-' + tab);
        if (tab === category) {
          btn.className = "px-5 py-2 rounded-full font-label-md text-on-surface bg-primary-container/20 transition-all";
        } else {
          btn.className = "px-5 py-2 rounded-full font-label-md text-on-surface-variant hover:text-on-surface transition-all";
        }
      });

      rows.forEach(row => {
        if (category === 'all' || row.dataset.category === category) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    function searchEntries() {
      const input = document.getElementById('entrySearch').value.toLowerCase();
      const rows = document.querySelectorAll('#entriesTable tbody tr');
      
      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        if (text.includes(input)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }
  </script>
