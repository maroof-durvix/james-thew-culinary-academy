@model JamesThew.Web.Models.ViewModels.DashboardHomeViewModel
@{
    ViewData["Title"] = "Dashboard Overview";
    Layout = "_DashboardLayout";
}

<!-- Welcome & Membership Header -->
<div class="flex flex-col xl:flex-row xl:items-center xl:justify-between gap-6 mb-12">
    <div>
        <span class="text-label-md uppercase tracking-widest text-primary mb-2 block">The Sanctuary Member Portal</span>
        <h1 class="text-headline-xl font-headline text-on-surface">Welcome back, @Model.User.FullName</h1>
        <p class="text-body-md text-on-surface-variant mt-1">Your culinary dashboard is primed. Manage recipes, tips, and active competition entries.</p>
    </div>
    
    <!-- Membership Card Tier 1 Glass -->
    <div class="flex items-center justify-between gap-8 bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] p-6 rounded-xl shadow-lg relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-primary/10 rounded-full blur-2xl pointer-events-none"></div>
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-primary/20 border border-primary/40 flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-[24px]">workspace_premium</span>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    @if (Model.ActiveSubscription != null)
                    {
                        <span class="px-2.5 py-0.5 rounded-full text-label-sm font-semibold bg-primary/20 text-primary border border-primary/40 flex items-center gap-1">
                            <span class="material-symbols-outlined text-[12px]">crown</span> @Model.ActiveSubscription.Plan
                        </span>
                    }
                    else
                    {
                        <span class="px-2.5 py-0.5 rounded-full text-label-sm font-semibold bg-[#9AD3B3]/20 text-[#9AD3B3] border border-[#9AD3B3]/40 flex items-center gap-1">
                            <span class="material-symbols-outlined text-[12px]">person</span> Free Explorer
                        </span>
                    }
                </div>
                <p class="text-body-sm text-on-surface-variant mt-1">
                    @(Model.ActiveSubscription != null 
                        ? $"Renews {Model.ActiveSubscription.ExpiryDate.ToString("MMMM dd, yyyy")}" 
                        : "Limited access to free archive")
                </p>
            </div>
        </div>
        <a asp-action="Subscription" class="bg-primary hover:bg-[#E8A173] text-on-primary font-title-md px-5 py-2.5 rounded-full shadow-[0_4px_16px_rgba(217,138,86,0.25)] transition-all flex items-center gap-2">
            <span>@(Model.ActiveSubscription != null ? "Manage Plan" : "Upgrade Plan")</span>
            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>
    </div>
</div>

<!-- Quick Actions Bar -->
<div class="flex flex-wrap items-center gap-4 mb-10">
    <a asp-action="AddRecipe" class="bg-primary hover:bg-[#E8A173] text-on-primary font-title-md px-6 py-3 rounded-full shadow-[0_4px_16px_rgba(217,138,86,0.25)] transition-all flex items-center gap-2">
        <span class="material-symbols-outlined text-[20px]">add_circle</span>
        <span>Add Recipe</span>
    </a>
    <a asp-action="AddTip" class="bg-transparent hover:bg-[rgba(246,239,227,0.08)] text-on-surface border-[1.5px] border-[rgba(246,239,227,0.4)] font-title-md px-6 py-3 rounded-full transition-all flex items-center gap-2">
        <span class="material-symbols-outlined text-[20px]">note_add</span>
        <span>Add Tip</span>
    </a>
    <a asp-controller="Contests" asp-action="Index" class="bg-transparent hover:bg-[rgba(246,239,227,0.08)] text-on-surface border-[1.5px] border-[rgba(246,239,227,0.4)] font-title-md px-6 py-3 rounded-full transition-all flex items-center gap-2">
        <span class="material-symbols-outlined text-[20px]">emoji_events</span>
        <span>Browse Contests</span>
    </a>
</div>

<!-- 4 KPI Stat Cards Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6 mb-12">
    <!-- Card 1 -->
    <a asp-action="MyRecipes" class="bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] p-6 rounded-xl shadow-sm hover:border-primary/50 transition-all group block">
        <div class="flex items-center justify-between mb-4">
            <span class="text-label-sm uppercase tracking-wider text-on-surface-variant">My Recipes</span>
            <div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-[20px]">menu_book</span>
            </div>
        </div>
        <div class="flex items-baseline justify-between">
            <span class="text-headline-lg font-headline text-on-surface">@Model.MyRecipesCount</span>
            <span class="text-label-sm text-[#5DBB8A] flex items-center gap-1">
                <span class="material-symbols-outlined text-[14px]">visibility</span> View Archive
            </span>
        </div>
    </a>

    <!-- Card 2 -->
    <a asp-action="Tips" class="bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] p-6 rounded-xl shadow-sm hover:border-primary/50 transition-all group block">
        <div class="flex items-center justify-between mb-4">
            <span class="text-label-sm uppercase tracking-wider text-on-surface-variant">My Tips</span>
            <div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-[20px]">lightbulb</span>
            </div>
        </div>
        <div class="flex items-baseline justify-between">
            <span class="text-headline-lg font-headline text-on-surface">@Model.MyTipsCount</span>
            <span class="text-label-sm text-[#5DBB8A] flex items-center gap-1">
                <span class="material-symbols-outlined text-[14px]">check_circle</span> Published
            </span>
        </div>
    </a>

    <!-- Card 3 -->
    <a asp-action="ContestEntries" class="bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] p-6 rounded-xl shadow-sm hover:border-primary/50 transition-all group block">
        <div class="flex items-center justify-between mb-4">
            <span class="text-label-sm uppercase tracking-wider text-on-surface-variant">Contest Entries</span>
            <div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-[20px]">military_tech</span>
            </div>
        </div>
        <div class="flex items-baseline justify-between">
            <span class="text-headline-lg font-headline text-on-surface">@Model.MyEntriesCount</span>
            <span class="text-label-sm text-[#F5A623] flex items-center gap-1">
                <span class="material-symbols-outlined text-[14px]">emoji_events</span> Submissions
            </span>
        </div>
    </a>

    <!-- Card 4 -->
    <a asp-action="Subscription" class="bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] p-6 rounded-xl shadow-sm hover:border-primary/50 transition-all group block">
        <div class="flex items-center justify-between mb-4">
            <span class="text-label-sm uppercase tracking-wider text-on-surface-variant">Membership Tier</span>
            <div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-[20px]">card_membership</span>
            </div>
        </div>
        <div class="flex items-baseline justify-between">
            <span class="text-title-lg font-headline text-on-surface">@Model.User.Role</span>
            <span class="text-label-sm text-primary">Manage</span>
        </div>
    </a>
</div>

<!-- Active Contest Banner & Recent Activity Layout -->
<div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
    <!-- Recent Activity (2 Cols on Desktop) -->
    <div class="xl:col-span-2 bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] p-8 rounded-xl shadow-lg flex flex-col">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-headline-sm font-headline text-on-surface">My Recent Submissions</h2>
            <a asp-action="MyRecipes" class="text-label-md text-primary hover:underline">View All</a>
        </div>
        <div class="space-y-4 flex-1">
            @if (!Model.RecentRecipes.Any() && !Model.RecentTips.Any())
            {
                <div class="p-8 text-center text-on-surface-variant">
                    <p class="text-body-md">No activity recorded yet. Start by publishing your first recipe or culinary technique tip!</p>
                </div>
            }
            @foreach (var rec in Model.RecentRecipes)
            {
                <div class="flex items-start gap-4 p-4 rounded-xl bg-[#184238]/50 border border-[rgba(246,239,227,0.06)] hover:bg-[#184238] transition-all">
                    <div class="w-10 h-10 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0 mt-0.5">
                        <span class="material-symbols-outlined text-[18px]">menu_book</span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center justify-between">
                            <h3 class="text-title-md text-on-surface truncate">Recipe: @rec.Title</h3>
                            <span class="text-label-sm text-on-surface-variant">@rec.CreatedAt.ToString("MMM dd")</span>
                        </div>
                        <p class="text-body-sm text-on-surface-variant mt-1">@rec.Category?.Name · @rec.PrepMinutes mins prep · @rec.Access Tier</p>
                    </div>
                </div>
            }
            @foreach (var tip in Model.RecentTips)
            {
                <div class="flex items-start gap-4 p-4 rounded-xl bg-[#184238]/50 border border-[rgba(246,239,227,0.06)] hover:bg-[#184238] transition-all">
                    <div class="w-10 h-10 rounded-full bg-secondary/20 text-secondary flex items-center justify-center shrink-0 mt-0.5">
                        <span class="material-symbols-outlined text-[18px]">lightbulb</span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center justify-between">
                            <h3 class="text-title-md text-on-surface truncate">Tip: @tip.Title</h3>
                            <span class="text-label-sm text-on-surface-variant">@tip.CreatedAt.ToString("MMM dd")</span>
                        </div>
                        <p class="text-body-sm text-on-surface-variant mt-1">@tip.Category?.Name · @tip.Access Tier</p>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Active Contest Mini Banner & Quick Highlights -->
    <div class="flex flex-col gap-6">
        <!-- Active Contest Banner -->
        <div class="relative bg-gradient-to-br from-[#184238] to-[#12362F] border border-primary/30 p-8 rounded-xl shadow-xl overflow-hidden flex flex-col justify-between">
            <div class="absolute -right-12 -top-12 w-40 h-40 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
            <div>
                <div class="flex items-center gap-2 mb-3">
                    <span class="px-2.5 py-0.5 rounded-full text-label-sm font-semibold bg-[#F5A623]/15 text-[#F5A623] border border-[#F5A623]/30 flex items-center gap-1">
                        <span class="material-symbols-outlined text-[12px]">emoji_events</span> Culinary Competitions
                    </span>
                </div>
                <h2 class="text-headline-md font-headline text-on-surface mb-2">Quarterly Chef Challenges</h2>
                <p class="text-body-sm text-on-surface-variant mb-6">Showcase your signature creations in seasonal contests judged by Chef James Thew. Win prestigious accolades and masterclass passes.</p>
            </div>
            <a asp-controller="Contests" asp-action="Index" class="w-full bg-primary hover:bg-[#E8A173] text-on-primary font-title-md py-3 rounded-full shadow-[0_4px_16px_rgba(217,138,86,0.25)] transition-all flex items-center justify-center gap-2">
                <span>Explore Contests</span>
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
        </div>

        <!-- Quick Tips & Advisory Box -->
        <div class="bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] p-6 rounded-xl shadow-sm">
            <div class="flex items-center gap-3 mb-4">
                <span class="material-symbols-outlined text-primary text-[24px]">verified</span>
                <h3 class="text-title-md text-on-surface">Chef's Advisory</h3>
            </div>
            <p class="text-body-sm text-on-surface-variant leading-relaxed">
                "Precision in preparation separates the novice from the artisan. Always temper your proteins 20 minutes before execution."
                <span class="block mt-2 text-label-sm text-primary font-semibold">— Executive Chef James Thew</span>
            </p>
        </div>
    </div>
</div>
