@{
    ViewData["Title"] = "Overview";
}

<div class="flex flex-col w-full">
<!-- Welcome & Membership Header -->
<div class="flex flex-col xl:flex-row xl:items-center xl:justify-between gap-6 mb-12">
<div>
<span class="text-label-md uppercase tracking-widest text-primary mb-2 block">Sanctuary Member Portal</span>
<h1 class="text-headline-xl font-headline text-on-surface">Welcome back, Evelyn Vance</h1>
<p class="text-body-md text-on-surface-variant mt-1">Your culinary dashboard is primed. 2 pending reviews require your attention.</p>
</div>
<!-- Membership Card Tier 1 Glass -->
<div class="flex items-center justify-between gap-8 bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] p-6 rounded-xl shadow-lg relative overflow-hidden">
<div class="absolute -right-10 -bottom-10 w-32 h-32 bg-primary/10 rounded-full blur-2xl pointer-events-none"></div>
<div class="flex items-center gap-4">
<div class="w-12 h-12 rounded-xl bg-primary/20 border border-primary/40 flex items-center justify-center text-primary">
<span class="material-symbols-outlined text-[24px]">workspace_premium</span>
</div>
<div>
<div class="flex items-center gap-2">
<span class="px-2.5 py-0.5 rounded-full text-label-sm font-semibold bg-primary/20 text-primary border border-primary/40 flex items-center gap-1">
<span class="material-symbols-outlined text-[12px]">crown</span> Yearly Member
            </span>
</div>
<p class="text-body-sm text-on-surface-variant mt-1">Renews March 1, 2027</p>
</div>
</div>
<button class="bg-primary hover:bg-[#E8A173] text-on-primary font-title-md px-5 py-2.5 rounded-full shadow-[0_4px_16px_rgba(217,138,86,0.25)] transition-all flex items-center gap-2">
<span>Renew / Change</span>
<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</button>
</div>
</div>
<!-- Quick Actions Bar -->
<div class="flex flex-wrap items-center gap-4 mb-10">
<a class="bg-primary hover:bg-[#E8A173] text-on-primary font-title-md px-6 py-3 rounded-full shadow-[0_4px_16px_rgba(217,138,86,0.25)] transition-all flex items-center gap-2" data-path="add-recipe" href="#">
<span class="material-symbols-outlined text-[20px]">add_circle</span>
<span>Add Recipe</span>
</a>
<a class="bg-transparent hover:bg-[rgba(246,239,227,0.08)] text-on-surface border-[1.5px] border-[rgba(246,239,227,0.4)] font-title-md px-6 py-3 rounded-full transition-all flex items-center gap-2" data-path="add-tip" href="#">
<span class="material-symbols-outlined text-[20px]">note_add</span>
<span>Add Tip</span>
</a>
</div>
<!-- 4 KPI Stat Cards Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6 mb-12">
<!-- Card 1 -->
<div class="bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] p-6 rounded-xl shadow-sm hover:border-primary/50 transition-all group">
<div class="flex items-center justify-between mb-4">
<span class="text-label-sm uppercase tracking-wider text-on-surface-variant">My Recipes</span>
<div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-[20px]">menu_book</span>
</div>
</div>
<div class="flex items-baseline justify-between">
<span class="text-headline-lg font-headline text-on-surface">12</span>
<span class="text-label-sm text-[#5DBB8A] flex items-center gap-1">
<span class="material-symbols-outlined text-[14px]">trending_up</span> +2 this month
        </span>
</div>
</div>
<!-- Card 2 -->
<div class="bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] p-6 rounded-xl shadow-sm hover:border-primary/50 transition-all group">
<div class="flex items-center justify-between mb-4">
<span class="text-label-sm uppercase tracking-wider text-on-surface-variant">My Tips</span>
<div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-[20px]">lightbulb</span>
</div>
</div>
<div class="flex items-baseline justify-between">
<span class="text-headline-lg font-headline text-on-surface">8</span>
<span class="text-label-sm text-[#5DBB8A] flex items-center gap-1">
<span class="material-symbols-outlined text-[14px]">check_circle</span> 100% published
        </span>
</div>
</div>
<!-- Card 3 -->
<div class="bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] p-6 rounded-xl shadow-sm hover:border-primary/50 transition-all group">
<div class="flex items-center justify-between mb-4">
<span class="text-label-sm uppercase tracking-wider text-on-surface-variant">Contest Entries</span>
<div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-[20px]">military_tech</span>
</div>
</div>
<div class="flex items-baseline justify-between">
<span class="text-headline-lg font-headline text-on-surface">3</span>
<span class="text-label-sm text-[#F5A623] flex items-center gap-1">
<span class="material-symbols-outlined text-[14px]">schedule</span> 1 active finalist
        </span>
</div>
</div>
<!-- Card 4 -->
<div class="bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] p-6 rounded-xl shadow-sm hover:border-primary/50 transition-all group">
<div class="flex items-center justify-between mb-4">
<span class="text-label-sm uppercase tracking-wider text-on-surface-variant">Feedback Given</span>
<div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-[20px]">reviews</span>
</div>
</div>
<div class="flex items-baseline justify-between">
<span class="text-headline-lg font-headline text-on-surface">5</span>
<span class="text-label-sm text-on-surface-variant">Peer reviews</span>
</div>
</div>
</div>
<!-- Active Contest Banner & Recent Activity Layout -->
<div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
<!-- Recent Activity (2 Cols on Desktop) -->
<div class="xl:col-span-2 bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] p-8 rounded-xl shadow-lg flex flex-col">
<div class="flex items-center justify-between mb-6">
<h2 class="text-headline-sm font-headline text-on-surface">Recent Activity</h2>
<a class="text-label-md text-primary hover:underline" href="#">View All Log</a>
</div>
<div class="space-y-4 flex-1">
<!-- Activity Item 1 -->
<div class="flex items-start gap-4 p-4 rounded-xl bg-[#184238]/50 border border-[rgba(246,239,227,0.06)] hover:bg-[#184238] transition-all">
<div class="w-10 h-10 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0 mt-0.5">
<span class="material-symbols-outlined text-[18px]">menu_book</span>
</div>
<div class="flex-1 min-w-0">
<div class="flex items-center justify-between">
<h3 class="text-title-md text-on-surface truncate">Submitted new recipe: Tuscan Truffle Risotto</h3>
<span class="text-label-sm text-on-surface-variant">2 hours ago</span>
</div>
<p class="text-body-sm text-on-surface-variant mt-1">Added to main archive under Italian Culinary Arts. Awaiting final chef review.</p>
</div>
</div>
<!-- Activity Item 2 -->
<div class="flex items-start gap-4 p-4 rounded-xl bg-[#184238]/50 border border-[rgba(246,239,227,0.06)] hover:bg-[#184238] transition-all">
<div class="w-10 h-10 rounded-full bg-secondary/20 text-secondary flex items-center justify-center shrink-0 mt-0.5">
<span class="material-symbols-outlined text-[18px]">military_tech</span>
</div>
<div class="flex-1 min-w-0">
<div class="flex items-center justify-between">
<h3 class="text-title-md text-on-surface truncate">Contest Entry Approved: Summer Citrus Reduction</h3>
<span class="text-label-sm text-on-surface-variant">Yesterday</span>
</div>
<p class="text-body-sm text-on-surface-variant mt-1">Successfully registered for the annual Grand Kitchencraft Championship.</p>
</div>
</div>
<!-- Activity Item 3 -->
<div class="flex items-start gap-4 p-4 rounded-xl bg-[#184238]/50 border border-[rgba(246,239,227,0.06)] hover:bg-[#184238] transition-all">
<div class="w-10 h-10 rounded-full bg-tertiary/20 text-tertiary flex items-center justify-center shrink-0 mt-0.5">
<span class="material-symbols-outlined text-[18px]">lightbulb</span>
</div>
<div class="flex-1 min-w-0">
<div class="flex items-center justify-between">
<h3 class="text-title-md text-on-surface truncate">Published culinary tip: Maintaining Carbon Steel Pans</h3>
<span class="text-label-sm text-on-surface-variant">3 days ago</span>
</div>
<p class="text-body-sm text-on-surface-variant mt-1">Shared valuable seasoning advice with the Sanctuary community.</p>
</div>
</div>
</div>
</div>
<!-- Active Contest Mini Banner & Quick Highlights -->
<div class="flex flex-col gap-6">
<!-- Active Contest Banner -->
<div class="relative bg-gradient-to-br from-[#184238] to-[#12362F] border border-primary/30 p-8 rounded-xl shadow-xl overflow-hidden flex flex-col justify-between">
<div class="absolute -right-12 -top-12 w-40 h-40 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
<div>
<div class="flex items-center gap-2 mb-3">
<span class="px-2.5 py-0.5 rounded-full text-label-sm font-semibold bg-[#F5A623]/15 text-[#F5A623] border border-[#F5A623]/30 flex items-center gap-1">
<span class="material-symbols-outlined text-[12px]">timer</span> Ends in 12 Days
            </span>
</div>
<h2 class="text-headline-md font-headline text-on-surface mb-2">Best Italian Recipe or Summer Juice Tip</h2>
<p class="text-body-sm text-on-surface-variant mb-6">Showcase your mastery of artisanal pasta or refreshing botanical extracts for a chance to win the Michelin Masterclass pass.</p>
</div>
<button class="w-full bg-primary hover:bg-[#E8A173] text-on-primary font-title-md py-3 rounded-full shadow-[0_4px_16px_rgba(217,138,86,0.25)] transition-all flex items-center justify-center gap-2">
<span>Participate Now</span>
<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</button>
</div>
<!-- Quick Tips & Advisory Box -->
<div class="bg-[#12362F]/75 backdrop-blur-[16px] border border-[rgba(246,239,227,0.12)] p-6 rounded-xl shadow-sm">
<div class="flex items-center gap-3 mb-4">
<span class="material-symbols-outlined text-primary text-[24px]">verified</span>
<h3 class="text-title-md text-on-surface">Chef's Advisory</h3>
</div>
<p class="text-body-sm text-on-surface-variant leading-relaxed">
          "Precision in preparation separates the novice from the artisan. Always temper your proteins 20 minutes before execution."
          <span class="block mt-2 text-label-sm text-primary font-semibold">— Executive Chef James Thew</span>
</p>
</div>
</div>
</div>
</div>
