@{
    ViewData["Title"] = "Add Recipe";
}

<div class="flex flex-col w-full">
<!-- Top Section / Greeting Header -->
<div class="flex flex-col md:flex-row md:items-end justify-between mb-space-xl gap-4">
<div>
<span class="text-label-md uppercase tracking-wider text-primary mb-space-xs block">Culinary Archive Entry</span>
<h2 class="text-headline-xl font-headline text-on-surface">Publish New Creation</h2>
</div>
<div class="flex items-center gap-3">
<span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-label-sm font-semibold bg-primary/15 text-primary border border-primary/30">
<span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
        Member Tier: Exclusive Premium Publication
      </span>
</div>
</div>
<!-- Main Grid Layout (Asymmetric 8:4 Split) -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
<!-- Left Column: Add Recipe Form (8 Columns) -->
<div class="lg:col-span-8 bg-surface-container/75 backdrop-blur-[16px] rounded-xl p-space-lg md:p-space-xl shadow-xl relative overflow-hidden">
<!-- Inner ambient glow -->
<div class="absolute -top-24 -right-24 w-72 h-72 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
<form class="space-y-space-lg relative z-10" onsubmit="event.preventDefault(); showSuccessToast();">
<!-- Recipe Title -->
<div class="space-y-space-xs">
<label class="block text-title-md text-on-surface font-title">Recipe Title</label>
<input class="w-full bg-[#0A211E] text-on-surface placeholder:text-on-surface-variant text-body-md rounded-xl px-4 py-3 border border-outline-variant focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" placeholder="e.g., Truffle Infused Wild Mushroom Risotto" required="" type="text"/>
</div>
<!-- Category & Times Grid -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-space-md">
<!-- Category Dropdown -->
<div class="space-y-space-xs">
<label class="block text-title-md text-on-surface font-title">Category</label>
<div class="relative">
<select class="w-full bg-[#0A211E] text-on-surface text-body-md rounded-xl px-4 py-3 border border-outline-variant focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all appearance-none cursor-pointer">
<option value="vegetarian">Vegetarian</option>
<option value="non-vegetarian">Non-Vegetarian</option>
<option value="italian">Italian</option>
<option value="juices">Juices &amp; Elixirs</option>
</select>
<span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none">expand_more</span>
</div>
</div>
<!-- Preparation Time -->
<div class="space-y-space-xs">
<label class="block text-title-md text-on-surface font-title">Preparation Time</label>
<div class="relative">
<input class="w-full bg-[#0A211E] text-on-surface placeholder:text-on-surface-variant text-body-md rounded-xl pl-4 pr-10 py-3 border border-outline-variant focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" placeholder="e.g., 25 mins" required="" type="text"/>
<span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">schedule</span>
</div>
</div>
<!-- Cooking Time -->
<div class="space-y-space-xs">
<label class="block text-title-md text-on-surface font-title">Cooking Time</label>
<div class="relative">
<input class="w-full bg-[#0A211E] text-on-surface placeholder:text-on-surface-variant text-body-md rounded-xl pl-4 pr-10 py-3 border border-outline-variant focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" placeholder="e.g., 40 mins" required="" type="text"/>
<span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">timer</span>
</div>
</div>
</div>
<!-- Ingredients Textarea -->
<div class="space-y-space-xs">
<div class="flex justify-between items-center">
<label class="block text-title-md text-on-surface font-title">Ingredients List</label>
<span class="text-label-sm text-on-surface-variant">one ingredient per line</span>
</div>
<textarea class="w-full bg-[#0A211E] text-on-surface placeholder:text-on-surface-variant text-body-md rounded-xl p-4 border border-outline-variant focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all resize-y" placeholder="2 cups Carnaroli rice
400g fresh wild porcini mushrooms
1L warm vegetable stock
1/2 cup aged Parmigiano-Reggiano" required="" rows="4"></textarea>
</div>
<!-- Cooking Procedure Textarea -->
<div class="space-y-space-xs">
<div class="flex justify-between items-center">
<label class="block text-title-md text-on-surface font-title">Cooking Procedure</label>
<span class="text-label-sm text-on-surface-variant">one step per line</span>
</div>
<textarea class="w-full bg-[#0A211E] text-on-surface placeholder:text-on-surface-variant text-body-md rounded-xl p-4 border border-outline-variant focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all resize-y" placeholder="Gently warm the vegetable stock in a separate saucepan over low heat.
Sauté sliced wild mushrooms in extra virgin olive oil until golden brown.
Toast the Carnaroli rice dry in a heavy-bottomed pan before adding wine.
Gradually ladle warm stock into the rice while stirring continuously." required="" rows="5"></textarea>
</div>
<!-- Image Upload Drop Zone -->
<div class="space-y-space-xs">
<label class="block text-title-md text-on-surface font-title">Recipe Imagery</label>
<div class="border-2 border-dashed border-outline-variant hover:border-primary rounded-xl p-space-lg text-center bg-[#0A211E]/50 transition-all cursor-pointer relative group" id="drop-zone">
<input accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full" onchange="previewImage(event)" type="file"/>
<div class="flex flex-col items-center justify-center space-y-2" id="upload-prompt">
<div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-[24px]">cloud_upload</span>
</div>
<div>
<p class="text-title-md text-on-surface">Drop your culinary photography here, or <span class="text-primary underline">browse</span></p>
<p class="text-body-sm text-on-surface-variant mt-1">High-resolution PNG, JPG or WEBP up to 10MB (16:10 ratio recommended)</p>
</div>
</div>
<!-- Image Preview Container (Hidden by default) -->
<div class="hidden relative w-full h-48 rounded-lg overflow-hidden" id="preview-container">
<img class="w-full h-full object-cover" data-alt="Uploaded culinary dish preview showing finished recipe presentation" id="image-preview" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAxRBz5-71RMiK1oEEEYzNnkyWGjcTw9nKXpmA4bA4ZxDj1kgIj2u5v3W2MYHFaTjxaO3eGeEkUel0l8v1vF9VKGcGmOACnMQIrBn_DMovZCvbRFNHIpJLWFyx2UJICdqTvrUxgHMAbm0qI_ZVkWinpLAAB6ywAo6cyxGF5dhzebA-OpZJCG89hBZkcLqOpq597JoSESOHV5kh1-85rLxlgr_Yuze2YfWH2oARs4LsHaPju_3tK9h29"/>
<button class="absolute top-3 right-3 bg-surface/80 hover:bg-error text-on-surface p-2 rounded-full backdrop-blur-md transition-colors" onclick="resetImage(event)" type="button">
<span class="material-symbols-outlined text-[16px]">close</span>
</button>
</div>
</div>
</div>
<!-- Info Note -->
<div class="flex items-start gap-3 p-4 rounded-xl bg-primary/10 border border-primary/20 text-on-surface">
<span class="material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5">info</span>
<p class="text-body-sm">
<strong class="font-semibold text-primary">Publication Notice:</strong> All member-submitted recipes undergo sommelier and chef review before being published as <span class="text-primary font-semibold">Premium</span> content within The Sanctuary archive.
          </p>
</div>
<!-- Action Buttons -->
<div class="flex items-center justify-end gap-4 pt-space-md">
<button class="px-6 py-3 rounded-full text-title-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all" type="button">
            Cancel
          </button>
<button class="px-8 py-3 rounded-full text-title-md font-semibold bg-primary text-on-primary hover:bg-[#E8A173] transition-all shadow-[0_4px_16px_rgba(217,138,86,0.25)] hover:shadow-[0_6px_24px_rgba(217,138,86,0.40)] flex items-center gap-2" type="submit">
<span class="material-symbols-outlined text-[18px]">verified</span>
            Submit Recipe
          </button>
</div>
</form>
</div>
<!-- Right Column: Sidebar Card & Quick Stats (4 Columns) -->
<div class="lg:col-span-4 space-y-space-lg">
<!-- Tips Card -->
<div class="bg-surface-container/75 backdrop-blur-[16px] rounded-xl p-space-lg shadow-xl relative overflow-hidden border border-primary/10">
<div class="flex items-center gap-2 mb-space-md text-primary">
<span class="material-symbols-outlined text-[24px]" style="font-variation-settings: 'FILL' 1;">lightbulb</span>
<h3 class="text-headline-sm font-headline text-on-surface">Tips for a Great Recipe</h3>
</div>
<div class="space-y-space-md text-body-sm text-on-surface-variant">
<div class="flex gap-3">
<span class="w-6 h-6 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0 font-bold text-label-md">1</span>
<p><strong class="text-on-surface">Precise Measurements:</strong> Always specify exact weights and volumes (e.g., grams or milliliters) for baking and pastry items to ensure reproducibility.</p>
</div>
<div class="flex gap-3">
<span class="w-6 h-6 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0 font-bold text-label-md">2</span>
<p><strong class="text-on-surface">Sensory Cues:</strong> In procedural steps, describe textures and aromas (e.g., "until edges turn golden amber and fragrant") rather than just cooking times.</p>
</div>
<div class="flex gap-3">
<span class="w-6 h-6 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0 font-bold text-label-md">3</span>
<p><strong class="text-on-surface">Plating Suggestions:</strong> Add a brief final note on ideal glassware, dishware, or garnishes to elevate the member dining experience.</p>
</div>
</div>
</div>
<!-- Quick Archive Status Card -->
<div class="bg-surface-container/75 backdrop-blur-[16px] rounded-xl p-space-lg shadow-xl relative overflow-hidden">
<h4 class="text-title-md text-on-surface mb-space-md flex items-center gap-2">
<span class="material-symbols-outlined text-primary text-[18px]">analytics</span>
          Your Contribution Stats
        </h4>
<div class="grid grid-cols-2 gap-4">
<div class="bg-[#0A211E] p-4 rounded-xl border border-outline-variant/50">
<span class="text-headline-lg font-headline text-primary block">12</span>
<span class="text-label-sm text-on-surface-variant uppercase tracking-wider">Published</span>
</div>
<div class="bg-[#0A211E] p-4 rounded-xl border border-outline-variant/50">
<span class="text-headline-lg font-headline text-secondary-fixed block">99.4%</span>
<span class="text-label-sm text-on-surface-variant uppercase tracking-wider">Rating Score</span>
</div>
</div>
</div>
</div>
</div>
<!-- Toast Notification (Hidden Initially) -->
<div class="fixed bottom-8 right-8 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none" id="success-toast">
<div class="bg-[#0A211E] border-l-4 border-primary text-on-surface px-6 py-4 rounded-xl shadow-2xl flex items-center gap-4 backdrop-blur-2xl">
<span class="material-symbols-outlined text-primary text-[24px]">task_alt</span>
<div>
<h5 class="text-title-md font-semibold">Recipe Submitted Successfully</h5>
<p class="text-body-sm text-on-surface-variant">Your recipe has been queued for chef review.</p>
</div>
</div>
</div>
<!-- Client-side Interaction Script -->
<script>
    function previewImage(event) {
      const file = event.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          document.getElementById('image-preview').src = e.target.result;
          document.getElementById('upload-prompt').classList.add('hidden');
          document.getElementById('preview-container').classList.remove('hidden');
        }
        reader.readAsDataURL(file);
      }
    }

    function resetImage(event) {
      event.stopPropagation();
      document.getElementById('image-preview').src = 'placeholder';
      document.getElementById('preview-container').classList.add('hidden');
      document.getElementById('upload-prompt').classList.remove('hidden');
    }

    function showSuccessToast() {
      const toast = document.getElementById('success-toast');
      toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
      setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
      }, 4000);
    }
  </script>
</div>
