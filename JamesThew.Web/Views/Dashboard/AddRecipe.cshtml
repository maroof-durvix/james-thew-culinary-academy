@model JamesThew.Web.Models.ViewModels.AddRecipeViewModel
@{
    ViewData["Title"] = "Add Recipe";
    Layout = "_DashboardLayout";
}

<!-- Top Section / Greeting Header -->
<div class="flex flex-col md:flex-row md:items-end justify-between mb-space-xl gap-4">
    <div>
        <span class="text-label-md uppercase tracking-wider text-primary mb-space-xs block">Culinary Archive Entry</span>
        <h2 class="text-headline-xl font-headline text-on-surface">Publish New Creation</h2>
    </div>
    <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-label-sm font-semibold bg-primary/15 text-primary border border-primary/30">
            <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">restaurant</span>
            Sanctuary Recipe Submission
        </span>
    </div>
</div>

<!-- Main Grid Layout -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
    <!-- Left Column: Add Recipe Form (8 Columns) -->
    <div class="lg:col-span-8 bg-surface-container/75 backdrop-blur-[16px] rounded-xl p-space-lg md:p-space-xl shadow-xl relative overflow-hidden">
        <div class="absolute -top-24 -right-24 w-72 h-72 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>

        <form asp-action="AddRecipe" method="post" enctype="multipart/form-data" class="space-y-space-lg relative z-10">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-error/15 border border-error/30 text-error text-body-sm"></div>

            <!-- Recipe Title -->
            <div class="space-y-space-xs">
                <label asp-for="Title" class="block text-title-md text-on-surface font-title">Recipe Title <span class="text-primary">*</span></label>
                <input asp-for="Title" class="w-full bg-[#0A211E] text-on-surface placeholder:text-on-surface-variant text-body-md rounded-xl px-4 py-3 border border-outline-variant focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" placeholder="e.g., Truffle Infused Wild Mushroom Risotto" required />
                <span asp-validation-for="Title" class="text-error text-label-sm"></span>
            </div>

            <!-- Category, Prep, Cook Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md">
                <!-- Category Dropdown -->
                <div class="space-y-space-xs">
                    <label asp-for="CategoryId" class="block text-title-md text-on-surface font-title">Category <span class="text-primary">*</span></label>
                    <div class="relative">
                        <select asp-for="CategoryId" class="w-full bg-[#0A211E] text-on-surface text-body-md rounded-xl px-4 py-3 border border-outline-variant focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all appearance-none cursor-pointer" required>
                            <option value="">Select Category...</option>
                            @if (Model.AvailableCategories != null)
                            {
                                foreach (var cat in Model.AvailableCategories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            }
                        </select>
                        <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none">expand_more</span>
                    </div>
                    <span asp-validation-for="CategoryId" class="text-error text-label-sm"></span>
                </div>

                <!-- Prep Time -->
                <div class="space-y-space-xs">
                    <label asp-for="PrepMinutes" class="block text-title-md text-on-surface font-title">Prep Time (mins)</label>
                    <div class="relative">
                        <input asp-for="PrepMinutes" type="number" min="1" max="1440" class="w-full bg-[#0A211E] text-on-surface placeholder:text-on-surface-variant text-body-md rounded-xl pl-4 pr-10 py-3 border border-outline-variant focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" required />
                        <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">schedule</span>
                    </div>
                    <span asp-validation-for="PrepMinutes" class="text-error text-label-sm"></span>
                </div>

                <!-- Cook Time -->
                <div class="space-y-space-xs">
                    <label asp-for="CookMinutes" class="block text-title-md text-on-surface font-title">Cook Time (mins)</label>
                    <div class="relative">
                        <input asp-for="CookMinutes" type="number" min="0" max="1440" class="w-full bg-[#0A211E] text-on-surface placeholder:text-on-surface-variant text-body-md rounded-xl pl-4 pr-10 py-3 border border-outline-variant focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" required />
                        <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">timer</span>
                    </div>
                    <span asp-validation-for="CookMinutes" class="text-error text-label-sm"></span>
                </div>
            </div>

            <!-- Access Tier Selection -->
            <div class="space-y-space-xs">
                <label asp-for="Access" class="block text-title-md text-on-surface font-title">Access Tier</label>
                <div class="grid grid-cols-2 gap-4">
                    <label class="flex items-center gap-3 p-4 rounded-xl bg-[#0A211E] border border-outline-variant cursor-pointer hover:border-primary transition-all">
                        <input type="radio" asp-for="Access" value="Free" class="accent-primary" checked />
                        <div>
                            <span class="font-title-md text-on-surface block">Free Public</span>
                            <span class="text-label-sm text-on-surface-variant">Visible to all registered guests</span>
                        </div>
                    </label>
                    <label class="flex items-center gap-3 p-4 rounded-xl bg-[#0A211E] border border-outline-variant cursor-pointer hover:border-primary transition-all">
                        <input type="radio" asp-for="Access" value="Premium" class="accent-primary" />
                        <div>
                            <span class="font-title-md text-primary block">Premium Archive</span>
                            <span class="text-label-sm text-on-surface-variant">Exclusive to subscribed members</span>
                        </div>
                    </label>
                </div>
            </div>

            <!-- Ingredients -->
            <div class="space-y-space-xs">
                <div class="flex justify-between items-center">
                    <label asp-for="Ingredients" class="block text-title-md text-on-surface font-title">Ingredients List <span class="text-primary">*</span></label>
                    <span class="text-label-sm text-on-surface-variant">one ingredient per line</span>
                </div>
                <textarea asp-for="Ingredients" rows="5" class="w-full bg-[#0A211E] text-on-surface placeholder:text-on-surface-variant text-body-md rounded-xl p-4 border border-outline-variant focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" placeholder="2 cups Carnaroli rice&#10;400g fresh wild porcini mushrooms&#10;1L warm vegetable stock&#10;1/2 cup aged Parmigiano-Reggiano" required></textarea>
                <span asp-validation-for="Ingredients" class="text-error text-label-sm"></span>
            </div>

            <!-- Procedure -->
            <div class="space-y-space-xs">
                <div class="flex justify-between items-center">
                    <label asp-for="Procedure" class="block text-title-md text-on-surface font-title">Cooking Procedure <span class="text-primary">*</span></label>
                    <span class="text-label-sm text-on-surface-variant">one step per line</span>
                </div>
                <textarea asp-for="Procedure" rows="6" class="w-full bg-[#0A211E] text-on-surface placeholder:text-on-surface-variant text-body-md rounded-xl p-4 border border-outline-variant focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" placeholder="Step 1: Gently warm the vegetable stock in a separate saucepan over low heat.&#10;Step 2: Sauté finely diced shallots in extra virgin olive oil until translucent.&#10;Step 3: Toast the Carnaroli rice for 2 minutes, then slowly deglaze with dry white wine." required></textarea>
                <span asp-validation-for="Procedure" class="text-error text-label-sm"></span>
            </div>

            <!-- Photo Upload Area -->
            <div class="space-y-space-xs">
                <label asp-for="ImageFile" class="block text-title-md text-on-surface font-title">Hero Recipe Photography</label>
                <div class="border-2 border-dashed border-outline-variant hover:border-primary rounded-xl p-6 text-center cursor-pointer transition-all bg-[#0A211E]/40" onclick="document.getElementById('image-input').click()">
                    <input type="file" id="image-input" asp-for="ImageFile" accept="image/*" class="hidden" onchange="previewImage(this)" />
                    <span class="material-symbols-outlined text-[40px] text-primary mb-2">add_photo_alternate</span>
                    <p class="text-body-md text-on-surface font-title">Click to upload high-resolution dish photo</p>
                    <p class="text-label-sm text-on-surface-variant mt-1">JPEG, PNG, or WEBP up to 5MB</p>
                    <div id="image-preview" class="mt-4 hidden">
                        <img id="preview-img" class="max-h-48 mx-auto rounded-lg object-cover shadow-md" />
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-4 pt-4 border-t border-[rgba(246,239,227,0.1)]">
                <a asp-action="MyRecipes" class="px-6 py-3 rounded-full border border-outline-variant text-on-surface hover:bg-[rgba(246,239,227,0.08)] transition-all font-title-md">
                    Cancel
                </a>
                <button type="submit" class="px-8 py-3 rounded-full bg-primary hover:bg-[#E8A173] text-on-primary font-title-md shadow-[0_4px_16px_rgba(217,138,86,0.25)] transition-all flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px]">publish</span>
                    Publish Recipe
                </button>
            </div>
        </form>
    </div>

    <!-- Right Column: Editorial Standards -->
    <div class="lg:col-span-4 space-y-6">
        <div class="bg-surface-container/75 backdrop-blur-[16px] rounded-xl p-space-lg shadow-xl border border-[rgba(246,239,227,0.12)]">
            <div class="flex items-center gap-3 mb-4">
                <span class="material-symbols-outlined text-primary text-[24px]">verified</span>
                <h3 class="text-headline-sm font-headline text-on-surface">Editorial Standards</h3>
            </div>
            <ul class="space-y-4 text-body-sm text-on-surface-variant">
                <li class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-[#5DBB8A] text-[18px] shrink-0 mt-0.5">check_circle</span>
                    <span><strong>Accurate Measurements:</strong> Specify metric or imperial volumes clearly.</span>
                </li>
                <li class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-[#5DBB8A] text-[18px] shrink-0 mt-0.5">check_circle</span>
                    <span><strong>Sequential Steps:</strong> Detail prep and fire steps step-by-step.</span>
                </li>
                <li class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-[#5DBB8A] text-[18px] shrink-0 mt-0.5">check_circle</span>
                    <span><strong>Authentic Photography:</strong> Natural lighting overhead or 45-degree angle preferred.</span>
                </li>
            </ul>
        </div>
    </div>
</div>

<script>
    function previewImage(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('preview-img').src = e.target.result;
                document.getElementById('image-preview').classList.remove('hidden');
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
